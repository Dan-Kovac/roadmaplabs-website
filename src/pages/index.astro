---
import Base from '../layouts/Base.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Mockup from '../components/Mockup.astro';
import Img from '../components/Img.astro';
import Faq from '../components/Faq.astro';
import { CASES, FAQ_PAGE_ITEMS, PROCESS_STEPS, SERVICE_GROUPS, faqSchema } from '../data/site';
import processDiagramWhiteboard from '../assets/images/process-diagram-whiteboard.jpg';
import danKovac from '../assets/images/dan-kovac.jpg';

const proof = [CASES.reviewbuddy, CASES.flexfolio, CASES.compass] as const;
const homeFaq = [
  'How much does an engagement cost?',
  'How do you handle security and business data?',
  'Do we need to replace our existing systems?',
  'Who owns the accounts and pays the AI fees?',
  'Will you train our staff?',
  'Are we locked into ongoing support?',
].map((q) => FAQ_PAGE_ITEMS.find((item) => item.q === q)!);
---
<Base
  title="AI Consultant for Australian Businesses | Roadmap Labs"
  description="AI consulting for established Australian businesses. We build useful tools around the systems you already use and help your team use them well."
  path="/"
  schema={[faqSchema(homeFaq)]}
>
  <section style="background: var(--paper)">
    <div class="ev-hero-grid" style="max-width: 1200px; margin: 0 auto; padding: 104px 24px 112px; box-sizing: border-box; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: 72px; align-items: center">
      <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 28px">
        <span class="rl-tag">Melbourne-based · Working across Australia</span>
        <h1 style="margin: 0; font-size: clamp(44px, 5.6vw, 72px); line-height: 1.0; letter-spacing: -0.035em; font-weight: 600; color: var(--ink); text-wrap: balance">Help your established business grow with AI</h1>
        <p style="margin: 0; font-size: 20px; line-height: 30px; letter-spacing: -0.01em; color: var(--text-secondary); max-width: 30em">We build useful tools around your existing business, and help your team use them well.</p>
        <a class="rl-btn rl-btn--lg" href="/contact">Book a free 1-hour discovery session</a>
        <p class="page-micro">You'll leave with a clear AI blueprint and strategy you can use yourself. There's no obligation to hire us.</p>
      </div>
      <div class="mk-stage" style="background: linear-gradient(160deg, #4cc2ff 0%, #1f9be6 100%); border-radius: var(--radius-surface); min-height: 360px">
        <Mockup case="reviewbuddy" sizes="(max-width: 1000px) calc(100vw - 48px), 540px" eager priority />
      </div>
    </div>
  </section>

  <section style="background: var(--fog)">
    <div class="ev-pad" style="max-width: 1200px; margin: 0 auto; padding: 120px 24px; box-sizing: border-box; display: flex; flex-direction: column; gap: 48px">
      <div style="display: flex; flex-direction: column; gap: 12px; max-width: 40em">
        <span class="ev-eyebrow">Proof from the work</span>
        <h2 style="margin: 0; font-size: clamp(32px, 4vw, 48px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 600">Built through real work</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 24px">
        {proof.map((item) => (
          <a href={item.href} class="ev-case">
            <div class="mk-stage" style={`background: ${item.gradient}`}><span class="rl-tag rl-tag--long ev-case__tag">{item.tag}</span><Mockup case={item.key} sizes="(max-width: 720px) calc(100vw - 48px), (max-width: 1100px) 50vw, 384px" /></div>
            <div class="ev-case__body">
              <h3>{item.name}</h3>
              <p>{item.summary}</p>
              <span class="rl-link-action" style="margin-top: 8px">Read the case study</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section style="background: var(--paper)">
    <div class="ev-pad" style="max-width: 1200px; margin: 0 auto; padding: 120px 24px; box-sizing: border-box">
      <div class="rl-split">
        <div>
          <h2>Build on what already works</h2>
          <p>Your business has years of knowledge in its people and processes. We work out where AI can help.</p>
          <p>We look at where work gets held up and what a useful improvement would mean. Any estimate needs clear assumptions and something we can measure.</p>
          <ul class="ev-checklist">
            <li><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.8 2.8L16 10"/></svg><span><strong style="font-weight: 600">Keep what works.</strong> <span style="color: var(--text-secondary)">We improve the tools and processes you already run on. We'll only suggest something new once we've got real value out of what's there.</span></span></li>
            <li><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.8 2.8L16 10"/></svg><span><strong style="font-weight: 600">Clear assumptions before you build.</strong> <span style="color: var(--text-secondary)">We explain the assumptions behind a proposed project and agree what to measure. An estimate isn't a guaranteed saving.</span></span></li>
            <li><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.8 2.8L16 10"/></svg><span><strong style="font-weight: 600">The whole team on board.</strong> <span style="color: var(--text-secondary)">We roll AI out across your team securely, with the right skills set up and training, so everyone uses it the same way.</span></span></li>
          </ul>
        </div>
        <figure class="rl-photo rl-photo--soft rl-split__panel" style="padding: 0; min-height: 0; aspect-ratio: 4 / 3">
          <Img src={processDiagramWhiteboard} alt="Someone sketching a process diagram on a glass whiteboard" sizes="(max-width: 720px) calc(100vw - 48px), 540px" />
        </figure>
      </div>
    </div>
  </section>

  <section style="background: var(--paper)">
    <div class="ev-pad" style="max-width: 1200px; margin: 0 auto; padding: 0 24px 120px; box-sizing: border-box; display: flex; flex-direction: column; gap: 80px">
      <h2 style="margin: 0; font-size: clamp(32px, 4vw, 48px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 600">See how the work comes together</h2>
      {proof.map((item, i) => (
        <div class:list={['rl-split', { 'rl-split--flip': i % 2 === 1 }]}>
          <div class="rl-split__panel mk-stage" style={`background: ${item.gradient}; padding: 0`}><Mockup case={item.key} sizes="(max-width: 720px) calc(100vw - 48px), 560px" /></div>
          <div>
            <span class="rl-tag rl-tag--long" style="margin-bottom: 16px">{item.tag}</span>
            <h2>{item.name}</h2>
            <p>{item.summary}</p>
            <a class="rl-link-action" href={item.href}>Read the case study</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section style="background: var(--paper)">
    <div class="ev-pad" style="max-width: 1200px; margin: 0 auto; padding: 0 24px 120px; box-sizing: border-box; display: flex; flex-direction: column; gap: 48px">
      <div style="display: flex; flex-direction: column; gap: 12px; max-width: 40em">
        <h2 style="margin: 0; font-size: clamp(32px, 4vw, 48px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 600">Get the foundations right. Then build</h2>
        <p class="prose-p">Established businesses rarely start with a blank page. We look at what works today and where the tools make work harder.</p>
      </div>
      <div class="service-catalogue">
        {SERVICE_GROUPS.map((group) => (
          <div>
            <h3 class="group-title">{group.label}</h3>
            <div class="ev-why">
              {group.items.map((item) => (
                <a class="ev-why__card" href={`/services#${item.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`} style="text-decoration: none; color: inherit">
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="background: var(--paper)">
    <div class="ev-pad" style="max-width: 1200px; margin: 0 auto; padding: 0 24px 120px; box-sizing: border-box">
      <div class="rl-split">
        <figure class="rl-photo" style="aspect-ratio: 4 / 5; max-width: 460px; width: 100%; justify-self: center; background: var(--gradient-signal)"><Img src={danKovac} alt="Dan Kovac, founder of Roadmap Labs" style="filter: none; mix-blend-mode: normal; object-position: 50% 0%" sizes="(max-width: 720px) calc(100vw - 48px), 460px" /></figure>
        <div>
          <span class="ev-eyebrow" style="margin-bottom: 16px">Who you'll work with</span>
          <h2>I'm Dan. I like building useful things</h2>
          <p>I bring ten years in digital marketing to Roadmap Labs. I build useful tools around the way a business actually works.</p>
          <p>I see enterprise AI at scale at one of Australia's largest wagering providers.</p>
          <a class="rl-link-action" href="/about">More about Dan</a>
        </div>
      </div>
    </div>
  </section>

  <section style="background: var(--fog)">
    <div class="ev-pad" style="max-width: 1200px; margin: 0 auto; padding: 120px 24px; box-sizing: border-box">
      <div class="rl-split">
        <div>
          <h2>Your team stays in control</h2>
          <p>We agree the data boundaries before connecting tools. Your business owns its accounts and pays its own AI and token fees, separate from the project fee.</p>
          <p>Handover includes teaching your team to use the system and check its work. The project scope sets out the documentation and maintenance responsibilities.</p>
          <a class="rl-link-action" href="/faq">Read the project FAQs</a>
        </div>
        <ul class="ev-checklist">
          <li><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.8 2.8L16 10"/></svg><span>Your business owns its accounts and pays its own AI and token fees, separate from the project fee.</span></li>
          <li><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.8 2.8L16 10"/></svg><span>The project scope sets out the documentation and maintenance responsibilities.</span></li>
          <li><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.8 2.8L16 10"/></svg><span>Ongoing support is optional and scoped separately.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section style="background: var(--paper)">
    <div class="ev-pad" style="max-width: 1200px; margin: 0 auto; padding: 120px 24px; box-sizing: border-box; display: flex; flex-direction: column; align-items: flex-start; gap: 20px">
      <h2 style="margin: 0; font-size: clamp(32px, 4vw, 48px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 600">Useful things you can put to work</h2>
      <div class="empty-panel" style="width: 100%; box-sizing: border-box">
        <h3>The first articles are being prepared</h3>
        <p class="prose-p">There are no published articles here yet. Check back for practical guides you can use in your own business.</p>
      </div>
      <a class="rl-link-action" href="/articles">Latest articles</a>
    </div>
  </section>

  <section style="background: var(--fog)">
    <div class="ev-pad" style="max-width: 1200px; margin: 0 auto; padding: 120px 24px; box-sizing: border-box; display: flex; flex-direction: column; gap: 32px">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px">
        <h2 style="margin: 0; font-size: clamp(32px, 4vw, 48px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 600">From a clear plan to a working system</h2>
        <a class="rl-link-action" href="/process">See how a project works</a>
      </div>
      <div class="ev-why">
        {PROCESS_STEPS.map((step, i) => (
          <article class="ev-why__card">
            <span class="ev-node" aria-hidden="true">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.paragraphs[0]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section style="background: var(--paper)">
    <div class="ev-pad" style="max-width: 1200px; margin: 0 auto; padding: 120px 24px; box-sizing: border-box; display: flex; flex-wrap: wrap; gap: 48px">
      <div style="flex: 1 1 280px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px">
        <span class="ev-eyebrow">FAQ</span>
        <h2 style="margin: 0; font-size: 36px; line-height: 1.21; letter-spacing: -0.02em; font-weight: 600">Common questions</h2>
        <a class="rl-link-action" href="/faq">Read the project FAQs</a>
      </div>
      <Faq items={homeFaq} />
    </div>
  </section>

  <ClosingCTA
    title="An hour to work out where AI fits"
    body="Spend an hour with Dan on the work holding your team up. You'll leave with a clear AI blueprint and strategy you can use yourself."
    cta="Book a free 1-hour discovery session"
    microcopy="The blueprint is yours. There's no obligation to build with us."
  />
</Base>

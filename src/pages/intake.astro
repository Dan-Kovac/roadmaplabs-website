          <>
            <span class="ik-voice__status" id="ik-voice-status">Ready when you are</span>
            <p class="ik-voice__caption" id="ik-voice-caption"></p>
            <div class="ik-widget" id="ik-widget"></div>
          </>
        ) : (
          <>
            <span class="ik-voice__status">Voice interview coming online</span>
            <p class="ik-voice__hint">Riley's voice is nearly ready. For now you can still talk your answers: the mic in the chat turns speech into text.</p>
            <div class="ik-voice__actions">
              <button class="ik-cta" type="button" id="ik-voice-fallback"><Fragment set:html={svg(icons.mic, 18)} />Talk my answers in chat</button>
            </div>
          </>
        )}
      </div>
    </div>
  </div>

  <!-- Conversation -->
  <div class="ik-log" id="ik-log" role="log" aria-live="polite" aria-relevant="additions">
    <div class="ik-col ik-log__inner" id="ik-thread">
      <noscript><p class="ik-say">The interview needs JavaScript. Please turn it on, or email dan@roadmaplabs.com.au and we'll send the questions another way.</p></noscript>
    </div>
  </div>

  <!-- Dock -->
  <div class="ik-dock">

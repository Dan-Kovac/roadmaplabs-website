  <!-- Dock -->
  <div class="ik-dock">
    <div class="ik-col" style="position: relative">
      <div class="ik-menu" id="ik-tray" role="dialog" aria-label="Share something" hidden>
        <label class="ik-menu__item" for="ik-files">
          <span><Fragment set:html={svg(icons.file)} /></span>
          <span><strong>Upload files</strong><small>Price lists, brand guides, documents · about 4MB in total</small></span>
        </label>
        <input class="ik-sr" id="ik-files" type="file" multiple tabindex="-1">
        <button class="ik-menu__item" type="button" id="ik-menu-link">
          <span><Fragment set:html={svg(icons.link)} /></span>
          <span><strong>Add a link</strong><small>Google Drive, Dropbox, Loom. Best for anything big</small></span>
        </button>
        <form class="ik-menu__link" id="ik-linkform" hidden>
          <label class="ik-sr" for="ik-link">Link</label>

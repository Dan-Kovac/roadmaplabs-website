<section class="ik" id="ik" data-mode="chat" data-view="welcome" data-agent={agentId || undefined} aria-label="Intake interview with Harry">
  <div class="ik-bg" aria-hidden="true"></div>
  <svg width="0" height="0" style="position: absolute" aria-hidden="true"><defs><linearGradient id="ik-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0a4cff"/><stop offset="1" stop-color="#00a3ff"/></linearGradient></defs></svg>

  <!-- Top bar -->
  <div class="ik-top">
    <div class="ik-col">
      <div class="ik-top__row">
        <div class="ik-id">
          <img class="ik-id__logo" id="ik-id-logo" alt="" hidden referrerpolicy="no-referrer">
          <div class="ik-id__text">
            <span class="ik-id__name">Harry</span>
            <span class="ik-id__meta" id="ik-progress" aria-live="polite">Roadmap Labs intake</span>
          </div>
        </div>
        <button class="ik-folderbtn" type="button" id="ik-folder-btn" aria-controls="ik-panel" aria-expanded="false" aria-label="Your notes: what we've captured so far"><Fragment set:html={svg(icons.folder, 18)} /><span class="ik-folderbtn__n" id="ik-folder-n">0</span></button>
        <div class="ik-modes" role="group" aria-label="How you'd like to answer">
          <button type="button" data-mode="chat" aria-pressed="true"><Fragment set:html={svg(icons.chat, 16)} /><span>Chat</span></button>
          <button type="button" data-mode="voice" aria-pressed="false"><Fragment set:html={svg(icons.wave, 16)} /><span>Voice<span class="ik-modes__long"> interview</span></span></button>
        </div>
      </div>
      <div class="ik-progress" aria-hidden="true"><i id="ik-bar"></i></div>
    </div>
  </div>

  <div class="ik-toast" id="ik-toast" role="status" hidden></div>

  <!-- Your folder: what's been captured so far (provisional depth rules: src/data/intake-depth.ts) -->
  <aside class="ik-panel" id="ik-panel" aria-labelledby="ik-panel-title">
    <div class="ik-panel__head">
      <div>
        <span class="ik-panel__eyebrow">Your notes</span>
        <strong id="ik-panel-title">What we've captured so far</strong>
      </div>
      <button class="ik-panel__close" type="button" id="ik-panel-close" aria-label="Close your notes">×</button>
    </div>
    <p class="ik-panel__note">What we've picked up so far. After the interview, we write it up properly as clear instructions for AI.</p>
    <div class="ik-panel__role" id="ik-role-line" hidden>
      <span>Answering as <b id="ik-role-name"></b></span>
      <span class="ik-panel__role-actions"><button type="button" id="ik-role-change">Change</button><button type="button" id="ik-role-add">Add a role</button></span>
      <small>Your role only changes which questions you're asked.</small>
    </div>
    <div class="ik-known" id="ik-known" hidden>
      <span class="ik-panel__eyebrow">Already know</span>
      <ul id="ik-known-list"></ul>
      <p id="ik-known-skip"></p>
    </div>
    <div class="ik-tree" id="ik-tree" aria-live="polite"></div>
    <p class="ik-panel__fine">The bars are a rough guide to how much we have on each topic so far.</p>
    <button class="ik-panel__link" type="button" id="ik-tour-replay">Replay the walkthrough</button>
  </aside>

  <!-- Preview mock of a sign-in screen (?mock=login). Visual only: nothing is checked, sent or stored. -->
  <div class="ik-mock" id="ik-mock" hidden>
    <div class="ik-col">
      <span class="ik-mock__flag">Preview mock</span>
      <div class="ik-mock__step" id="ik-mock-form-step">
        <span class="ik-orb ik-orb--hero" aria-hidden="true"><span class="ik-orb__halo"></span><span class="ik-orb__core"></span></span>
        <h1>Welcome</h1>
        <form class="ik-mock__form" id="ik-mock-form" autocomplete="off">
          <label>Your name<input id="ik-mock-name" type="text" autocomplete="off" spellcheck="false"></label>
          <label>Password<input id="ik-mock-pass" type="password" autocomplete="off" data-lpignore="true" data-1p-ignore></label>
          <button class="ik-cta" type="submit">Continue</button>
        </form>
        <p class="ik-mock__fine">Preview mock only, not a real sign-in. Nothing you type here is checked, sent or saved.</p>
      </div>
      <div class="ik-mock__step" id="ik-mock-hello" hidden>
        <span class="ik-orb ik-orb--hero" aria-hidden="true"><span class="ik-orb__ring"></span><span class="ik-orb__ring"></span><span class="ik-orb__halo"></span><span class="ik-orb__core"></span></span>
        <h1 id="ik-mock-hello-text">Welcome</h1>
      </div>
    </div>
  </div>

  <!-- Welcome -->
  <div class="ik-welcome" id="ik-welcome">
    <div class="ik-col">
      <span class="ik-orb ik-orb--hero" aria-hidden="true"><span class="ik-orb__ring"></span><span class="ik-orb__ring"></span><span class="ik-orb__ring"></span><span class="ik-orb__halo"></span><span class="ik-orb__core"></span></span>
      <p class="ik-brandline" id="ik-brandline" hidden><img id="ik-brand-logo" alt="" hidden referrerpolicy="no-referrer"><span>Prepared for <b id="ik-brand-name"></b></span></p>
      <h1 id="ik-hello">Let's map how your business <span>really runs.</span></h1>
      <p class="ik-welcome__lead">I'm Harry. First the basics, how you use AI today and the tools you run on. Then, if you have time, we'll walk through how work comes in, gets done and gets looked after. Type, talk, or switch to a voice interview whenever you like.</p>
      <ul class="ik-points">
        <li><Fragment set:html={svg(icons.clock, 18)} />Core takes about 10 minutes</li>
        <li><Fragment set:html={svg(icons.skip, 18)} />Skip anything you're unsure of</li>
        <li><Fragment set:html={svg(icons.save, 18)} />Saved as you go</li>
      </ul>
      <div class="ik-welcome__actions">
        <button class="ik-cta" type="button" id="ik-start-chat"><Fragment set:html={svg(icons.chat, 18)} />Start in chat</button>
        <button class="ik-cta ik-cta--quiet" type="button" id="ik-start-voice"><Fragment set:html={svg(icons.wave, 18)} />Start a voice interview</button>
      </div>
      <p class="ik-welcome__fine">Your answers go straight to Roadmap Labs and are only used for your project. Your information is stored securely. If you decide not to go ahead, we delete it promptly. Once your own setup is running, we delete it from our side too. <a href="/privacy">Privacy policy</a></p>
    </div>
  </div>


  <!-- Opening walkthrough: fresh sessions only, after the welcome, before question one. Illustrations, not their files. -->
  <div class="ik-tour" id="ik-tour" role="region" aria-roledescription="walkthrough" aria-label="How this works">
    <div class="ik-col ik-tour__top">
      <span class="ik-tour__hello">Welcome to this questionnaire</span>
      <button class="ik-tour__skip" type="button" id="ik-tour-skip">Skip</button>
    </div>
    <div class="ik-col ik-tour__stage" id="ik-tour-stage">
      {Object.entries(INTRO).map(([audience, set]) => (
      <div class="ik-tour__set" data-audience={audience} hidden={audience !== DEFAULT_AUDIENCE}>
      {set!.map((b, i) => (
      <section class:list={['ik-beat', { 'ik-beat--split': !!b.demo }]} data-beat={i} data-shot={b.id} aria-label={`${i + 1} of ${set!.length}: ${b.eyebrow}`}>
        <div class="ik-beat__text">
          <span class="ik-beat__eyebrow">{b.eyebrow}</span>
          <h2>{b.title}</h2>
          {b.body.map((p) => <p class="ik-beat__body">{p}</p>)}
          {b.steps && (
            <ol class="ik-steps">
              {b.steps.map((s) => (
                <li><p><b>{s.title}</b> {s.text}</p>{s.why && <p class="ik-steps__why">{s.why}</p>}</li>
              ))}
            </ol>
          )}
          {b.footer && !b.demo && <p class="ik-beat__footer">{b.footer}</p>}
        </div>
        {b.demo && (
          <figure class="ik-beat__figure">
            {b.demo === 'answer' && (
              <div class="ik-demo ik-demo--answer" aria-hidden="true">
                <span class="ik-tag">Example</span>
                <div class="ik-demo__bubble">We quote jobs from a phone call and a spreadsheet.</div>
                <div class="ik-demo__file">
                  <div class="ik-demo__filename">workflows/quoting.md</div>
                  <div class="ik-demo__line ik-demo__line--h">## How it's done</div>

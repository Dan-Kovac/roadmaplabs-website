      <div class="ik-recbar" id="ik-recbar" role="status" hidden>
        <span class="ik-recdot" aria-hidden="true"></span>
        <span id="ik-rec-label" style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">Recording 0:00</span>
        <span class="ik-recbar__meter" aria-hidden="true"><i id="ik-rec-meter"></i></span>

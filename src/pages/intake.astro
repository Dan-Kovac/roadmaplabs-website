  .is-on .ik-demo__line { animation: ik-type .45s var(--ease) both; }
  .is-on .ik-demo__line:nth-child(2) { animation-delay: 1.2s; } .is-on .ik-demo__line:nth-child(3) { animation-delay: 1.45s; } .is-on .ik-demo__line:nth-child(4) { animation-delay: 1.7s; } .is-on .ik-demo__line:nth-child(5) { animation-delay: 1.95s; }
  @keyframes ik-drift { 0% { opacity: 0; transform: translateY(-6px); } 25% { opacity: 1; transform: none; } 70% { opacity: 1; transform: translateY(0); } 100% { opacity: .55; transform: translateY(4px) scale(.98); } }

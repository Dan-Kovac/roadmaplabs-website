  /* ---------- Preview mock: sign-in (?mock=login), visual only ---------- */
  .ik-mock { position: absolute; inset: 0; z-index: 12; display: flex; overflow-y: auto; background: linear-gradient(180deg, #f7f8fc 0%, var(--paper) 50%); }

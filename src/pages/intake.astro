  <!-- Voice hero -->
  <div class="ik-voice" id="ik-voice" aria-hidden="true" inert>
    <div>
      <div class="ik-col ik-voice__inner">
        <span class:list={['ik-orb', 'ik-orb--hero', { 'ik-orb--off': !agentId }]} id="ik-hero-orb" aria-hidden="true"><span class="ik-orb__ring"></span><span class="ik-orb__ring"></span><span class="ik-orb__ring"></span><span class="ik-orb__halo"></span><span class="ik-orb__core"></span></span>
        {agentId ? (

    </div>
  </div>
</section>

<script>
  import { QUESTIONS, CORE, FULL, SESSIONS, CLOSING, SKIPPED, MAX_UPLOAD_BYTES, RECORDING } from '../data/intake';

  type Step =
    | { type: 'q'; qid: number; text: string; phase: 'core' | 'full' | 'closing'; section?: number }
    | { type: 'choice' }
    | { type: 'files' };
  /** a = answer (s: spoken in a voice interview), c = path choice. */
  type Action = { t: 'a'; v: string; s?: 1 } | { t: 'c'; v: 'more' | 'wrap' };
  type Mode = 'chat' | 'voice';
  interface Saved { v: 2; actions: Action[]; links: string[]; mode: Mode }

  const STORE = 'rl-intake-v1';
  const CHOICE_TEXT = "That's the core done - about 10 minutes. Want to keep going? The full set adds the deeper brand and workflow questions (about 15 more minutes), or you can wrap up now.";
  const TOO_BIG = "That's too big to send through the page (about 4MB in total). Put it in Google Drive or Dropbox and paste the link instead.";
  const SECONDS = { core: 40, full: 31, closing: 45 } as const; // rough time per question, for "about N min left"

  const byN = new Map(QUESTIONS.map((q) => [q.n, q]));
  const textByQid = new Map<number, string>([...QUESTIONS.map((q) => [q.qid, q.text] as [number, string]), [CLOSING.anythingElse.qid, CLOSING.anythingElse.text]]);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(pointer: fine)').matches;

  const root = $<HTMLElement>('ik');
  const log = $<HTMLDivElement>('ik-log');
  const thread = $<HTMLDivElement>('ik-thread');
  const composer = $<HTMLFormElement>('ik-composer');
  const input = $<HTMLTextAreaElement>('ik-input');
  const skipBtn = $<HTMLButtonElement>('ik-skip');
  const sendBtn = $<HTMLButtonElement>('ik-send');
  const micBtn = $<HTMLButtonElement>('ik-mic');
  const attachBtn = $<HTMLButtonElement>('ik-attach');
  const tray = $<HTMLDivElement>('ik-tray');
  const fileInput = $<HTMLInputElement>('ik-files');
  const linkForm = $<HTMLFormElement>('ik-linkform');
  const linkInput = $<HTMLInputElement>('ik-link');
  const chips = $<HTMLDivElement>('ik-chips');
  const progress = $<HTMLSpanElement>('ik-progress');
  const bar = $<HTMLElement>('ik-bar');
  const sendNow = $<HTMLButtonElement>('ik-send-now');
  const recBtn = $<HTMLButtonElement>('ik-rec');
  const recQuick = $<HTMLButtonElement>('ik-rec-quick');
  const recBar = $<HTMLDivElement>('ik-recbar');
  const recLabel = $<HTMLSpanElement>('ik-rec-label');
  const recMeter = $<HTMLElement>('ik-rec-meter');
  const recStop = $<HTMLButtonElement>('ik-rec-stop');
  const toast = $<HTMLDivElement>('ik-toast');
  const agentId = root.dataset.agent || '';

  // Fit the stage to the viewport under the site header.
  const header = document.querySelector<HTMLElement>('header.hd');
  const fit = () => root.style.setProperty('--ik-top', `${header?.offsetHeight ?? 76}px`);
  fit();
  addEventListener('resize', fit);

  // Per-employee / per-client links: ?employee=&client=
  const params = new URLSearchParams(location.search);
  const employee = params.get('employee') ?? '';
  const client = params.get('client') ?? '';

  // ---------- State (shared by chat and voice) ----------
  const steps: Step[] = CORE.map((n) => qStep(n, 'core'));
  steps.push({ type: 'choice' });
  let pos = 0;
  let actions: Action[] = [];
  let links: string[] = [];
  let files: File[] = [];
  let mode: Mode = 'chat';
  const answers = new Map<number, string>();
  let replaying = false;
  let sent = false;
  let sending = false;

  function qStep(n: number, phase: 'core' | 'full'): Step {
    const q = byN.get(n)!;
    return { type: 'q', qid: q.qid, text: q.text, phase };
  }

  function save() {
    if (sent) return;
    try { localStorage.setItem(STORE, JSON.stringify({ v: 2, actions, links, mode } satisfies Saved)); } catch {}
  }
  function load(): Saved {
    const empty: Saved = { v: 2, actions: [], links: [], mode: 'chat' };
    try {
      const raw = JSON.parse(localStorage.getItem(STORE) || 'null');
      if (Array.isArray(raw)) return { ...empty, actions: raw }; // first version stored just the actions
      if (raw && raw.v === 2) return { ...empty, ...raw };
    } catch {}
    return empty;
  }
  function clear() {
    try { localStorage.removeItem(STORE); } catch {}
  }

  // ---------- Orb level: Riley's voice, your mic, or text streaming ----------
  let lvl = 0;
  let lvlTarget = 0;
  let lvlRaf = 0;
  function bump(v: number) {
    if (reduced) return;
    lvlTarget = Math.max(lvlTarget, Math.min(1, v));
    if (!lvlRaf) lvlRaf = requestAnimationFrame(lvlLoop);
  }
  function lvlLoop() {
    lvl += (lvlTarget - lvl) * 0.28;
    lvlTarget *= 0.9;
    root.style.setProperty('--lvl', lvl.toFixed(3));
    if (lvl > 0.003 || lvlTarget > 0.003) lvlRaf = requestAnimationFrame(lvlLoop);
    else { lvlRaf = 0; root.style.setProperty('--lvl', '0'); }
  }

  // ---------- Rendering ----------
  function scroll() {
    if (!replaying) log.scrollTop = log.scrollHeight;
  }
  function add<T extends HTMLElement>(el: T): T {
    if (replaying) el.style.animation = 'none';
    thread.appendChild(el);
    scroll();
    return el;
  }
  const el = (tag: string, cls: string, text?: string) => {
    const e = document.createElement(tag);
    e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  };
  const ORB = '<span class="ik-orb ik-orb--sm" aria-hidden="true"><span class="ik-orb__halo"></span><span class="ik-orb__core"></span></span>';

  /** One of Riley's turns: a mini orb and a line of text (a question is shown large while it's current). */
  function rileyTurn(isQuestion: boolean) {
    const turn = el('div', `ik-turn${isQuestion ? ' ik-turn--q' : ''}`);
    turn.innerHTML = ORB;
    const body = el('div', 'ik-turn__body');
    turn.append(body);
    add(turn);
    return body;
  }
  function settleQuestions() {
    thread.querySelectorAll('.ik-q.is-current').forEach((q) => q.classList.remove('is-current'));
  }
  function answer(text: string, kind: 'you' | 'spoken' | 'skip') {
    if (kind === 'skip') {
      const p = el('p', 'ik-a ik-a--skip');
      p.innerHTML = '<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h12M13 6l6 6-6 6"/></svg>';
      p.append("Skipped. We'll cover it on the call");
      return add(p);
    }
    return add(el('p', `ik-a${kind === 'spoken' ? ' ik-a--spoken' : ''}`, text));
  }
  function fileMsg(text: string) {
    const p = el('p', 'ik-a ik-a--file');
    p.innerHTML = '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5l-8.6 8.6a5.5 5.5 0 0 1-7.8-7.8l8.6-8.6a3.7 3.7 0 0 1 5.2 5.2l-8.6 8.6a1.8 1.8 0 0 1-2.6-2.6l7.9-7.9"/></svg>';
    p.append(el('span', '', text));
    return add(p);
  }
  function section(n: number) {
    const d = el('div', 'ik-section ik-divider');
    d.append(el('span', '', `Part ${n} of 4`), el('strong', '', SESSIONS[n as 1 | 2 | 3 | 4]));
    return add(d);
  }
  function note(text: string, linkText?: string, onClick?: () => void, error = false) {
    const p = el('p', `ik-note${error ? ' ik-note--error' : ''}`);
    p.append(text);
    if (linkText && onClick) {
      const b = el('button', '', linkText) as HTMLButtonElement;
      b.type = 'button';
      b.addEventListener('click', onClick);
      p.append(' ', b);
    }
    return add(p);
  }

  const wait = (ms: number) => (replaying || reduced ? Promise.resolve() : new Promise((r) => setTimeout(r, ms)));

  /** Riley "types": a short think, then the words stream in. Screen readers get the full line at once. */
  async function rileySays(text: string, opts: { question?: boolean; error?: boolean } = {}) {
    if (opts.error) return note(text, undefined, undefined, true);
    if (opts.question) settleQuestions();
    const body = rileyTurn(!!opts.question);
    const p = el('p', opts.question ? 'ik-q is-current' : 'ik-say');
    body.append(p);
    if (replaying || reduced) {
      p.textContent = text;
      return p;
    }
    const think = el('span', 'ik-think');
    think.innerHTML = '<i></i><i></i><i></i>';
    think.setAttribute('aria-hidden', 'true');
    p.append(think);
    scroll();
    await wait(380);
    p.textContent = '';
    const sr = el('span', 'ik-sr', text);
    const vis = el('span', '');
    vis.setAttribute('aria-hidden', 'true');
    p.append(sr, vis);
    const words = text.split(/(\s+)/);
    const per = Math.max(18, Math.min(55, 1100 / Math.max(1, words.length / 2)));
    let out = '';
    for (const w of words) {
      out += w;
      vis.textContent = out;
      if (w.trim()) { bump(0.28 + Math.random() * 0.25); scroll(); await wait(per); }
    }
    p.textContent = text;
    scroll();
    return p;
  }

  function lock(locked: boolean) {
    if (locked) composer.setAttribute('data-locked', '');
    else composer.removeAttribute('data-locked');
    input.disabled = locked;
    skipBtn.disabled = locked;
    sendBtn.disabled = locked;
    micBtn.disabled = locked;
    input.placeholder = locked ? (steps[pos]?.type === 'q' || !steps[pos] ? 'Riley is typing…' : 'Pick an option above') : 'Type your answer…';
    if (steps[pos]?.type === 'files') input.placeholder = 'All questions answered';
    if (!locked && !replaying && mode === 'chat' && (actions.length || finePointer)) input.focus({ preventScroll: true });
  }

  function minutesLeft(): string {
    const rest = steps.slice(pos).filter((s): s is Extract<Step, { type: 'q' }> => s.type === 'q');
    const secs = rest.reduce((sum, s) => sum + SECONDS[s.phase], 0);
    if (secs < 60) return 'under a minute left';
    return `about ${Math.round(secs / 60)} min left`;
  }

  function updateProgress() {
    const s = steps[pos];
    const coreDone = steps.slice(0, pos).filter((x) => x.type === 'q' && x.phase === 'core').length;
    const fullTotal = steps.filter((x) => x.type === 'q' && x.phase === 'full').length;
    const fullDone = steps.slice(0, pos).filter((x) => x.type === 'q' && x.phase === 'full').length;
    let label = '';
    let pct = 0;
    if (root.dataset.view === 'welcome') { label = 'Roadmap Labs intake'; pct = 0; }
    else if (sent) { label = 'All sent'; pct = 100; }
    else if (!s || s.type === 'files') { label = 'All questions done · ready to send'; pct = 100; }
    else if (s.type === 'choice') { label = 'Core done'; pct = 34; }
    else if (s.phase === 'core') { label = `Question ${coreDone + 1} of ${CORE.length} · ${minutesLeft()}`; pct = (coreDone / CORE.length) * 34; }
    else if (s.phase === 'full') { label = `Deeper set · ${fullDone + 1} of ${fullTotal} · ${minutesLeft()}`; pct = 34 + (fullDone / fullTotal) * 60; }
    else { label = 'Last question'; pct = 96; }
    const [main, ...rest] = label.split(' · ');
    progress.textContent = '';
    progress.append(el('b', '', main));
    if (rest.length) progress.append(el('i', '', ' · '), el('span', '', rest.join(' · ')));
    bar.style.width = `${Math.max(2, Math.round(pct))}%`;
    sendNow.hidden = sent || answers.size === 0 || s?.type === 'files';
    const caption = document.getElementById('ik-voice-caption');
    if (caption) caption.textContent = s?.type === 'q' ? s.text : s?.type === 'choice' ? "That's the core done. Keep going, or wrap up?" : 'All questions done.';
  }

  // ---------- Flow ----------
  function milestone(live: boolean) {
    const card = el('div', 'ik-card ik-mile');
    card.innerHTML = `<span class="ik-mile__ring" aria-hidden="true"><svg viewBox="0 0 64 64" width="64" height="64"><circle class="bg" cx="32" cy="32" r="28"/><circle class="fg" cx="32" cy="32" r="28"/></svg><b>${CORE.length}/${CORE.length}</b></span>`;
    card.append(el('h3', '', "That's the core done"));
    card.append(el('p', '', 'Want to keep going? The full set adds the deeper brand and workflow questions (about 15 more minutes), or you can wrap up now.'));
    card.setAttribute('aria-label', CHOICE_TEXT);
    if (replaying || !live) card.querySelector<SVGCircleElement>('.fg')!.style.cssText = 'animation: none; stroke-dashoffset: 0';
    add(card);
    return card;
  }
  function option(label: string, sub: string, primary: boolean, onClick: () => void, data: string) {
    const b = el('button', `ik-opt${primary ? ' ik-opt--primary' : ''}`) as HTMLButtonElement;
    b.type = 'button';
    b.dataset.choice = data;
    b.append(el('strong', '', label), el('small', '', sub));
    b.addEventListener('click', onClick);
    return b;
  }

  async function present(i = pos) {
    updateProgress();
    const s = steps[i];
    if (!s || sent) return;
    if (s.type === 'q') {
      if (s.section) section(s.section);
      await rileySays(s.text, { question: true });
      if (i === pos) lock(false);
    } else if (s.type === 'choice') {
      lock(true);
      settleQuestions();
      const card = milestone(true);
      if (i !== pos) return;
      const wrap = el('div', 'ik-choices');
      wrap.append(
        option('Keep going', 'Deeper brand and workflow questions · about 15 min', true, () => { wrap.remove(); act({ t: 'c', v: 'more' }); }, 'more'),
        option('Wrap up now', 'One last question, then share anything useful', false, () => { wrap.remove(); act({ t: 'c', v: 'wrap' }); }, 'wrap'),
      );
      card.append(wrap);
      scroll();
      if (!replaying && mode === 'chat') (wrap.firstChild as HTMLButtonElement).focus({ preventScroll: true });
    } else if (s.type === 'files') {
      lock(true);
      settleQuestions();
      await rileySays('Last thing: anything you can share? Files, links and quick screen recordings all help us understand the business faster.');
      shareCard();
    }
  }

  function shareCard() {
    const card = el('div', 'ik-card ik-share');
    card.append(el('h3', '', 'Share anything useful'), el('p', '', 'A price list, a brand guide, a proposal you send, or a quick recording of how something works. All optional.'));
    const tiles = el('div', 'ik-tiles');
    const tile = (icon: string, title: string, sub: string, onClick: () => void) => {
      const b = el('button', 'ik-tile') as HTMLButtonElement;
      b.type = 'button';
      b.innerHTML = `<span class="ik-tile__icon">${icon}</span>`;
      b.append(el('strong', '', title), el('small', '', sub));
      b.addEventListener('click', onClick);
      tiles.append(b);
    };
    tile(document.querySelector('#ik-tray label svg')!.outerHTML, 'Upload files', 'About 4MB in total', () => fileInput.click());
    tile(document.querySelector('#ik-menu-link svg')!.outerHTML, 'Add a link', 'Drive, Dropbox or Loom', () => { openTray(true); showLinkField(); });
    if (canRecord) tile(document.querySelector('#ik-rec svg')!.outerHTML, 'Record your screen', 'Talk us through it · up to 5 min', () => startRecording());
    card.append(tiles);
    const row = el('div', 'ik-share__send ik-choices');
    const send = el('button', 'ik-cta', 'Send everything') as HTMLButtonElement;
    send.type = 'button';
    send.id = 'ik-send-all';
    send.addEventListener('click', () => sendAll());
    row.append(send, el('small', '', 'You can send now; sharing is optional.'));
    card.append(row);
    add(card);
  }

  function addClosing() {
    steps.push({ type: 'q', qid: CLOSING.anythingElse.qid, text: CLOSING.anythingElse.text, phase: 'closing' });
    steps.push({ type: 'files' });
  }

  /** Apply one action to the current step: updates state now and returns the rendering to run in order,
   *  or null if the action doesn't fit (stale saved state, or a tool call for a step that has moved on). */
  function apply(a: Action): (() => void) | null {
    const s = steps[pos];
    if (!s) return null;
    let render: () => void;
    if (a.t === 'a' && s.type === 'q') {
      answers.set(s.qid, a.v);
      render = () => { answer(a.v, a.v === SKIPPED ? 'skip' : a.s ? 'spoken' : 'you'); };
    } else if (a.t === 'c' && s.type === 'choice') {
      render = () => { answer(a.v === 'more' ? 'Keep going' : 'Wrap up now', 'you'); };
      if (a.v === 'more') {
        let session = 0;
        for (const n of FULL) {
          const q = byN.get(n)!;
          const sec = q.session !== session ? q.session : undefined;
          session = q.session;
          steps.push({ type: 'q', qid: q.qid, text: q.text, phase: 'full', section: sec });
        }
      }
      addClosing();
    } else {
      return null;
    }
    pos++;
    return render;
  }

  // Thread rendering runs through one queue so messages always appear in script order,
  // even when voice tool calls arrive faster than Riley's typing animation.
  let queue: Promise<unknown> = Promise.resolve();
  const enqueue = (fn: () => unknown) => (queue = queue.then(fn).catch(() => {}));

  /** State changes synchronously, so callers (e.g. voice tools) see the new position immediately. */
  function act(a: Action): boolean {
    if (sent) return false;
    const render = apply(a);
    if (!render) return false;
    actions.push(a);
    save();
    lock(true);
    updateProgress();
    const next = pos;
    enqueue(async () => {
      render();
      if (a.t === 'c' && a.v === 'wrap') await rileySays('No problem. One last question before you go.');
      if (a.t === 'c' && a.v === 'more') await rileySays("Great. Same as before: answer what you can and skip what you can't.");
      await present(next);
    });
    return true;
  }

  // ---------- Optional: questions to Riley in chat ----------
  const looksLikeQuestion = (t: string) =>
    t.length < 240 && /\?\s*$/.test(t) && /^(what|why|how|who|whom|where|when|which|can|could|do|does|did|is|are|should|would|will|sorry|wait|hang on|um)\b/i.test(t);

  async function askRiley(text: string, current: string): Promise<string | null> {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 9000);
    try {
      const r = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, question: current }),
        signal: ctrl.signal,
      });
      if (r.status !== 200) return null;
      const d = await r.json();
      return typeof d.reply === 'string' && d.reply.trim() ? d.reply.trim() : null;
    } catch {
      return null;
    } finally {
      clearTimeout(timer);
    }
  }

  composer.addEventListener('submit', async (e) => {
    e.preventDefault();
    stopListening();
    const s = steps[pos];
    const text = input.value.trim();
    if (!text || !s || s.type !== 'q') return;
    input.value = '';
    autosize();
    if (looksLikeQuestion(text)) {
      lock(true);
      const reply = await askRiley(text, s.text);
      if (reply) {
        answer(text, 'you');
        await rileySays(reply);
        await rileySays(s.text, { question: true });
        const at = pos;
        const keep = note('Was that actually your answer?', 'Save it as my answer', () => {
          keep.remove();
          if (pos === at) act({ t: 'a', v: text });
        });
        lock(false);
        return;
      }
    }
    act({ t: 'a', v: text });
  });

  skipBtn.addEventListener('click', () => {
    stopListening();
    if (steps[pos]?.type === 'q') act({ t: 'a', v: SKIPPED });
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      composer.requestSubmit();
    }
  });
  function autosize() {
    input.style.height = 'auto';
    input.style.height = `${Math.min(input.scrollHeight, 180)}px`;
  }
  input.addEventListener('input', autosize);

  // ---------- Speech to text in chat (browser speech recognition) ----------
  const SR = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
  let rec: any = null;
  if (SR) micBtn.hidden = false;
  let meter: { stream: MediaStream; ctx: AudioContext; raf: number } | null = null;
  async function startMeter() {
    // Desktop only: a second mic capture can upset speech recognition on phones.
    if (!finePointer || reduced || meter) return;
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const ctx = new AudioContext();
      const an = ctx.createAnalyser();
      an.fftSize = 512;
      ctx.createMediaStreamSource(stream).connect(an);
      const buf = new Uint8Array(an.fftSize);
      meter = { stream, ctx, raf: 0 };
      const tick = () => {
        if (!meter) return;
        an.getByteTimeDomainData(buf);
        let sum = 0;
        for (const v of buf) { const d = (v - 128) / 128; sum += d * d; }
        bump(Math.sqrt(sum / buf.length) * 5);
        meter.raf = requestAnimationFrame(tick);
      };
      tick();
    } catch {}
  }
  function stopMeter() {
    if (!meter) return;
    cancelAnimationFrame(meter.raf);
    meter.stream.getTracks().forEach((t) => t.stop());
    meter.ctx.close().catch(() => {});
    meter = null;
  }
  function stopListening() {
    if (rec) { try { rec.stop(); } catch {} }
  }
  function startListening() {
    if (rec || !SR || input.disabled) return;
    const base = input.value.trim() ? input.value.trimEnd() + ' ' : '';
    rec = new SR();
    rec.lang = 'en-AU';
    rec.interimResults = true;
    rec.continuous = true;
    rec.onresult = (e: any) => {
      let text = '';
      for (let i = 0; i < e.results.length; i++) text += e.results[i][0].transcript;
      input.value = base + text.trimStart();
      autosize();
    };
    rec.onerror = (e: any) => {
      if (e.error === 'not-allowed' || e.error === 'service-not-allowed') note("The browser didn't allow the microphone. You can type instead, or allow it in the address bar and try again.");
    };
    rec.onend = () => {
      rec = null;
      stopMeter();
      micBtn.setAttribute('aria-pressed', 'false');
      micBtn.setAttribute('aria-label', 'Speak your answer');
      micBtn.dataset.tip = 'Speak your answer';
      input.placeholder = 'Type your answer…';
      input.focus({ preventScroll: true });
    };
    try {
      rec.start();
      micBtn.setAttribute('aria-pressed', 'true');
      micBtn.setAttribute('aria-label', 'Stop listening');
      micBtn.dataset.tip = 'Stop listening';
      input.placeholder = 'Listening… tap the mic when you’re done';
      startMeter();
    } catch {
      rec = null;
    }
  }
  micBtn.addEventListener('click', () => (rec ? stopListening() : startListening()));

  // ---------- Sharing: files, links, screen recordings ----------
  function openTray(open: boolean) {
    tray.hidden = !open;
    attachBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (!open) linkForm.hidden = true;
  }
  function showLinkField() {
    linkForm.hidden = false;
    linkInput.focus({ preventScroll: true });
  }
  attachBtn.addEventListener('click', () => openTray(tray.hidden));
  $<HTMLButtonElement>('ik-menu-link').addEventListener('click', showLinkField);
  document.addEventListener('pointerdown', (e) => {
    if (!tray.hidden && !tray.contains(e.target as Node) && !attachBtn.contains(e.target as Node)) openTray(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !tray.hidden) { openTray(false); attachBtn.focus(); }
  });

  const fmtSize = (b: number) => (b < 1024 * 1024 ? `${Math.max(1, Math.round(b / 1024))} KB` : `${(b / 1024 / 1024).toFixed(1)} MB`);
  const totalBytes = () => files.reduce((sum, f) => sum + f.size, 0);
  const CHIP_ICON = { file: document.querySelector('#ik-tray label svg')!.outerHTML, link: document.querySelector('#ik-menu-link svg')!.outerHTML, rec: document.querySelector('#ik-rec svg')!.outerHTML };

  function renderChips() {
    chips.textContent = '';
    const chip = (icon: string, label: string, onRemove: () => void) => {
      const c = el('span', 'ik-chip');
      c.innerHTML = icon.replace(/width="\d+" height="\d+"/, 'width="14" height="14"');
      const x = el('button', '', '×') as HTMLButtonElement;
      x.type = 'button';
      x.setAttribute('aria-label', `Remove ${label}`);
      x.addEventListener('click', onRemove);
      c.append(el('span', '', label), x);
      chips.append(c);
    };
    files.forEach((f, i) => chip(CHIP_ICON.file, `${f.name} · ${fmtSize(f.size)}`, () => { files.splice(i, 1); renderChips(); }));
    links.forEach((l, i) => chip(l.startsWith('Screen recording') ? CHIP_ICON.rec : CHIP_ICON.link, linkLabel(l), () => { links.splice(i, 1); save(); renderChips(); }));
  }

  fileInput.addEventListener('change', () => {
    for (const f of Array.from(fileInput.files || [])) {
      if (totalBytes() + f.size > MAX_UPLOAD_BYTES) {
        note(`${f.name}: ${TOO_BIG}`, undefined, undefined, true);
        continue;
      }
      files.push(f);
      fileMsg(`${f.name} · ${fmtSize(f.size)}`);
    }
    fileInput.value = '';
    openTray(false);
    renderChips();
  });

  /** "loom.com/share/x" -> "https://loom.com/share/x", so the Jotform link field gets a real URL. */
  function normaliseLink(v: string) {
    const t = v.trim();
    if (/^[a-z][a-z0-9+.-]*:\/\//i.test(t)) return t;
    if (/^[\w-]+(\.[\w-]+)+([/?#:]\S*)?$/.test(t)) return `https://${t}`;
    return t;
  }
  const linkLabel = (l: string) => (l.startsWith('Screen recording') ? l.split(': ')[0] : l.replace(/^https?:\/\//, ''));
  function addLink(raw: string, label?: string) {
    const v = normaliseLink(raw);
    if (!v || links.includes(v)) return false;
    links.push(v);
    fileMsg(label ?? v);
    save();
    renderChips();
    return true;
  }
  linkForm.addEventListener('submit', (e) => {
    e.preventDefault();
    if (addLink(linkInput.value)) { linkInput.value = ''; openTray(false); }
  });

  // ---------- Screen recording (getDisplayMedia -> MediaRecorder -> private Supabase bucket) ----------
  const canRecord = !!navigator.mediaDevices?.getDisplayMedia && typeof MediaRecorder !== 'undefined';
  if (canRecord) { recBtn.hidden = false; recQuick.hidden = false; }
  let recBusy = false;
  let stopRecording: ((why?: 'time' | 'size') => void) | null = null;
  const fmtDur = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  const MAX_LABEL = fmtDur(RECORDING.maxSeconds);

  function showRecBar(label: string, pct: number, uploading = false) {
    recBar.hidden = false;
    recBar.toggleAttribute('data-uploading', uploading);
    recLabel.textContent = label;
    recMeter.style.width = `${Math.min(100, Math.round(pct * 100))}%`;
  }

  async function startRecording() {
    if (recBusy) return;
    openTray(false);
    let display: MediaStream;
    try {
      display = await navigator.mediaDevices.getDisplayMedia({ video: { frameRate: { ideal: 15, max: 24 } }, audio: true });
    } catch {
      note("Screen sharing didn't start. You can try again, or paste a Loom link instead.");
      return;
    }
    recBusy = true;
    // Narration from the mic if allowed; system/tab audio if the browser shared it. Mix both when there are two.
    let mic: MediaStream | null = null;
    try { mic = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true } }); } catch {}
    const tracks: MediaStreamTrack[] = [...display.getVideoTracks()];
    const audioIn = [display, mic].filter((s): s is MediaStream => !!s && s.getAudioTracks().length > 0);
    let ctx: AudioContext | null = null;
    if (audioIn.length === 1) tracks.push(audioIn[0].getAudioTracks()[0]);
    else if (audioIn.length > 1) {
      ctx = new AudioContext();
      const dest = ctx.createMediaStreamDestination();
      for (const s of audioIn) ctx.createMediaStreamSource(s).connect(dest);
      tracks.push(dest.stream.getAudioTracks()[0]);
    }
    const mime = ['video/webm;codecs=vp9,opus', 'video/webm;codecs=vp8,opus', 'video/webm', 'video/mp4'].find((t) => MediaRecorder.isTypeSupported(t)) || '';
    let mr: MediaRecorder;
    try {
      mr = new MediaRecorder(new MediaStream(tracks), { ...(mime ? { mimeType: mime } : {}), videoBitsPerSecond: RECORDING.videoBitsPerSecond, audioBitsPerSecond: 64_000 });
    } catch {
      [display, mic].forEach((s) => s?.getTracks().forEach((t) => t.stop()));
      recBusy = false;
      note("This browser can't record the screen. Please paste a Loom link instead.");
      return;
    }
    const chunks: Blob[] = [];
    let bytes = 0;
    let stoppedBy: 'time' | 'size' | undefined;
    const started = Date.now();
    const elapsed = () => (Date.now() - started) / 1000;
    stopRecording = (why) => {
      stoppedBy ??= why;
      if (mr.state !== 'inactive') mr.stop();
    };
    mr.ondataavailable = (e) => {
      if (!e.data.size) return;
      chunks.push(e.data);
      bytes += e.data.size;
      if (bytes >= RECORDING.stopAtBytes) stopRecording?.('size');
    };
    const tick = window.setInterval(() => {
      const s = elapsed();
      showRecBar(`Recording ${fmtDur(s)} / ${MAX_LABEL}`, Math.max(s / RECORDING.maxSeconds, bytes / RECORDING.stopAtBytes));
      if (s >= RECORDING.maxSeconds) stopRecording?.('time');
    }, 500);
    display.getVideoTracks()[0]?.addEventListener('ended', () => stopRecording?.());
    mr.onstop = async () => {
      clearInterval(tick);
      stopRecording = null;
      [display, mic].forEach((s) => s?.getTracks().forEach((t) => t.stop()));
      ctx?.close().catch(() => {});
      const seconds = elapsed();
      const blob = new Blob(chunks, { type: (mr.mimeType || mime || 'video/webm').split(';')[0] });
      if (stoppedBy === 'time') note(`That's ${MAX_LABEL}, so the recording stopped there. Shorter is better; for anything longer, paste a Loom link.`);
      if (stoppedBy === 'size') note('The recording reached the size limit, so it stopped there. For anything longer, paste a Loom link.');
      try {
        await uploadRecording(blob, seconds);
      } catch (err) {
        note(err instanceof Error && err.message ? err.message : "The recording couldn't be saved. Please try again, or paste a Loom link instead.", undefined, undefined, true);
      } finally {
        recBar.hidden = true;
        recBusy = false;
      }
    };
    mr.start(1000);
    showRecBar(`Recording 0:00 / ${MAX_LABEL}`, 0);
    recStop.focus({ preventScroll: true });
  }

  async function postRecording(body: object) {
    const r = await fetch('/api/intake-recording', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const d = await r.json().catch(() => null);
    if (!r.ok || !d?.ok) throw new Error(d?.error || "The recording couldn't be saved. Please try again, or paste a Loom link instead.");
    return d;
  }

  function putFile(url: string, blob: Blob, onProgress: (p: number) => void) {
    return new Promise<void>((resolve, reject) => {
      const x = new XMLHttpRequest();
      x.open('PUT', url);
      x.setRequestHeader('content-type', blob.type);
      x.upload.onprogress = (e) => { if (e.lengthComputable) onProgress(e.loaded / e.total); };
      x.onload = () => (x.status >= 200 && x.status < 300 ? resolve() : reject(new Error("The recording didn't upload. Please try again, or paste a Loom link instead.")));
      x.onerror = () => reject(new Error("The recording didn't upload. Check your connection and try again, or paste a Loom link instead."));
      x.send(blob);
    });
  }

  async function uploadRecording(blob: Blob, seconds: number) {
    if (!blob.size) throw new Error('That recording came out empty. Please try again, or paste a Loom link instead.');
    if (blob.size > RECORDING.maxBytes) throw new Error(`That recording is ${fmtSize(blob.size)}, over the 50MB limit. Please record a shorter one, or paste a Loom link instead.`);
    showRecBar('Uploading recording… 0%', 0, true);
    const started = await postRecording({ action: 'start', contentType: blob.type, size: blob.size, client });
    await putFile(started.uploadUrl, blob, (p) => showRecBar(`Uploading recording… ${Math.round(p * 100)}%`, p, true));
    const done = await postRecording({ action: 'finish', path: started.path });
    const label = `Screen recording, ${fmtDur(seconds)}`;
    links.push(`${label}: ${done.url} (stored at ${done.path})`);
    fileMsg(`${label} · ${fmtSize(blob.size)}`);
    save();
    renderChips();
  }

  recBtn.addEventListener('click', () => startRecording());
  recQuick.addEventListener('click', () => startRecording());
  recStop.addEventListener('click', () => stopRecording?.());

  // ---------- Submit ----------
  async function sendAll() {
    if (sending || sent) return;
    stopListening();
    if (recBusy) {
      note('Hang on, your screen recording is still going. Stop it (or wait for the upload to finish), then send again.');
      return;
    }
    // A link typed into the box but never added still counts.
    if (linkInput.value.trim() && addLink(linkInput.value)) linkInput.value = '';
    if (totalBytes() > MAX_UPLOAD_BYTES) { note(TOO_BIG, undefined, undefined, true); return; }
    if (!answers.size && !files.length && !links.length) {
      note("There's nothing to send yet. Answer a question or two first, or share a file or link.");
      return;
    }
    const data = new FormData();
    // Only questions that were offered: answered as typed, or "to fill" if skipped.
    for (const [qid, v] of answers) data.set(String(qid), v);
    if (links.length) data.set(String(CLOSING.link), links.join(' | '));
    for (const f of files) data.append(String(CLOSING.files), f, f.name);
    data.set(String(CLOSING.employee), employee);
    data.set(String(CLOSING.client), client);

    sending = true;
    lock(true);
    const sendAllBtn = document.getElementById('ik-send-all') as HTMLButtonElement | null;
    const label = sendAllBtn?.innerHTML;
    if (sendAllBtn) { sendAllBtn.disabled = true; sendAllBtn.innerHTML = '<span class="ik-spin" aria-hidden="true"></span>Sending…'; }
    const sendingNote = sendAllBtn ? null : note('Sending your answers…');
    try {
      const r = await fetch('/api/intake-submit', { method: 'POST', body: data });
      const d = await r.json().catch(() => null);
      if (r.status === 413) throw new Error(TOO_BIG);
      if (!r.ok || !d?.ok) throw new Error(d?.error || "That didn't send. Please try again.");
      sent = true;
      clear();
      openTray(false);
      updateProgress();
      finish();
    } catch (err) {
      sendingNote?.remove();
      if (sendAllBtn) { sendAllBtn.disabled = false; sendAllBtn.innerHTML = label ?? 'Send everything'; }
      const msg = err instanceof Error && err.message ? err.message : "That didn't send. Please try again.";
      note(`${msg} Nothing is lost: your answers are still saved here.`, 'Try again', () => sendAll(), true);
      if (steps[pos]?.type === 'q') lock(false);
    } finally {
      sending = false;
    }
  }
  sendNow.addEventListener('click', () => {
    if (confirm("Send your answers so far? Anything you haven't reached yet will be left out.")) sendAll();
  });

  // ---------- Finish ----------
  const answeredCount = () => [...answers.values()].filter((v) => v !== SKIPPED).length;
  function finish() {
    stopListening();
    const skipped = [...answers.values()].filter((v) => v === SKIPPED).length;
    const recs = links.filter((l) => l.startsWith('Screen recording')).length;
    const plainLinks = links.length - recs;
    const tick = '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
    const list = $<HTMLUListElement>('ik-captured');
    list.textContent = '';
    const item = (main: string, sub?: string) => {
      const li = el('li', '');
      li.innerHTML = tick;
      li.append(main);
      if (sub) li.append(' ', el('small', '', sub));
      list.append(li);
    };
    const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
    item(`${plural(answeredCount(), 'answer')} received`, skipped ? `· ${skipped} skipped, we'll cover ${skipped === 1 ? 'it' : 'them'} on the call` : undefined);
    const shared = [files.length && plural(files.length, 'file'), plainLinks && plural(plainLinks, 'link'), recs && plural(recs, 'screen recording')].filter(Boolean);
    if (shared.length) item(`${shared.join(', ')} shared`);
    item('Saved to Roadmap Labs', `· ${new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`);
    if (client) $<HTMLElement>('ik-finish-title').textContent = `That's everything, ${client}. Thank you.`;
    root.dataset.view = 'finish';
    $<HTMLElement>('ik-finish').focus({ preventScroll: true });
  }
  $<HTMLButtonElement>('ik-download').addEventListener('click', () => {
    const lines = [`Roadmap Labs intake${client ? ` · ${client}` : ''}`, new Date().toLocaleString(), ''];
    for (const [qid, v] of answers) lines.push(textByQid.get(qid) ?? `Question ${qid}`, v === SKIPPED ? '(skipped)' : v, '');
    if (links.length) lines.push('Links shared', ...links, '');
    if (files.length) lines.push('Files shared', ...files.map((f) => f.name), '');
    const url = URL.createObjectURL(new Blob([lines.join('\n')], { type: 'text/plain' }));
    const a = Object.assign(document.createElement('a'), { href: url, download: 'roadmap-labs-intake-answers.txt' });
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });

  // ---------- Modes ----------
  let widgetLoaded = false;
  function setMode(m: Mode, persist = true) {
    mode = m;
    root.dataset.mode = m;
    $<HTMLElement>('ik-voice').setAttribute('aria-hidden', String(m !== 'voice'));
    root.querySelectorAll<HTMLButtonElement>('.ik-modes button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));
    if (m === 'voice') {
      stopListening();
      loadWidget();
    }
    if (persist) save();
    setTimeout(scroll, 560);
  }
  root.querySelectorAll<HTMLButtonElement>('.ik-modes button').forEach((b) =>
    b.addEventListener('click', () => {
      setMode(b.dataset.mode as Mode);
      if (root.dataset.view === 'welcome') begin();
    }),
  );
  document.getElementById('ik-voice-fallback')?.addEventListener('click', () => {
    setMode('chat');
    setTimeout(startListening, 400);
  });

  // ---------- Voice interview (ElevenLabs ConvAI widget) ----------
  // The agent runs the same script through client tools, so voice and chat share one thread and one state.
  // Agent setup (prompt + tool definitions) is in docs/intake-voice-agent.md.
  function loadWidget() {
    if (widgetLoaded || !agentId) return;
    widgetLoaded = true;
    const host = $<HTMLDivElement>('ik-widget');
    const w = document.createElement('elevenlabs-convai');
    w.setAttribute('agent-id', agentId);
    w.setAttribute('placement', 'bottom');
    w.setAttribute('transcript', 'false');
    w.setAttribute('text-input', 'false');
    w.setAttribute('show-avatar-when-collapsed', 'false');
    w.setAttribute('avatar-orb-color-1', '#0a4cff');
    w.setAttribute('avatar-orb-color-2', '#00a3ff');
    w.setAttribute('text-contents', JSON.stringify({ main_label: 'Talk it through with Riley', start_call: 'Start voice interview', end_call: 'End interview' }));
    host.append(w);
    const s = document.createElement('script');
    s.src = 'https://unpkg.com/@elevenlabs/convai-widget-embed';
    s.async = true;
    s.onerror = () => {
      const st = document.getElementById('ik-voice-status');
      if (st) st.textContent = "Voice couldn't load. Chat works the same";
    };
    document.head.append(s);
  }

  function stepPrompt(): string {
    const s = steps[pos];
    if (sent) return 'The interview has been submitted. Thank them and end the call.';
    if (!s) return 'The interview is finished.';
    if (s.type === 'q') return `Ask this question exactly as written, then wait for the answer: "${s.text}"`;
    if (s.type === 'choice') return `The core questions are done. Say exactly: "${CHOICE_TEXT}" Then call choose_path with path "keep_going" or "wrap_up".`;
    return 'All the questions are done. Tell them they can add files, links or a screen recording on the screen, then press Send everything. Thank them and end the call.';
  }

  /** Rough loudness of a base64 audio chunk from the agent (16-bit PCM); any chunk still counts as speech. */
  function chunkLevel(b64: unknown) {
    if (typeof b64 !== 'string') return 0.5;
    try {
      const bin = atob(b64.length > 6000 ? b64.slice(0, 6000) : b64);
      const n = bin.length >> 1;
      let sum = 0;
      for (let i = 0; i < n; i++) { let v = bin.charCodeAt(2 * i) | (bin.charCodeAt(2 * i + 1) << 8); if (v > 32767) v -= 65536; sum += v * v; }
      return Math.max(0.25, Math.min(1, Math.sqrt(sum / Math.max(1, n)) / 6000));
    } catch { return 0.5; }
  }

  document.addEventListener('elevenlabs-convai:call', (event: any) => {
    const config = event?.detail?.config;
    if (!config) return;
    config.clientTools = {
      ...(config.clientTools || {}),
      get_current_question: () => stepPrompt(),
      record_answer: (p: { answer?: string }) => {
        if (steps[pos]?.type !== 'q') return `No question is waiting. ${stepPrompt()}`;
        const v = String(p?.answer ?? '').trim();
        act({ t: 'a', v: v || SKIPPED, s: 1 });
        return `Saved. Next: ${stepPrompt()}`;
      },
      skip_question: () => {
        if (steps[pos]?.type !== 'q') return `No question is waiting. ${stepPrompt()}`;
        act({ t: 'a', v: SKIPPED, s: 1 });
        return `Skipped. Next: ${stepPrompt()}`;
      },
      choose_path: (p: { path?: string }) => {
        if (steps[pos]?.type !== 'choice') return `There's no choice to make right now. ${stepPrompt()}`;
        const more = /keep|more|full|continue/i.test(String(p?.path ?? ''));
        root.querySelectorAll('.ik-choices').forEach((c) => c.remove());
        act({ t: 'c', v: more ? 'more' : 'wrap' });
        return `Done. Next: ${stepPrompt()}`;
      },
    };
    const status = document.getElementById('ik-voice-status');
    if (status) status.textContent = 'Connecting…';
    const onConnect = config.onConnect;
    config.onConnect = (...args: unknown[]) => {
      if (status) { status.textContent = 'Live with Riley'; status.setAttribute('data-live', ''); }
      onConnect?.(...args);
    };
    const onAudio = config.onAudio;
    config.onAudio = (...args: unknown[]) => {
      bump(chunkLevel(args[0]));
      onAudio?.(...args);
    };
  });

  // ---------- Start ----------
  function showToast(text: string, action?: string, onClick?: () => void) {
    toast.textContent = text;
    if (action && onClick) {
      const b = el('button', '', action) as HTMLButtonElement;
      b.type = 'button';
      b.addEventListener('click', onClick);
      toast.append(b);
    }
    toast.hidden = false;
    setTimeout(() => { toast.hidden = true; }, 9000);
  }

  let begun = false;
  async function begin() {
    if (begun) return;
    begun = true;
    root.dataset.view = 'chat';
    updateProgress();
    await rileySays(`Hi${client ? ` ${client}` : ''}, I'm Riley. Answer in your own words; there are no wrong answers. We'll start with the core: ${CORE.length} questions, about 10 minutes.`);
    enqueue(() => present());
  }
  $<HTMLButtonElement>('ik-start-chat').addEventListener('click', () => { setMode('chat'); begin(); });
  $<HTMLButtonElement>('ik-start-voice').addEventListener('click', () => { setMode('voice'); begin(); });

  function start() {
    lock(true);
    if (client) $<HTMLElement>('ik-hello').innerHTML = `Hi ${client.replace(/[<>&"]/g, '')}. Let's map how your business <span>really runs.</span>`;
    const saved = load();
    links = Array.isArray(saved.links) ? saved.links.filter((l) => typeof l === 'string') : [];
    renderChips();
    setMode(saved.mode === 'voice' ? 'voice' : 'chat', false);
    if (!saved.actions.length) {
      updateProgress();
      return; // welcome screen until they pick chat or voice
    }
    begun = true;
    root.dataset.view = 'chat';
    replaying = true;
    for (const a of saved.actions) {
      const s = steps[pos];
      if (s?.type === 'q') { if (s.section) section(s.section); rileySays(s.text, { question: true }); }
      else if (s?.type === 'choice') milestone(false);
      const render = apply(a);
      if (!render) break;
      render();
      actions.push(a);
    }
    replaying = false;
    log.scrollTop = log.scrollHeight;
    showToast('Welcome back. Picked up where you left off', 'Start over', () => {
      if (!confirm('Clear your answers and start again?')) return;
      clear();
      location.reload();
    });
    enqueue(() => present());
  }

  start();
</script>

</Base>

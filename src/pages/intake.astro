                </div>
              </div>
            )}
            {b.caption && <figcaption>{b.caption}</figcaption>}
            {b.demo === 'tools' && <p class="ik-beat__norec" data-norec hidden>Screen recording needs a desktop browser such as Chrome, Edge or Firefox. On a phone, attach screenshots or paste a Loom link instead.</p>}
          </figure>
        )}
        {b.blocks && (
          <div class="ik-blocks">
            {b.blocks.map((k) => (
              <div class:list={['ik-block', `ik-block--${k.tone ?? 'note'}`]}>
                <span class="ik-block__label">{k.tone === 'get' && <Fragment set:html={svg(icons.check, 14, 2.6)} />}{k.label}</span>
                <p>{k.text}</p>
              </div>
            ))}
          </div>
        )}
        {b.footer && b.demo && <p class="ik-beat__footer">{b.footer}</p>}
      </section>
      ))}
      </div>
      ))}
    </div>
    <div class="ik-col ik-tour__nav">
      <div class="ik-dots" id="ik-tour-dots" aria-label="Walkthrough progress"></div>
      <div class="ik-tour__btns">
        <button class="ik-cta ik-cta--quiet" type="button" id="ik-tour-skip2" hidden>Skip</button>

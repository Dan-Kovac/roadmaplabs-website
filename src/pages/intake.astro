      <form class="ik-composer" id="ik-composer" data-locked>
        <button class="ik-ico" type="button" id="ik-attach" aria-label="Share a file, link or screen recording" aria-expanded="false" aria-controls="ik-tray" data-tip="Share a file or link"><Fragment set:html={svg(icons.clip)} /></button>
        <label class="ik-sr" for="ik-input">Your answer</label>
        <textarea id="ik-input" rows="1" placeholder="Type your answer…" autocomplete="off" enterkeyhint="send" maxlength="20000" aria-label="Your answer"></textarea>
        <button class="ik-ico" type="button" id="ik-rec-quick" aria-label="Record your screen" data-tip="Record your screen" hidden><Fragment set:html={svg(icons.screen)} /></button>
        <button class="ik-ico ik-mic" type="button" id="ik-mic" aria-label="Speak your answer" aria-pressed="false" data-tip="Speak your answer" hidden><Fragment set:html={svg(icons.mic)} /></button>
        <button class="ik-ico ik-send" type="submit" id="ik-send" aria-label="Send answer" data-tip="Send · Enter"><Fragment set:html={svg(icons.up, 20, 2.4)} /></button>
      </form>

      <div class="ik-welcome__actions">
        <button class="ik-cta" type="button" id="ik-start-chat"><Fragment set:html={svg(icons.chat, 18)} />Start in chat</button>
        <button class="ik-cta ik-cta--quiet" type="button" id="ik-start-voice"><Fragment set:html={svg(icons.wave, 18)} />Start a voice interview</button>
      </div>
      <p class="ik-welcome__fine">Your answers go straight to Roadmap Labs and are only used for your project. <a href="/privacy">Privacy policy</a></p>
    </div>
  </div>

  <!-- Voice hero -->
  <div class="ik-voice" id="ik-voice" aria-hidden="true">
    <div>
      <div class="ik-col ik-voice__inner">
        <span class:list={['ik-orb', 'ik-orb--hero', { 'ik-orb--off': !agentId }]} id="ik-hero-orb" aria-hidden="true"><span class="ik-orb__ring"></span><span class="ik-orb__ring"></span><span class="ik-orb__ring"></span><span class="ik-orb__halo"></span><span class="ik-orb__core"></span></span>

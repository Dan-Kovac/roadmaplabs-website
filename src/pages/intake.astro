        <button class="ik-skip" type="button" id="ik-skip">Skip for now <small>· we'll cover it on the call</small></button>
        <span class="ik-meta__right">
          <span class="ik-saved"><Fragment set:html={svg(icons.check, 14, 2.6)} />Saved</span>
          <span class="ik-meta__hint">Shift+Enter for a new line</span>
          <button type="button" id="ik-send-now" hidden>Finish early</button>
        </span>

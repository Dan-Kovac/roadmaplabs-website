                <div class="ik-demo__row ik-demo__row--dir"><b>routines/</b><span>what kicks them off</span></div>
                <div class="ik-demo__row ik-demo__row--dir"><b>skills/</b><span>the instructions, written down</span></div>
              </div>
            )}
            {b.demo === 'tools' && (
              <div class="ik-demo ik-demo--tools" aria-hidden="true">
                <div class="ik-demo__composer">
                  <span class="ik-demo__ico ik-demo__ico--hl"><Fragment set:html={svg(icons.clip, 18)} /></span>
                  <span class="ik-demo__type">Type your answer…</span>
                  <span class="ik-demo__ico ik-demo__ico--hl"><Fragment set:html={svg(icons.screen, 18)} /></span>
                  <span class="ik-demo__ico"><Fragment set:html={svg(icons.mic, 18)} /></span>
                </div>
                <div class="ik-demo__callouts">
                  <span><Fragment set:html={svg(icons.clip, 14)} />Attach files, screenshots and links</span>

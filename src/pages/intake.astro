  .is-on .ik-steps li { animation: ik-calm .6s var(--ease) both; }
  .is-on .ik-steps li:nth-child(2) { animation-delay: .1s; } .is-on .ik-steps li:nth-child(3) { animation-delay: .2s; } .is-on .ik-steps li:nth-child(4) { animation-delay: .3s; }

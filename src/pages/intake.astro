  <!-- Finish -->
  <div class="ik-finish" id="ik-finish" tabindex="-1">
    <div class="ik-col">
      <span class="ik-done" aria-hidden="true"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
      <h2 id="ik-finish-title">That's everything. Thank you.</h2>
      <p class="ik-finish__lead">We'll turn what you shared into clear written notes on your business, your brand, your customers and your tools, plus step-by-step instructions for each job you described. We'll follow up within 2 business days.</p>
      <ul class="ik-captured" id="ik-captured" aria-label="What we received"></ul>
      <ol class="ik-next" aria-label="What happens next">
        <li><strong>We read it all</strong>Roadmap Labs reviews your answers, files and recordings.</li>
        <li><strong>We get in touch</strong>We follow up within 2 business days to book a time.</li>
        <li><strong>A short call to fill the gaps</strong>Around 30 minutes on anything you skipped or we need to clarify.</li>
      </ol>
      <div class="ik-finish__actions">
        <button class="ik-cta ik-cta--quiet" type="button" id="ik-download"><Fragment set:html={svg(icons.save, 18)} />Download a copy of your answers</button>
        <p>Questions in the meantime? <a href="mailto:dan@roadmaplabs.com.au">dan@roadmaplabs.com.au</a></p>
      </div>
      <p class="ik-finish__data">Your information is stored securely. If you decide not to go ahead, just tell us and we delete it promptly. Once your own setup is running, we delete it from our side too. <a href="/privacy">Privacy policy</a></p>
    </div>
  </div>
</section>

<script>
  import { readme, reference, workflow, fromDocuments, businessName, workflowFile, DEPTH_LABEL, type FileState, type Depth } from '../data/intake-depth';
  import { readRole, ROLE_QUESTION, ROLE_QUESTION_LEGACY, ROLE_FOLLOW_UP, ROLE_CHIPS, ROUTE_NAME, type Route } from '../data/intake-roles';
  import { CORE_QUESTIONS, CORE_STAGES, JOURNEY, DRILL as DRILL_BASE, D5_CHIPS, D9_HINT, MAX_PROCESSES, BENCHMARK, CLOSING, SKIPPED, MAX_UPLOAD_BYTES, RECORDING, BLOCKED_FILE } from '../data/intake';
  import { GROWTH_QUESTIONS, GROWTH_OFFER, buildPayload } from '../data/intake-growth';
  import { DRILL_BRIEF, STAGE_LABEL, MARKETING_FOLLOW_UP, SKIPPABLE, NOT_ASKED, tailoredIds, tailoredBlock, type PublicBrief, type BriefStage } from '../data/brief.ts';

  type J = 0 | 1 | 2;
  type Step =
    // Tailored brief only: the opening check, the brief's own questions, and a follow-up after each marketing answer.
    | { type: 'tq'; b: BriefStage | 'opening'; i: number; f?: true }
    | { type: 'q'; qid: number; id: string; text: string; phase: 'core' | 'closing'; stage?: 0 | 1 | 2; hint?: string; first?: boolean }
    | { type: 'choice' }
    | { type: 'list'; j: J }
    | { type: 'name'; j: J; p: number; prompt: string; options: string[] }
    | { type: 'drill'; j: J; p: number; d: number }
    | { type: 'another'; j: J; p: number; next?: string }
    | { type: 'files' }
    // Stage 3b, the optional Growth add-on: the offer, then one step per question (never part of the core).
    | { type: 'gchoice' }
    | { type: 'growth'; g: number }
    // Role steps: which questions to ask. Routing only, never an access permission.
    | { type: 'role'; mode: 'first' | 'change' | 'add' | 'legacy'; echo?: string }
    | { type: 'role2'; mode: 'first' | 'change' | 'add'; first: string; echo?: string };
  type Answerable = Extract<Step, { type: 'q' | 'list' | 'name' | 'drill' | 'role' | 'role2' | 'growth' | 'tq' }>;
  /** a = answer (s: spoken in a voice interview; r/n: the role and respondent it was given under),
   *  c = a choice (milestone, "another one?", "role:change"/"role:add"/"role:legacy"), p = a voice answer given ahead of its turn. */
  type Action = { t: 'a'; v: string; s?: 1; r?: string; n?: string } | { t: 'c'; v: string } | { t: 'p'; k: string; v: string; s?: 1 };
  type Mode = 'chat' | 'voice';
  /** Same key and shape as before. `flow: 2` marks sessions that started with the role step; older ones lack it.
   *  `g: 1` marks sessions that know the optional Growth add-on, so a session saved before it replays exactly as it was. */
  interface Saved { v: 3; actions: Action[]; links: string[]; mode: Mode; flow?: 2; g?: 1 }
  interface Proc { name: string; answers: (string | undefined)[]; skipped?: boolean }

  // A new key for the new spine, so progress saved under the old 44-question script never replays into it.
  // A brief-based interview saves under its own key, so it never mixes with a standard one on the same device.
  let STORE = 'rl-intake-v3';
  /** The per-job questions: the standard nine, plus two more in brief-based interviews (set before anything starts). */
  let DRILL: readonly { id: string; label: string; text: string }[] = DRILL_BASE;
  /** The tailored brief from /intake?brief=<token>, fetched from the server. Null for the standard interview. */
  let brief: PublicBrief | null = null;
  const tailored = new Map<string, string>(); // tailored answers: "opening", "<stage>:<i>", "marketing:<i>:f"
  const tqKey = (s: { b: string; i: number; f?: true }) => (s.b === 'opening' ? 'opening' : `${s.b}:${s.i}${s.f ? ':f' : ''}`);
  const tqId = (s: { b: string; i: number; f?: true }) => { const t = brief ? tailoredIds(brief).find((x) => x.stage === s.b && x.i === s.i) : null; return t ? `${t.id}${s.f ? '-follow-up' : ''}` : ''; };
  const JOURNEY_STAGE: Partial<Record<BriefStage, J>> = { winning: 0, doing: 1, running: 2 };
  const CHOICE_TEXT = "That's the core done, about 10 minutes. Want to keep going? It's about 20 more minutes on how work comes in, gets done and gets looked after. Or you can finish here.";
  const TOO_BIG = "That's too big to send through the page (about 4MB in total). Put it in Google Drive or Dropbox and paste the link instead.";

  const textByQid = new Map<number, string>([
    ...CORE_QUESTIONS.map((q) => [q.qid, q.text] as [number, string]),
    ...JOURNEY.map((j) => [j.qid, j.text] as [number, string]),
    ...JOURNEY.flatMap((J) => J.slots.map((qid, p) => [qid, `${J.label}: job ${p + 1}`] as [number, string])),
    [CLOSING.anythingElse.qid, CLOSING.anythingElse.text],
  ]);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(pointer: fine)').matches;

  const root = $<HTMLElement>('ik');
  const log = $<HTMLDivElement>('ik-log');
  const thread = $<HTMLDivElement>('ik-thread');
  const composer = $<HTMLFormElement>('ik-composer');
  const input = $<HTMLTextAreaElement>('ik-input');
  const skipBtn = $<HTMLButtonElement>('ik-skip');
  const sendBtn = $<HTMLButtonElement>('ik-send');
  const micBtn = $<HTMLButtonElement>('ik-mic');
  const attachBtn = $<HTMLButtonElement>('ik-attach');
  const tray = $<HTMLDivElement>('ik-tray');
  const fileInput = $<HTMLInputElement>('ik-files');
  const linkForm = $<HTMLFormElement>('ik-linkform');
  const linkInput = $<HTMLInputElement>('ik-link');
  const chips = $<HTMLDivElement>('ik-chips');
  const progress = $<HTMLSpanElement>('ik-progress');
  const bar = $<HTMLElement>('ik-bar');
  const sendNow = $<HTMLButtonElement>('ik-send-now');
  const recBtn = $<HTMLButtonElement>('ik-rec');
  const recQuick = $<HTMLButtonElement>('ik-rec-quick');
  const recBar = $<HTMLDivElement>('ik-recbar');
  const recLabel = $<HTMLSpanElement>('ik-rec-label');
  const recMeter = $<HTMLElement>('ik-rec-meter');
  const recStop = $<HTMLButtonElement>('ik-rec-stop');
  const toast = $<HTMLDivElement>('ik-toast');
  const agentId = root.dataset.agent || '';

  // Fit the stage to the viewport under the site header.
  const siteHeader = document.querySelector<HTMLElement>('header.hd');
  const fit = () => root.style.setProperty('--ik-top', `${siteHeader?.offsetHeight ?? 76}px`);
  fit();
  addEventListener('resize', fit);
  /** How much of the thread is covered (by the dock, or by an on-screen keyboard): pad the thread by exactly that. */
  const dockEl = document.querySelector<HTMLElement>('.ik-dock')!;
  const logEl = document.getElementById('ik-log')!;
  function measureCover() {
    const vv = window.visualViewport;
    const visibleBottom = vv ? vv.offsetTop + vv.height : innerHeight;
    const clearBottom = Math.min(dockEl.getBoundingClientRect().top, visibleBottom);
    const cover = Math.max(0, Math.round(logEl.getBoundingClientRect().bottom - clearBottom));
    root.style.setProperty('--ik-dock', `${cover}px`);
  }
  if ('ResizeObserver' in window) new ResizeObserver(measureCover).observe(dockEl);
  window.visualViewport?.addEventListener('resize', measureCover);
  addEventListener('resize', measureCover);
  /** Scroll the thread so an element (choice buttons) sits fully in the clear area above the composer. */
  function reveal(target: HTMLElement) {
    requestAnimationFrame(() => {
      measureCover();
      const lr = logEl.getBoundingClientRect();
      const vv = window.visualViewport;
      const limit = Math.min(lr.bottom, dockEl.getBoundingClientRect().top, vv ? vv.offsetTop + vv.height : innerHeight) - 12;
      const r = target.getBoundingClientRect();
      if (r.bottom > limit) logEl.scrollTop += r.bottom - limit;
      else if (r.top < lr.top + 8) logEl.scrollTop -= lr.top + 8 - r.top;
    });
  }
  /** Keep the stage in view: focusing fields inside the thread can scroll the page down to the footer. */
  const anchor = () => { if (scrollY > 0) scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' }); };

  // Per-employee / per-client links: ?employee=&client=
  const params = new URLSearchParams(location.search);
  const employee = params.get('employee') ?? '';
  const client = params.get('client') ?? '';

  // ---------- State (shared by chat and voice) ----------
  const steps: Step[] = [];
  let pos = 0;
  let actions: Action[] = [];
  let links: string[] = [];
  let files: File[] = [];
  let mode: Mode = 'chat';
  const answers = new Map<number, string>(); // core, journey lists and the closing answer, by qid
  const procs: Proc[][] = [[], [], []]; // drilled processes per journey stage
  const items: string[][] = [[], [], []]; // what they listed per journey stage
  const pending = new Map<string, { v: string; s?: 1 }>(); // voice answers given ahead of their turn
  const growth: (string | undefined)[] = []; // the optional Growth answers, G1-G8 (undefined = not offered)
  /** The Growth add-on is offered in this session. Off while replaying a session saved before it existed. */
  let growthOn = false;
  let replaying = false;
  let sent = false;
  let sending = false;

  // ---------- Routes: which questions, in which order, for this person's role ----------
  // PROVISIONAL. A role only changes which questions are asked and in what order. It is not an access permission:
  // there are no accounts, nothing is restricted, and every answer still goes into the same submission.
  type Block = { k: 'q'; id: string } | { k: 'j'; j: J } | { k: 'choice' } | { k: 'closing' } | { k: 't'; b: BriefStage };
  const Q = (...ids: string[]): Block[] => ids.map((id) => ({ k: 'q', id }));
  const ALL_AI = ['A1', 'A2', 'A3', 'A4', 'A5', 'A6', 'A7'];
  const ROUTE_PLAN: Record<Route, Block[]> = {
    // The whole business from the top: today's order.
    owner: [...Q('S1', 'S2', ...ALL_AI, 'T1', 'T2', 'T3', 'T4', 'T5'), { k: 'choice' }, { k: 'j', j: 0 }, { k: 'j', j: 1 }, { k: 'j', j: 2 }, { k: 'closing' }],
    // Same start, then how new business comes in; brand and customer come from their documents.
    marketing: [...Q('S1', 'S2', ...ALL_AI), { k: 'j', j: 0 }, { k: 'choice' }, ...Q('T1', 'T2', 'T3', 'T4', 'T5'), { k: 'j', j: 1 }, { k: 'j', j: 2 }, { k: 'closing' }],
    // The business name, then their own week through the drill, what blocks them and what they avoid, then tools.
    team: [...Q('S1'), { k: 'j', j: 2 }, ...Q('T3', 'T5', 'T1', 'T2', 'T4'), { k: 'choice' }, ...Q(...ALL_AI), { k: 'closing' }],
  };
  const blockKey = (b: Block) => (b.k === 'q' ? `q:${b.id}` : b.k === 'j' ? `j:${b.j}` : b.k === 't' ? `t:${b.b}` : b.k);
  let plan: Block[] = [];
  const usedBlocks = new Set<string>();
  const roles: Route[] = []; // every route they've answered as, in order (a second role adds to it)
  const answerTags = new Map<string, string>(); // which role (and person) each answer was given under
  let marketingEmphasis = false;
  let flow2 = false; // started with the role step
  const route = () => roles[roles.length - 1] ?? null;
  let legacyTag: Route | null = null; // a saved session's one-off answer: a tag only, it never changes the route
  const roleTag = () => (roles.length ? roles.map((r) => ROUTE_NAME[r]).join(' + ') : legacyTag ? ROUTE_NAME[legacyTag] : '');
  const respondent = () => greetName || employee;
  function setPlan(r: Route, add: boolean) {
    const fresh = ROUTE_PLAN[r].filter((b) => !usedBlocks.has(blockKey(b)));
    if (!add) { plan = withBrief(fresh); return; }
    const merged = plan.filter((b) => b.k !== 'closing');
    for (const b of fresh) if (b.k !== 'closing' && !merged.some((x) => blockKey(x) === blockKey(b))) merged.push(b);
    plan = withBrief([...merged, { k: 'closing' }]);
  }
  /** Brief-based interviews: leave out the questions we already know, and put each stage's tailored questions in
   *  place: before each part of how the work flows, after the tools questions, and before the last question.
   *  The standard questions keep their order, so the answers still line up with every other interview. */
  function withBrief(blocks: Block[]): Block[] {
    if (!brief) return blocks;
    const skip = new Set(brief.skip);
    const out = blocks.filter((b) => !(b.k === 'q' && skip.has(b.id)));
    const wanted = (k: BriefStage) => (brief!.questions[k]?.length ?? 0) > 0 && !usedBlocks.has(`t:${k}`) && !out.some((x) => x.k === 't' && x.b === k);
    const before = (pred: (b: Block) => boolean, blk: Block) => { const i = out.findIndex(pred); if (i >= 0) out.splice(i, 0, blk); };
    (['winning', 'doing', 'running'] as const).forEach((k, j) => { if (wanted(k)) before((b) => b.k === 'j' && b.j === j, { k: 't', b: k }); });
    if (wanted('connections')) {
      let last = -1;
      out.forEach((b, i) => { if (b.k === 'q' && CORE_QUESTIONS.find((q) => q.id === b.id)?.stage === 2) last = i; });
      if (last >= 0) out.splice(last + 1, 0, { k: 't', b: 'connections' });
      else before((b) => b.k === 'closing', { k: 't', b: 'connections' });
    }
    for (const k of ['gaps', 'marketing'] as const) if (wanted(k)) before((b) => b.k === 'closing', { k: 't', b: k });
    return out;
  }
  /** Take the next block of the plan that hasn't been asked yet, and add its first step. */
  function pullNext() {
    while (plan.length) {
      const b = plan.shift()!;
      const key = blockKey(b);
      if (usedBlocks.has(key)) continue;
      // Stage 3b: after all three journey stages, offer the optional Growth questions before the closing question.
      if (b.k === 'closing' && growthDue()) {
        usedBlocks.add('growth');
        plan.unshift(b);
        steps.push({ type: 'gchoice' });
        return;
      }
      usedBlocks.add(key);
      if (b.k === 'q') {
        const q = CORE_QUESTIONS.find((x) => x.id === b.id)!;
        const before = [...steps].reverse().find((x) => x.type !== 'role' && x.type !== 'role2');
        steps.push({ type: 'q', qid: q.qid, id: q.id, text: q.text, phase: 'core', stage: q.stage, hint: q.hint, first: !(before?.type === 'q' && before.phase === 'core' && before.stage === q.stage) });
      } else if (b.k === 'j') steps.push({ type: 'list', j: b.j });
      else if (b.k === 'choice') steps.push({ type: 'choice' });
      else if (b.k === 't') {
        (brief?.questions[b.b] ?? []).forEach((_q, i) => {
          steps.push({ type: 'tq', b: b.b, i });
          if (b.b === 'marketing') steps.push({ type: 'tq', b: b.b, i, f: true });
        });
        if (!steps[pos]) continue; // an empty stage: take the next block
      } else addClosing();
      return;
    }
  }

  const answerable = (s?: Step): s is Answerable => !!s && (s.type === 'q' || s.type === 'list' || s.type === 'name' || s.type === 'drill' || s.type === 'role' || s.type === 'role2' || s.type === 'growth' || s.type === 'tq');
  /** Growth is offered once, only after all three journey stages were taken (not after "Finish here"). */
  const growthDue = () => growthOn && !usedBlocks.has('growth') && JOURNEY.every((_J, j) => usedBlocks.has(`j:${j}`));
  /** On the team route, Operate is about the person's own week. */
  const teamWeek = (j: J) => j === 2 && route() === 'team' && !roles.includes('owner');
  const jTitle = (j: J) => (teamWeek(j) ? 'Your week' : JOURNEY[j].label);
  /** "Another one for winning work?" */
  const anotherText = (j: J) => (teamWeek(j) ? 'Another task from your week?' : `Another one for ${JOURNEY[j].label.toLowerCase()}?`);
  const TEAM_LIST_TEXT = 'What do you do in a normal week? Name each task, one per line.';
  const TEAM_LIST_HINT = 'For example, an office manager: invoicing, booking jobs, answering the phones, ordering stock. A marketing coordinator: social posts, the newsletter, monthly reporting.';
  const stepKey = (s?: Step) =>
    !s ? '' : s.type === 'q' ? `q:${s.id}` : s.type === 'list' ? `q:${JOURNEY[s.j].id}` : s.type === 'drill' ? `d:${s.j}:${s.p}:${s.d}` : s.type === 'growth' ? `g:${s.g}` : s.type === 'tq' ? `t:${tqKey(s)}` : '';
  function stepText(s?: Step): string {
    if (!s) return '';
    switch (s.type) {
      case 'q': return s.text;
      case 'list': return teamWeek(s.j) ? TEAM_LIST_TEXT : JOURNEY[s.j].text;
      case 'role': return s.mode === 'legacy' ? ROLE_QUESTION_LEGACY : ROLE_QUESTION;
      case 'role2': return ROLE_FOLLOW_UP;
      case 'name': return s.prompt;
      case 'drill': return DRILL[s.d].text;
      case 'another': return anotherText(s.j);
      case 'choice': return CHOICE_TEXT;
      case 'gchoice': return GROWTH_OFFER.text;
      case 'growth': return GROWTH_QUESTIONS[s.g].text;
      case 'tq': return !brief ? '' : s.b === 'opening' ? brief.opening : s.f ? MARKETING_FOLLOW_UP : brief.questions[s.b]?.[s.i] ?? '';
      default: return '';
    }
  }
  const listJoin = (xs: string[]) => (xs.length <= 1 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
  const filled = (v?: string) => v !== undefined && v !== SKIPPED && v.trim() !== '';

  // ---------- Journey: lists, process names, the drill loop ----------
  const cleanItem = (l: string) => l.replace(/^\s*(?:[-*•–]|\d+[.)])\s*/, '').trim();
  /** One per line is the ask. A single line with commas ("pick, pack and ship") is read as several. */
  function parseItems(v: string): { list: string[]; multiLine: boolean } {
    if (!v || v === SKIPPED) return { list: [], multiLine: false };
    const lines = v.split(/\n+/).map(cleanItem).filter(Boolean);
    if (lines.length >= 2) return { list: lines, multiLine: true };
    const one = lines[0] ?? '';
    const parts = one.split(/\s*[,;]\s*|\s+and\s+/i).map(cleanItem).filter(Boolean);
    return { list: parts.length >= 2 ? parts : one ? [one] : [], multiLine: false };
  }
  const short = (name: string) => name.slice(0, 80).trim();
  const drilledNames = (j: J) => procs[j].map((p) => p.name);
  const undrilled = (j: J) => items[j].map(short).filter((it) => !drilledNames(j).includes(it));
  function startProcess(j: J, p: number, name: string) {
    procs[j][p] = { name: short(name), answers: [] };
    for (let d = 0; d < DRILL.length; d++) steps.push({ type: 'drill', j, p, d });
  }
  function nextStage(_j: J) {
    pullNext();
  }
  function endProcess(j: J, p: number) {
    if (p + 1 < MAX_PROCESSES) steps.push({ type: 'another', j, p, next: undrilled(j)[0] });
    else nextStage(j);
  }
  function addClosing() {
    steps.push({ type: 'q', qid: CLOSING.anythingElse.qid, id: 'W1', text: CLOSING.anythingElse.text, phase: 'closing' });
    steps.push({ type: 'files' });
  }
  function procBlock(pr: Proc) {
    if (pr.skipped) return SKIPPED;
    const lines = [`Workflow: ${pr.name}`];
    DRILL.forEach((d, i) => { if (pr.answers[i] !== undefined) lines.push(`${d.label}: ${pr.answers[i]}`); });
    return lines.join('\n');
  }
  /** Stages with more than three named processes: the ones not drilled go into the closing answer. */
  function moreProcesses() {
    const parts = JOURNEY.map((J, j) => {
      if (items[j].length <= MAX_PROCESSES) return '';
      const rest = undrilled(j as J);
      return rest.length ? `${J.title}: ${rest.join('; ')}` : '';
    }).filter(Boolean);
    return parts.length ? `More workflows:\n${parts.join('\n')}` : '';
  }
  /** Everything for Jotform, by qid: only what was actually asked. */
  /** The pure builder (src/data/intake-growth.ts) keeps today's order; the Growth block only appears when answered. */
  /** Brief-based interviews: answers we already have for the questions the brief skips. */
  function presetAnswers(): Map<number, string> {
    const m = new Map<number, string>();
    if (brief) for (const id of brief.skip) {
      const q = CORE_QUESTIONS.find((x) => x.id === id);
      if (q) m.set(q.qid, id === 'S1' ? brief.businessName : NOT_ASKED);
    }
    return m;
  }
  function payloadFields(): [number, string][] {
    const slots: [number, string][] = [];
    JOURNEY.forEach((J, j) => procs[j].forEach((pr, p) => { if (pr) slots.push([J.slots[p], procBlock(pr)]); }));
    // Questions the brief skipped are sent as "not asked", and the business name comes from the brief.
    const all = new Map(answers);
    for (const [qid, v] of presetAnswers()) if (!all.has(qid)) all.set(qid, v);
    return buildPayload({
      answers: all,
      tailored: brief ? tailoredBlock(brief, tailored) : '',
      slots,
      more: moreProcesses(),
      answeredAs: roleTag() ? `Answered as: ${roleTag()}${respondent() ? ` (${respondent()})` : ''}` : '',
      growth,
      anythingElseQid: CLOSING.anythingElse.qid,
    });
  }
  const growthSent = () => growth.some(filled);
  function tally() {
    const all = [...answers.values(), ...procs.flat().flatMap((p) => (p.skipped ? [SKIPPED] : p.answers.filter((v): v is string => v !== undefined)))];
    // Growth answers count only when the Growth block is sent (at least one answered).
    if (growthSent()) all.push(...growth.filter((v): v is string => v !== undefined));
    all.push(...tailored.values());
    return { answered: all.filter(filled).length, skipped: all.filter((v) => v === SKIPPED).length };
  }
  const hasAnything = () => answers.size > 0 || procs.some((ps) => ps.length > 0) || growthSent() || tailored.size > 0;

  function save() {
    if (sent) return;
    try { localStorage.setItem(STORE, JSON.stringify({ v: 3, actions, links, mode, ...(flow2 ? { flow: 2 as const } : {}), ...(growthOn ? { g: 1 as const } : {}) } satisfies Saved)); } catch {}
  }
  function load(): Saved {
    const empty: Saved = { v: 3, actions: [], links: [], mode: 'chat' };
    try {
      const raw = JSON.parse(localStorage.getItem(STORE) || 'null');
      if (raw && raw.v === 3) return { ...empty, ...raw };
    } catch {}
    return empty;
  }
  function clear() {
    try { localStorage.removeItem(STORE); } catch {}
  }

  // ---------- Orb level: Harry's voice, your mic, or text streaming ----------
  let lvl = 0;
  let lvlTarget = 0;
  let lvlRaf = 0;
  function bump(v: number) {
    if (reduced) return;
    lvlTarget = Math.max(lvlTarget, Math.min(1, v));
    if (!lvlRaf) lvlRaf = requestAnimationFrame(lvlLoop);
  }
  function lvlLoop() {
    lvl += (lvlTarget - lvl) * 0.28;
    lvlTarget *= 0.9;
    root.style.setProperty('--lvl', lvl.toFixed(3));
    if (lvl > 0.003 || lvlTarget > 0.003) lvlRaf = requestAnimationFrame(lvlLoop);
    else { lvlRaf = 0; root.style.setProperty('--lvl', '0'); }
  }

  // ---------- Rendering ----------
  function scroll() {
    if (!replaying) log.scrollTop = log.scrollHeight;
  }
  function add<T extends HTMLElement>(el: T): T {
    if (replaying) el.style.animation = 'none';
    thread.appendChild(el);
    scroll();
    return el;
  }
  const el = (tag: string, cls: string, text?: string) => {
    const e = document.createElement(tag);
    e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  };
  const ORB = '<span class="ik-orb ik-orb--sm" aria-hidden="true"><span class="ik-orb__halo"></span><span class="ik-orb__core"></span></span>';

  /** One of Harry's turns: a mini orb and a line of text (a question is shown large while it's current). */
  function harryTurn(isQuestion: boolean) {
    const turn = el('div', `ik-turn${isQuestion ? ' ik-turn--q' : ''}`);
    turn.innerHTML = ORB;
    const body = el('div', 'ik-turn__body');
    turn.append(body);
    add(turn);
    return body;
  }
  function settleQuestions() {
    thread.querySelectorAll('.ik-q.is-current').forEach((q) => q.classList.remove('is-current'));
  }
  function answer(text: string, kind: 'you' | 'spoken' | 'skip') {
    if (kind === 'skip') {
      const p = el('p', 'ik-a ik-a--skip');
      p.innerHTML = '<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h12M13 6l6 6-6 6"/></svg>';
      p.append("Skipped. We'll cover it on the call");
      return add(p);
    }
    return add(el('p', `ik-a${kind === 'spoken' ? ' ik-a--spoken' : ''}`, text));
  }
  function fileMsg(text: string) {
    const p = el('p', 'ik-a ik-a--file');
    p.innerHTML = '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5l-8.6 8.6a5.5 5.5 0 0 1-7.8-7.8l8.6-8.6a3.7 3.7 0 0 1 5.2 5.2l-8.6 8.6a1.8 1.8 0 0 1-2.6-2.6l7.9-7.9"/></svg>';
    p.append(el('span', '', text));
    return add(p);
  }
  function section(eyebrow: string, title: string, proc = false) {
    const d = el('div', `ik-section ik-divider${proc ? ' ik-section--proc' : ''}`);
    d.append(el('span', '', eyebrow), el('strong', '', title));
    return add(d);
  }
  function note(text: string, linkText?: string, onClick?: () => void, error = false) {
    const p = el('p', `ik-note${error ? ' ik-note--error' : ''}`);
    p.append(text);
    if (linkText && onClick) {
      const b = el('button', '', linkText) as HTMLButtonElement;
      b.type = 'button';
      b.addEventListener('click', onClick);
      p.append(' ', b);
    }
    return add(p);
  }

  const wait = (ms: number) => (replaying || reduced ? Promise.resolve() : new Promise((r) => setTimeout(r, ms)));

  /** Harry "types": a short think, then the words stream in. Screen readers get the full line at once. */
  async function harrySays(text: string, opts: { question?: boolean; error?: boolean } = {}) {
    if (opts.error) return note(text, undefined, undefined, true);
    if (opts.question) settleQuestions();
    const body = harryTurn(!!opts.question);
    const p = el('p', opts.question ? 'ik-q is-current' : 'ik-say');
    body.append(p);
    if (replaying || reduced) {
      p.textContent = text;
      return p;
    }
    const think = el('span', 'ik-think');
    think.innerHTML = '<i></i><i></i><i></i>';
    think.setAttribute('aria-hidden', 'true');
    p.append(think);
    scroll();
    await wait(380);
    p.textContent = '';
    const sr = el('span', 'ik-sr', text);
    const vis = el('span', '');
    vis.setAttribute('aria-hidden', 'true');
    p.append(sr, vis);
    const words = text.split(/(\s+)/);
    const per = Math.max(18, Math.min(55, 1100 / Math.max(1, words.length / 2)));
    let out = '';
    for (const w of words) {
      out += w;
      vis.textContent = out;
      if (w.trim()) { bump(0.28 + Math.random() * 0.25); scroll(); await wait(per); }
    }
    p.textContent = text;
    scroll();
    return p;
  }

  function lock(locked: boolean) {
    if (locked) composer.setAttribute('data-locked', '');
    else composer.removeAttribute('data-locked');
    input.disabled = locked;
    skipBtn.disabled = locked;
    sendBtn.disabled = locked;
    micBtn.disabled = locked;
    const s = steps[pos];
    input.placeholder = locked
      ? (answerable(s) || !s ? 'Harry is typing…' : s.type === 'files' ? 'All questions answered' : 'Pick an option above')
      : s?.type === 'list' ? 'One per line…' : s?.type === 'name' ? 'Name the job…' : s?.type === 'role' ? 'Your role, in your own words…' : 'Type your answer…';
    if (!locked && !replaying && mode === 'chat' && (actions.length || finePointer)) input.focus({ preventScroll: true });
  }

  /** Journey units: each stage's list question plus 8 per process (at least one process per stage). */
  function journeyUnits() {
    const total = JOURNEY.reduce((sum, _J, j) => {
      const planned = procs[j].length ? procs[j].filter((p) => !p.skipped).length : 1;
      return sum + 1 + DRILL.length * planned;
    }, 0);
    const done = steps.slice(0, pos).filter((x) => x.type === 'list' || x.type === 'drill').length;
    return { total, done };
  }

  function updateProgress() {
    const s = steps[pos];
    const coreDone = steps.slice(0, pos).filter((x) => x.type === 'q' && x.phase === 'core').length;
    const jy = journeyUnits();
    const folder = displayName();
    let label = '';
    let pct = 0;
    if (root.dataset.view === 'welcome') { label = brief ? `Prepared for ${brief.businessName}` : 'Roadmap Labs intake'; pct = 0; }
    else if (isRoleStep(s)) { label = `Your role · ${folder}`; pct = 1; }
    else if (sent) { label = `All sent · ${folder}`; pct = 100; }
    else if (!s || s.type === 'files') { label = `Ready to send · ${folder}`; pct = 100; }
    else if (s.type === 'choice') { label = `Core done · ${folder}`; pct = 34; }
    else if (s.type === 'gchoice') { label = `Main questions done · ${folder}`; pct = 95; }
    else if (s.type === 'growth') { label = `Growth, optional · ${folder}`; pct = 95; }
    else if (s.type === 'q' && s.phase === 'core') { label = `${CORE_STAGES[s.stage!].title} · ${folder}`; pct = (coreDone / CORE_QUESTIONS.length) * 34; }
    else if (s.type === 'q') { label = `Last question · ${folder}`; pct = 96; }
    else if (s.type === 'tq') {
      label = `${s.b === 'opening' ? 'A quick check' : STAGE_LABEL[s.b]} · ${folder}`;
      pct = s.b === 'opening' ? 1 : JOURNEY_STAGE[s.b] !== undefined ? 34 + (jy.done / jy.total) * 60 : s.b === 'connections' ? 33 : 94;
    }
    else {
      pct = 34 + (jy.done / jy.total) * 60;
      label = s.type === 'drill' || s.type === 'another' ? `${jTitle(s.j)}: ${procs[s.j][s.p].name} · ${folder}` : `${jTitle(s.j)} · ${folder}`;
    }
    const [main, ...rest] = label.split(' · ');
    progress.textContent = '';
    progress.append(el('b', '', main));
    if (rest.length) progress.append(el('i', '', ' · '), el('span', '', rest.join(' · ')));
    // Progress follows this person's route (a journey stage counts as about ten questions).
    if (roles.length && pct > 0 && pct < 100) {
      const weight = (b: Block) => (b.k === 'q' ? 1 : b.k === 'j' ? 10 : b.k === 'closing' ? 1 : 0);
      const keys = new Set<string>();
      let total = 0;
      for (const r of roles) for (const b of ROUTE_PLAN[r]) if (!keys.has(blockKey(b))) { keys.add(blockKey(b)); total += weight(b); }
      const done = steps.slice(0, pos).filter((x) => x.type === 'q' || x.type === 'list' || x.type === 'drill' || x.type === 'tq').length;
      if (brief) total += tailoredIds(brief).length;
      pct = Math.min(96, Math.max(2, (done / Math.max(1, total)) * 100));
    }
    bar.style.width = `${Math.max(2, Math.round(pct))}%`;
    sendNow.hidden = sent || !hasAnything() || s?.type === 'files';
    const caption = document.getElementById('ik-voice-caption');
    if (caption) caption.textContent = !s ? '' : s.type === 'choice' ? "That's the core done. Keep going, or finish here?" : s.type === 'gchoice' ? 'Optional: about 5 minutes of growth questions, or skip to the last question.' : s.type === 'files' ? 'All questions done.' : stepText(s);
  }

  // ---------- Your folder: what's been captured so far ----------
  // Provisional depth rules live in src/data/intake-depth.ts. This shows captured context, never finished files.
  interface FolderFile { path: string; state: FileState; kind: 'core' | 'docs' | 'workflow' | 'growth'; name?: string }
  /** What people see in place of file names. The paths stay internal. */
  const FILE_LABEL: Record<string, [label: string, topic: string]> = {
    'README.md': ['Your business', 'your business'],
    'brand.md': ['Your brand', 'your brand'],
    'customer.md': ['Your customers', 'your customers'],
    'reference.md': ['Your tools', 'your tools'],
    'growth.md': ['Growth ideas', 'growth'],
  };
  const labelOf = (f: FolderFile) => (f.kind === 'workflow' ? f.name ?? 'A job' : FILE_LABEL[f.path]?.[0] ?? f.path);
  const topicOf = (f: FolderFile) => (f.kind === 'workflow' ? `"${f.name}"` : FILE_LABEL[f.path]?.[1] ?? f.path);
  /** growth.md: the optional Growth answers captured so far. Solid at six or more answered. */
  function growthState(): FileState {
    const got = GROWTH_QUESTIONS.filter((_q, i) => filled(growth[i]));
    const open = GROWTH_QUESTIONS.find((_q, i) => !filled(growth[i]));
    const solid = got.length >= 6;
    return {
      depth: solid ? 'solid' : got.length ? 'thin' : 'empty',
      has: got.length <= 2 ? got.map((q) => q.topic) : [got[0].topic, `${got.length - 1} more growth answers`],
      gap: solid ? '' : open ? `not ${open.topic} yet` : '',
      size: got.length,
    };
  }
  // The header subtitle and the panel use the same name: a short S1 answer, or the placeholder.
  /** The business name as people say it (no "OS/"), or "Your business" until one is given. */
  const displayName = () => businessName(answers.get(CORE_QUESTIONS[0].qid)) || brief?.businessName || 'Your business';
  function folderFiles(): FolderFile[] {
    const preset = presetAnswers();
    const a = (q: number) => answers.get(q) ?? preset.get(q);
    const shared = files.length > 0 || links.length > 0;
    const out: FolderFile[] = [
      { path: 'README.md', state: readme(a), kind: 'core' },
      { path: 'brand.md', state: fromDocuments(shared), kind: 'docs' },
      { path: 'customer.md', state: fromDocuments(shared), kind: 'docs' },
      { path: 'reference.md', state: reference(a), kind: 'core' },
    ];
    const used = new Set<string>();
    for (const pr of procs.flat()) {
      if (!pr || pr.skipped) continue;
      let f = workflowFile(pr.name);
      for (let n = 2; used.has(f); n++) f = f.replace(/(?:-\d+)?\.md$/, `-${n}.md`);
      used.add(f);
      out.push({ path: `workflows/${f}`, state: workflow(pr.answers), kind: 'workflow', name: pr.name });
    }
    out.push({ path: 'growth.md', state: growthState(), kind: 'growth' });
    return out;
  }
  const fileOf = (path: string) => folderFiles().find((f) => f.path === path);
  const workflowPath = (j: J, p: number) => {
    const target = procs[j][p];
    const i = procs.flat().filter((x) => x && !x.skipped).indexOf(target);
    return folderFiles().filter((f) => f.kind === 'workflow')[i]?.path ?? `workflows/${workflowFile(target.name)}`;
  };
  /** One line about what we have, in plain words: "On your tools, we now have your tools and your CRM, but not costs yet." */
  function describe(path: string) {
    const f = fileOf(path);
    if (!f) return '';
    const topic = topicOf(f);
    if (f.state.depth === 'empty') return `Nothing yet on ${topic}; we'll cover it on the call.`;
    if (f.state.depth === 'solid') return `That's plenty on ${topic}: ${listJoin(f.state.has)}.`;
    return f.state.has.length ? `On ${topic}, we now have ${listJoin(f.state.has)}, but ${f.state.gap}.` : `We have a start on ${topic}, but ${f.state.gap}.`;
  }

  const tree = $<HTMLDivElement>('ik-tree');
  const folderBtn = $<HTMLButtonElement>('ik-folder-btn');
  const panel = $<HTMLElement>('ik-panel');
  const seen = new Map<string, { size: number; depth: Depth }>();
  const DOC = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>';
  const DIR = '<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>';
  function renderFolder() {
    const list = folderFiles();
    tree.textContent = '';
    const dir = (name: string, cls = '') => { const d = el('div', `ik-dir ${cls}`.trim()); d.innerHTML = DIR; d.append(el('span', '', name)); tree.append(d); };
    let grew = false;
    const row = (f: FolderFile) => {
      const r = el('div', `ik-file${f.kind === 'workflow' ? ' ik-file--wf' : ''}`);
      r.dataset.depth = f.state.depth;
      r.dataset.path = f.path;
      r.append(el('span', 'ik-file__name', labelOf(f)));
      const depth = el('span', 'ik-depth');
      depth.setAttribute('aria-label', `How much we have: ${DEPTH_LABEL[f.state.depth].toLowerCase()}`);
      depth.innerHTML = '<span class="ik-depth__bar" aria-hidden="true"><i></i><i></i><i></i></span>';
      depth.append(el('span', '', DEPTH_LABEL[f.state.depth]));
      r.append(depth);
      const sub = f.kind === 'docs' && f.state.depth === 'empty' ? f.state.gap
        : f.state.depth === 'solid' ? listJoin(f.state.has)
        : f.state.has.length ? `${listJoin(f.state.has)} · ${f.state.gap}` : f.state.gap;
      r.append(el('span', 'ik-file__sub', sub));
      const before = seen.get(f.path);
      if (!before && !replaying) r.classList.add('is-new');
      else if (before && (f.state.size > before.size || f.state.depth !== before.depth) && !replaying) { r.classList.add('is-grew'); grew = true; setTimeout(() => r.classList.remove('is-grew'), 1600); }
      seen.set(f.path, { size: f.state.size, depth: f.state.depth });
      tree.append(r);
    };
    dir(displayName());
    // Core files appear once their first answer lands; brand.md and customer.md come from documents, so they show from the start.
    for (const f of list.filter((x) => x.kind === 'core' || x.kind === 'docs')) if (f.kind === 'docs' || f.state.size > 0) row(f);
    dir('Your jobs', 'ik-dir--sub');
    const wfs = list.filter((x) => x.kind === 'workflow');
    if (wfs.length) wfs.forEach(row);
    else tree.append(el('p', 'ik-placeholder', 'Each job you walk us through shows up here.'));
    // The optional Growth add-on: shown only once a growth answer lands.
    for (const f of list.filter((x) => x.kind === 'growth')) if (f.state.size > 0) row(f);
    $<HTMLElement>('ik-folder-n').textContent = String(list.filter((f) => f.state.depth !== 'empty').length);
    const roleLine = $<HTMLElement>('ik-role-line');
    roleLine.hidden = !roleTag() || sent;
    $<HTMLElement>('ik-role-name').textContent = `${roleTag()}${marketingEmphasis && roles[0] === 'owner' && !roles.includes('marketing') ? ' (with a marketing focus)' : ''}${respondent() ? ` · ${respondent()}` : ''}`;
    if (grew && panel.dataset.open === undefined) { folderBtn.classList.remove('is-grew'); void folderBtn.offsetWidth; folderBtn.classList.add('is-grew'); }
  }
  function openPanel(open: boolean) {
    if (open) panel.dataset.open = ''; else delete panel.dataset.open;
    folderBtn.setAttribute('aria-expanded', String(open));
    if (open) $<HTMLButtonElement>('ik-panel-close').focus({ preventScroll: true });
  }
  folderBtn.addEventListener('click', () => openPanel(panel.dataset.open === undefined));
  // Change or add a role at any point: answers so far are kept; the next sections follow the new role.
  $<HTMLButtonElement>('ik-role-change').addEventListener('click', () => { openPanel(false); act({ t: 'c', v: 'role:change' }); });
  $<HTMLButtonElement>('ik-role-add').addEventListener('click', () => { openPanel(false); act({ t: 'c', v: 'role:add' }); });
  $<HTMLButtonElement>('ik-panel-close').addEventListener('click', () => { openPanel(false); folderBtn.focus({ preventScroll: true }); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && panel.dataset.open !== undefined) { openPanel(false); folderBtn.focus(); } });
  document.addEventListener('pointerdown', (e) => {
    if (panel.dataset.open !== undefined && !panel.contains(e.target as Node) && !folderBtn.contains(e.target as Node)) openPanel(false);
  });

  // ---------- What Harry says between steps ----------
  function journeyRecap(j: J) {
    const names = procs[j].filter((pr) => pr && !pr.skipped).map((pr) => pr!.name);
    const title = jTitle(j).toLowerCase();
    return names.length ? `That's ${title} covered: ${listJoin(names)}.` : `That's ${title} done; we'll go through it on the call.`;
  }
  const fileForStage = (n: number) => (n === 2 ? 'reference.md' : 'README.md');
  const isRoleStep = (x?: Step) => x?.type === 'role' || x?.type === 'role2';
  /** The step before i, skipping role questions. */
  const before = (i: number) => { for (let k = i - 1; k >= 0; k--) if (!isRoleStep(steps[k])) return steps[k]; return undefined; };
  function recapOf(prev?: Step) {
    if (!prev) return '';
    if (prev.type === 'q' && prev.phase === 'core') return describe(fileForStage(prev.stage!));
    if (prev.type === 'list' || prev.type === 'name' || prev.type === 'drill' || prev.type === 'another') return journeyRecap(prev.j);
    return '';
  }
  function journeyIntro(j: J) {
    if (route() === 'owner' || roles.includes('owner')) return JOURNEY[j].intro;
    if (route() === 'team' && j === 2) return "Let's start with your own week. For each task you name, I'll ask a few questions so we can write down how it's done.";
    return ["Now, how new business comes in. For each one you name, I'll ask a few questions so we can write down how it's done.", 'Next, how the work you sell actually gets done.', 'Next, everything that runs around the work.'][j];
  }
  async function transition(i: number) {
    const s = steps[i];
    const prev = steps[i - 1];
    if (!prev || !s) return;
    if (s.type === 'role' && prev.type === 'tq' && prev.b === 'opening') { await harrySays('Thanks. Next, a quick one about your role, so the questions fit.'); return; }
    if (s.type === 'tq' && !s.f && s.b !== 'opening' && s.i === 0) {
      const name = brief?.businessName ?? 'you';
      const j = JOURNEY_STAGE[s.b];
      const lead = j !== undefined ? `${journeyIntro(j)} I'll start with a few questions just for ${name}.`
        : s.b === 'connections' ? `A few questions on how AI sees ${name} today.`
        : s.b === 'gaps' ? `A few more, just for ${name}: competitors and gaps.`
        : 'Now marketing and growth. Rough answers are fine, and there are no wrong ones.';
      await harrySays(`${isRoleStep(prev) ? '' : recapOf(before(i))} ${lead}`.trim());
      return;
    }
    if (s.type === 'list' && prev.type === 'tq') { await harrySays("Now the main jobs themselves, so we can go through each one."); return; }
    if (isRoleStep(prev)) {
      // The echo: what Harry understood, and an easy way to correct it.
      const echo = (prev as { echo?: string }).echo;
      if (echo) {
        const line = await harrySays(echo);
        if (steps[pos] === s && !(prev.type === 'role' && prev.mode === 'legacy')) {
          quick(helpers(line.parentElement), [{ label: 'Not right? Change it', onClick: () => act({ t: 'c', v: 'role:change' }) }]);
        }
      }
      return;
    }
    if ((s.type === 'q' && s.phase === 'core' && s.first) || s.type === 'list') {
      const last = before(i);
      if (!last) return; // the very first question: the welcome line covers it
      const intro = s.type === 'q' ? CORE_STAGES[s.stage!].intro : journeyIntro(s.j);
      await harrySays(`${recapOf(last)} ${intro}`.trim());
    } else if (s.type === 'drill' && s.d === 0) {
      const name = procs[s.j][s.p].name;
      await harrySays(s.p === 0 ? `Let's start with ${name}.` : `Next: ${name}.`);
    } else if (s.type === 'another') {
      await harrySays(describe(workflowPath(s.j, s.p)));
    } else if (s.type === 'gchoice') {
      const recap = recapOf(before(i));
      if (recap) await harrySays(recap);
    } else if (s.type === 'growth' && s.g === 0) {
      await harrySays('Growth, then. Short answers are fine, and you can skip any of them.');
    } else if (s.type === 'q' && s.phase === 'closing' && (before(i)?.type === 'growth' || before(i)?.type === 'gchoice')) {
      await harrySays(growthSent() ? `${describe('growth.md')} One last question.` : 'No problem. One last question.');
    } else if (s.type === 'q' && s.phase === 'closing') {
      const last = before(i);
      const fromJourney = last && last.type !== 'q' && last.type !== 'choice' && last.type !== 'tq';
      await harrySays(last?.type === 'choice' ? 'No problem. One last question before you go.' : `${recapOf(last)}${fromJourney ? ' That covers how the work flows.' : ''} One last question.`.trim());
    }
  }

  // ---------- Rendering steps ----------
  /** "Part 2 of 4": parts in the order this person's route visits them. */
  function partLabel(group: string) {
    const groups: string[] = [];
    for (const r of roles.length ? roles : (['owner'] as Route[])) for (const b of ROUTE_PLAN[r]) {
      const g = b.k === 'q' ? `c${CORE_QUESTIONS.find((q) => q.id === b.id)!.stage}` : b.k === 'j' ? 'journey' : '';
      if (g && !groups.includes(g)) groups.push(g);
    }
    const n = groups.indexOf(group) + 1;
    return n ? `Part ${n} of ${groups.length}` : 'Next';
  }
  function header(s: Step) {
    if (s.type === 'q' && s.phase === 'core' && s.first) section(partLabel(`c${s.stage}`), CORE_STAGES[s.stage!].title);
    else if (s.type === 'list' && steps[steps.indexOf(s) - 1]?.type !== 'tq') section(`${partLabel('journey')} · How the work flows`, jTitle(s.j));
    else if (s.type === 'tq' && !s.f && s.b !== 'opening' && s.i === 0) {
      const j = JOURNEY_STAGE[s.b];
      if (j !== undefined) section(`${partLabel('journey')} · How the work flows`, jTitle(j));
      else section(`Just for ${brief?.businessName ?? 'you'}`, STAGE_LABEL[s.b]);
    }
    else if (s.type === 'drill' && s.d === 0) section(`${jTitle(s.j)} · job ${s.p + 1} of up to ${MAX_PROCESSES}`, procs[s.j][s.p].name, true);
    else if (s.type === 'growth' && s.g === 0) section('Optional · about 5 minutes', 'Growth');
  }
  /** Replay after a refresh: the question as it was asked, no transitions or helpers. Synchronous on purpose. */
  function renderStatic(i: number) {
    const s = steps[i];
    if (!s) return;
    if (s.type === 'choice') { milestone(false); return; }
    if (s.type === 'gchoice') { growthCard(); return; }
    if (s.type === 'files') return;
    if (s.type === 'another') { harrySays(stepText(s), { question: true }); return; }
    header(s);
    harrySays(stepText(s), { question: true });
  }
  function hint(body: HTMLElement | null, text: string) {
    if (body) body.append(el('p', 'ik-hint', text));
  }
  function helpers(body: HTMLElement | null) {
    const box = el('div', 'ik-help');
    body?.append(box);
    return box;
  }
  function quick(box: HTMLElement, list: { label: string; primary?: boolean; onClick: () => void; data?: string }[]) {
    const row = el('div', 'ik-quick');
    for (const o of list) {
      const b = el('button', `ik-chipbtn${o.primary ? ' ik-chipbtn--primary' : ''}`, o.label) as HTMLButtonElement;
      b.type = 'button';
      if (o.data) b.dataset.choice = o.data;
      b.addEventListener('click', o.onClick);
      row.append(b);
    }
    box.append(row);
    scroll();
    reveal(row);
    return row;
  }
  function prefill(text: string) {
    input.value = input.value.trim() ? `${input.value.trim()}\n${text}` : text;
    autosize();
    input.focus({ preventScroll: true });
    input.setSelectionRange(input.value.length, input.value.length);
  }
  /** D4: when they attach, link or record while the example question is up, note it in the answer. */
  function noteExample(label: string) {
    const s = steps[pos];
    if (s?.type === 'drill' && s.d === 3 && !input.disabled) prefill(`Attached: ${label}`);
  }

  async function present(i = pos) {
    updateProgress();
    const s = steps[i];
    if (!s || sent) return;
    await transition(i);
    if (s.type === 'choice') {
      lock(true);
      settleQuestions();
      root.dataset.choosing = '';
      anchor();
      const card = milestone(true);
      if (steps[pos] !== s) return;
      const wrap = el('div', 'ik-choices');
      wrap.append(
        route() === 'owner' || !route()
          ? option('Keep going', 'About 20 min: how work comes in, gets done and gets looked after', true, () => { wrap.remove(); act({ t: 'c', v: 'more' }); }, 'more')
          : option('Keep going', route() === 'marketing' ? 'Your tools, then how work gets delivered and looked after' : 'How you use AI today', true, () => { wrap.remove(); act({ t: 'c', v: 'more' }); }, 'more'),
        option('Finish here', 'One last question, then share anything useful', false, () => { wrap.remove(); act({ t: 'c', v: 'wrap' }); }, 'wrap'),
      );
      card.append(wrap);
      scroll();
      reveal(wrap);
      if (!replaying && mode === 'chat') (wrap.firstChild as HTMLButtonElement).focus({ preventScroll: true });
      return;
    }
    if (s.type === 'gchoice') {
      lock(true);
      settleQuestions();
      root.dataset.choosing = '';
      anchor();
      const card = growthCard();
      if (steps[pos] !== s) return;
      const wrap = el('div', 'ik-choices');
      wrap.append(
        option(GROWTH_OFFER.yes, GROWTH_OFFER.yesSub, true, () => { wrap.remove(); act({ t: 'c', v: 'growth' }); }, 'growth'),
        option(GROWTH_OFFER.no, GROWTH_OFFER.noSub, false, () => { wrap.remove(); act({ t: 'c', v: 'nogrowth' }); }, 'nogrowth'),
      );
      card.append(wrap);
      scroll();
      reveal(wrap);
      if (!replaying && mode === 'chat') (wrap.firstChild as HTMLButtonElement).focus({ preventScroll: true });
      return;
    }
    if (s.type === 'files') {
      lock(true);
      settleQuestions();
      await harrySays('Last thing: anything you can share? Files, links and quick screen recordings all help us understand the business faster.');
      shareCard();
      return;
    }
    if (s.type === 'another') {
      lock(true);
      root.dataset.choosing = '';
      anchor();
      const q = await harrySays(stepText(s), { question: true });
      if (steps[pos] !== s) return;
      const opts: { label: string; primary?: boolean; v: string }[] = [];
      if (s.next) opts.push({ label: `Yes: ${s.next}`, primary: true, v: `next:${s.next}` });
      opts.push({ label: s.next ? 'Yes, a different one' : 'Yes, another one', primary: !s.next, v: 'another' });
      opts.push({ label: `No, move on${s.j < 2 ? ` to ${JOURNEY[s.j + 1].label.toLowerCase()}` : ''}`, v: 'done' });
      quick(helpers(q.parentElement), opts.map((o) => ({ label: o.label, primary: o.primary, data: o.v, onClick: () => act({ t: 'c', v: o.v }) })));
      return;
    }
    header(s);
    const q = await harrySays(stepText(s), { question: true });
    const body = q.parentElement;
    if (s.type === 'q' && s.hint) hint(body, s.hint);
    if (s.type === 'list') hint(body, stepText(s) === TEAM_LIST_TEXT ? TEAM_LIST_HINT : JOURNEY[s.j].hint);
    if (s.type === 'role') hint(body, 'This only changes which questions I ask, so they fit your part of the business.');
    if (s.type === 'drill' && s.d === 8) hint(body, D9_HINT);
    if (s.type === 'growth') hint(body, GROWTH_QUESTIONS[s.g].hint);
    if (steps[pos] === s) {
      // Growth is optional: skip this one with the usual Skip, or all the rest from here.
      if (s.type === 'growth') quick(helpers(body), [{ label: GROWTH_OFFER.no, data: 'growth:skip', onClick: () => act({ t: 'c', v: 'growth:skip' }) }]);
      if (s.type === 'name' && s.options.length) quick(helpers(body), s.options.map((o) => ({ label: o, onClick: () => act({ t: 'a', v: o }) })));
      // Optional shortcuts; typing your role works just the same.
      if (s.type === 'tq' && s.b === 'opening') quick(helpers(body), [{ label: "Yes, that's right", onClick: () => act({ t: 'a', v: "Yes, that's right" }) }]);
      if (s.type === 'role') quick(helpers(body), ROLE_CHIPS.map((c) => ({ label: c, onClick: () => (c === 'Other' ? (input.focus({ preventScroll: true }), (input.placeholder = 'Tell me in a few words…')) : act({ t: 'a', v: c })) })));
      if (s.type === 'role2') quick(helpers(body), ['Sales', 'Operations', 'Admin', 'Finance'].map((c) => ({ label: c, onClick: () => act({ t: 'a', v: c }) })));
      if (s.type === 'drill' && s.d === 3) exampleActions(helpers(body));
      if (s.type === 'drill' && s.d === 4) quick(helpers(body), D5_CHIPS.map((c) => ({ label: c, onClick: () => { input.value = ''; prefill(`${c}. `); input.placeholder = 'Add why, then send'; } })));
      if (s.type === 'drill' && s.d === 7) benchmark(helpers(body));
    }
    scroll();
    // A voice answer given ahead of its turn: take it rather than ask again.
    const ahead = pending.get(stepKey(s));
    if (steps[pos] === s && ahead) { act({ t: 'a', v: ahead.v, s: ahead.s }); return; }
    if (steps[pos] === s) lock(false);
  }

  function exampleActions(box: HTMLElement) {
    const list = [
      { label: 'Attach a file', onClick: () => fileInput.click() },
      { label: 'Paste a link', onClick: () => { openTray(true); showLinkField(); } },
    ];
    if (canRecord) list.push({ label: 'Record your screen', onClick: () => startRecording() });
    quick(box, list);
    box.append(el('p', 'ik-hint', 'Or paste the text straight into the box, like a real email or checklist.'));
  }

  /** D8: rough cost helper. Only their own figures; the maths is shown so they can correct it. */
  function benchmark(box: HTMLElement) {
    const card = el('div', 'ik-bench');
    card.innerHTML = `
      <div class="ik-bench__head"><strong>Rough cost helper</strong><small>A rough benchmark from your figures, not your actual cost. Change anything.</small></div>
      <div class="ik-bench__grid">
        <label>Who does it<input type="text" data-k="who" placeholder="e.g. office manager" autocomplete="off"></label>
        <label>Hours a week<input type="number" data-k="hours" min="0" step="0.5" inputmode="decimal" placeholder="e.g. 4"></label>
        <label>Hourly cost ($)<input type="number" data-k="rate" min="0" step="1" inputmode="decimal" placeholder="e.g. 45"></label>
        <label>or annual pay ($)<input type="number" data-k="annual" min="0" step="1000" inputmode="decimal" placeholder="e.g. 85000"></label>
      </div>
      <p class="ik-bench__maths" aria-live="polite">Add hours a week and an hourly cost or annual pay to see the maths.</p>`;
    const use = el('button', 'ik-chipbtn ik-chipbtn--primary', 'Use these figures') as HTMLButtonElement;
    use.type = 'button';
    use.disabled = true;
    card.append(use);
    box.append(card);
    const val = (k: string) => card.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!.value.trim();
    const num = (k: string) => { const n = parseFloat(val(k).replace(/[$,\s]/g, '')); return Number.isFinite(n) && n > 0 ? n : 0; };
    const money = (n: number, cents = false) => new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: cents ? 2 : 0, minimumFractionDigits: cents ? 2 : 0 }).format(n);
    const maths = card.querySelector<HTMLElement>('.ik-bench__maths')!;
    let summary = '';
    const update = () => {
      const hours = num('hours');
      const rate = num('rate');
      const annual = num('annual');
      const hourly = rate || (annual ? annual / BENCHMARK.hoursPerYear : 0);
      if (!hours || !hourly) {
        maths.textContent = 'Add hours a week and an hourly cost or annual pay to see the maths.';
        use.disabled = true;
        return;
      }
      const weekly = hourly * hours;
      const yearly = weekly * BENCHMARK.weeksPerYear;
      const from = rate ? `${money(rate, true)} an hour` : `${money(annual)} ÷ ${BENCHMARK.hoursPerYear.toLocaleString('en-AU')} h ≈ ${money(hourly, true)} an hour`;
      maths.textContent = `${from} × ${hours} h a week ≈ ${money(weekly)} a week × ${BENCHMARK.weeksPerYear} weeks ≈ ${money(yearly)} a year`;
      const who = val('who');
      summary = `Rough benchmark, not an actual cost: ${who ? `${who}, ` : ''}${hours} h a week at about ${money(hourly, true)} an hour${rate ? '' : ` (${money(annual)} a year ÷ ${BENCHMARK.hoursPerYear.toLocaleString('en-AU')} h)`} ≈ ${money(weekly)} a week, about ${money(yearly)} a year (${BENCHMARK.weeksPerYear} working weeks).`;
      use.disabled = false;
    };
    card.addEventListener('input', update);
    use.addEventListener('click', () => prefill(summary));
  }

  function milestone(live: boolean) {
    const card = el('div', 'ik-card ik-mile');
    card.innerHTML = `<span class="ik-mile__ring" aria-hidden="true"><svg viewBox="0 0 64 64" width="64" height="64"><circle class="bg" cx="32" cy="32" r="28"/><circle class="fg" cx="32" cy="32" r="28"/></svg><b><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></b></span>`;
    card.append(el('h3', '', "That's the core done"));
    const r = route() ?? 'owner';
    card.append(el('p', '', r === 'owner'
      ? `That was the core, about 10 minutes. ${describe('reference.md')} Keep going? About 20 more minutes on how work comes in, gets done and gets looked after. For each job you describe, we write down how it's done. Or finish here.`
      : r === 'marketing'
        ? `That's your core done: the basics, AI today and how new business comes in. ${describe('README.md')} Keep going with your tools and how the work gets done? Or finish here.`
        : `That's your core done: your week and the tools you use. ${describe('reference.md')} Keep going with a few questions on how you use AI? Or finish here.`));
    card.setAttribute('aria-label', CHOICE_TEXT);
    if (replaying || !live) card.querySelector<SVGCircleElement>('.fg')!.style.cssText = 'animation: none; stroke-dashoffset: 0';
    add(card);
    return card;
  }
  /** The optional Growth offer: same card and choice buttons as the milestone, without the core-done ring. */
  function growthCard() {
    const card = el('div', 'ik-card ik-grow');
    card.append(el('span', 'ik-grow__eyebrow', 'Optional · about 5 minutes'), el('h3', '', GROWTH_OFFER.title), el('p', '', GROWTH_OFFER.text));
    card.setAttribute('aria-label', GROWTH_OFFER.text);
    add(card);
    return card;
  }
  function option(label: string, sub: string, primary: boolean, onClick: () => void, data: string) {
    const b = el('button', `ik-opt${primary ? ' ik-opt--primary' : ''}`) as HTMLButtonElement;
    b.type = 'button';
    b.dataset.choice = data;
    b.append(el('strong', '', label), el('small', '', sub));
    b.addEventListener('click', onClick);
    return b;
  }

  function shareCard() {
    const card = el('div', 'ik-card ik-share');
    card.append(el('h3', '', 'Share anything useful'), el('p', '', 'A price list, a proposal you send, a report, or a quick recording of how something works. All optional.'));
    const tiles = el('div', 'ik-tiles');
    const tile = (icon: string, title: string, sub: string, onClick: () => void) => {
      const b = el('button', 'ik-tile') as HTMLButtonElement;
      b.type = 'button';
      b.innerHTML = `<span class="ik-tile__icon">${icon}</span>`;
      b.append(el('strong', '', title), el('small', '', sub));
      b.addEventListener('click', onClick);
      tiles.append(b);
    };
    tile(document.querySelector('#ik-tray label svg')!.outerHTML, 'Upload files', 'About 4MB in total', () => fileInput.click());
    tile(document.querySelector('#ik-menu-link svg')!.outerHTML, 'Add a link', 'Drive, Dropbox or Loom', () => { openTray(true); showLinkField(); });
    if (canRecord) tile(document.querySelector('#ik-rec svg')!.outerHTML, 'Record your screen', 'Talk us through it · up to 5 min', () => startRecording());
    card.append(tiles);
    const row = el('div', 'ik-share__send ik-choices');
    const send = el('button', 'ik-cta', 'Send everything') as HTMLButtonElement;
    send.type = 'button';
    send.id = 'ik-send-all';
    send.addEventListener('click', () => sendAll());
    row.append(send, el('small', '', 'You can send now; sharing is optional.'));
    card.append(row);
    add(card);
  }

  /** Apply one action to the current step: updates state now and returns the rendering to run in order,
   *  or null if the action doesn't fit (stale saved state, or a tool call for a step that has moved on). */
  /** A role answer has been read: set the route (or, for a session saved before roles, just tag it). */
  function settleRole(s: Extract<Step, { type: 'role' | 'role2' }>, text: string, followUp: string | null): boolean {
    const read = followUp === null ? readRole(text) : readRole(text, followUp, true);
    if (s.type === 'role' && s.mode === 'legacy') {
      // Saved before roles existed: tag answers from here on, never re-route or restart.
      legacyTag = read.route ?? 'team';
      s.echo = "Thanks. I'll carry on where we were. Your role only changes which questions I ask; you can change it any time under Your notes.";
      return true;
    }
    if (!read.route) return false; // ambiguous: one follow-up
    const add = s.mode === 'add';
    if (!add) roles.length = 0;
    if (!roles.includes(read.route)) roles.push(read.route);
    marketingEmphasis = marketingEmphasis || read.marketingEmphasis;
    // An owner who also looks after marketing: the owner spine, plus the marketing route's emphasis.
    setPlan(read.route, add);
    if (read.marketingEmphasis) setPlan('marketing', true);
    const midway = s.mode === 'change' || s.mode === 'add';
    s.echo = read.echo + (midway && steps[pos + 1] && steps[pos + 1].type !== 'role' ? " I'll use that from the next section." : '');
    if (s.mode === 'first') pullNext();
    return true;
  }

  function apply(a: Action): (() => void) | null {
    if (a.t === 'p') { pending.set(a.k, { v: a.v, s: a.s }); return () => {}; }
    // Change role, add a role, or the one-off role question for a saved session: insert the role question here.
    if (a.t === 'c' && a.v.startsWith('role:')) {
      if (steps[pos]?.type === 'role' || steps[pos]?.type === 'role2') return null;
      steps.splice(pos, 0, { type: 'role', mode: a.v.slice(5) as 'change' | 'add' | 'legacy' });
      return () => {};
    }
    const s = steps[pos];
    if (!s) return null;
    const show = (v: string, spoken?: 1) => () => { answer(v, v === SKIPPED ? 'skip' : spoken ? 'spoken' : 'you'); };
    let render: () => void;
    if (a.t === 'a' && (s.type === 'role' || s.type === 'role2')) {
      render = show(a.v, a.s);
      const resolved = s.type === 'role' ? settleRole(s, a.v, null) : settleRole(s, s.first, a.v);
      if (!resolved && s.type === 'role') steps.splice(pos + 1, 0, { type: 'role2', mode: s.mode as 'first' | 'change' | 'add', first: a.v });
    } else if (a.t === 'a' && s.type === 'q') {
      answers.set(s.qid, a.v);
      render = show(a.v, a.s);
    } else if (a.t === 'a' && s.type === 'list') {
      const J = JOURNEY[s.j];
      answers.set(J.qid, a.v);
      render = show(a.v, a.s);
      const { list, multiLine } = parseItems(a.v);
      items[s.j] = list;
      // One workflow per stage is guaranteed: take the first they named, or ask.
      if (multiLine) startProcess(s.j, 0, list[0]);
      else if (list.length >= 2) steps.push({ type: 'name', j: s.j, p: 0, prompt: 'Which of these matters most to start with?', options: list.slice(0, 6).map(short) });
      else if (list.length === 1 && list[0].length <= 80) startProcess(s.j, 0, list[0]);
      else if (list.length === 1) steps.push({ type: 'name', j: s.j, p: 0, prompt: 'What would you call that job, in a few words?', options: [] });
      else steps.push({ type: 'name', j: s.j, p: 0, prompt: `Which one should we start with? Just name one, like ${J.example}.`, options: [] });
    } else if (a.t === 'a' && s.type === 'name') {
      render = show(a.v, a.s);
      if (a.v === SKIPPED) {
        if (s.p === 0) procs[s.j][0] = { name: SKIPPED, answers: [], skipped: true };
        nextStage(s.j);
      } else {
        startProcess(s.j, s.p, a.v.trim());
      }
    } else if (a.t === 'a' && s.type === 'drill') {
      procs[s.j][s.p].answers[s.d] = a.v;
      render = show(a.v, a.s);
      if (s.d === DRILL.length - 1) endProcess(s.j, s.p);
    } else if (a.t === 'c' && s.type === 'another') {
      render = show(a.v === 'done' ? 'No, move on' : a.v.startsWith('next:') ? `Yes: ${a.v.slice(5)}` : 'Yes, another one');
      if (a.v === 'done') nextStage(s.j);
      else if (a.v.startsWith('next:')) startProcess(s.j, s.p + 1, a.v.slice(5));
      else steps.push({ type: 'name', j: s.j, p: s.p + 1, prompt: 'Which one is next? Just name it.', options: undrilled(s.j).slice(0, 6) });
    } else if (a.t === 'c' && s.type === 'gchoice' && (a.v === 'growth' || a.v === 'nogrowth')) {
      render = show(a.v === 'growth' ? GROWTH_OFFER.yes : GROWTH_OFFER.no);
      if (a.v === 'growth') GROWTH_QUESTIONS.forEach((q, g) => { if (!brief?.skip.includes(q.id)) steps.push({ type: 'growth', g }); });
    } else if (a.t === 'a' && s.type === 'tq') {
      tailored.set(tqKey(s), a.v);
      render = show(a.v, a.s);
      // A skipped marketing question has nothing to follow up on.
      const next = steps[pos + 1];
      if (s.b === 'marketing' && !s.f && a.v === SKIPPED && next?.type === 'tq' && next.f && next.i === s.i) steps.splice(pos + 1, 1);
    } else if (a.t === 'a' && s.type === 'growth') {
      growth[s.g] = a.v;
      render = show(a.v, a.s);
    } else if (a.t === 'c' && a.v === 'growth:skip' && s.type === 'growth') {
      // Skip the rest: each remaining question is "to fill", the same as skipping it on its own.
      for (let g = s.g; g < GROWTH_QUESTIONS.length; g++) growth[g] = SKIPPED;
      for (let k = steps.length - 1; k > pos; k--) if (steps[k].type === 'growth') steps.splice(k, 1);
      render = () => {
        const p = answer(SKIPPED, 'skip');
        p.lastChild!.textContent = "Skipped the growth questions. We'll cover them on the call if useful";
      };
    } else if (a.t === 'c' && s.type === 'choice') {
      render = show(a.v === 'more' ? 'Keep going' : 'Finish here');
      if (a.v !== 'more') plan = plan.filter((b) => b.k === 'closing');
      if (!plan.length && !usedBlocks.has('closing')) plan = [{ k: 'closing' }];
      pullNext();
    } else {
      return null;
    }
    if (a.t === 'a' && a.r) answerTags.set(stepKey(s) || `${s.type}:${pos}`, `${a.r}${a.n ? ` (${a.n})` : ''}`);
    pending.delete(stepKey(s));
    pos++;
    if (!steps[pos]) pullNext();
    return render;
  }

  // Thread rendering runs through one queue so messages always appear in script order,
  // even when voice tool calls arrive faster than Harry's typing animation.
  let queue: Promise<unknown> = Promise.resolve();
  const enqueue = (fn: () => unknown) => (queue = queue.then(fn).catch(() => {}));

  /** State changes synchronously, so callers (e.g. voice tools) see the new position immediately. */
  function act(a: Action): boolean {
    if (sent) return false;
    if (a.t === 'p') { pending.set(a.k, { v: a.v, s: a.s }); actions.push(a); save(); return true; }
    // Every answer is added (never replaced) with the role and person it was given under.
    if (a.t === 'a' && roleTag() && steps[pos]?.type !== 'role' && steps[pos]?.type !== 'role2') { a.r = roleTag(); if (respondent()) a.n = respondent(); }
    const render = apply(a);
    if (!render) return false;
    delete root.dataset.choosing;
    actions.push(a);
    const chain: (() => unknown)[] = [render];
    // Voice answers given ahead of their turn: take them now, in order, so nothing is asked twice.
    for (let ahead = pending.get(stepKey(steps[pos])); answerable(steps[pos]) && ahead; ahead = pending.get(stepKey(steps[pos]))) {
      const i = pos;
      const v = ahead;
      const r = apply({ t: 'a', v: v.v, s: v.s });
      if (!r) break;
      actions.push({ t: 'a', v: v.v, s: v.s });
      chain.push(async () => { await transition(i); header(steps[i]); await harrySays(stepText(steps[i]), { question: true }); r(); });
    }
    save();
    lock(true);
    updateProgress();
    anchor();
    const next = pos;
    enqueue(async () => {
      for (const c of chain) await c();
      renderFolder();
      updateProgress();
      await present(next);
    });
    return true;
  }

  // ---------- Optional: questions to Harry in chat ----------
  const looksLikeQuestion = (t: string) =>
    t.length < 240 && /\?\s*$/.test(t) && /^(what|why|how|who|whom|where|when|which|can|could|do|does|did|is|are|should|would|will|sorry|wait|hang on|um)\b/i.test(t);

  async function askHarry(text: string, current: string): Promise<string | null> {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 9000);
    try {
      const r = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, question: current }),
        signal: ctrl.signal,
      });
      if (r.status !== 200) return null;
      const d = await r.json();
      return typeof d.reply === 'string' && d.reply.trim() ? d.reply.trim() : null;
    } catch {
      return null;
    } finally {
      clearTimeout(timer);
    }
  }

  composer.addEventListener('submit', async (e) => {
    e.preventDefault();
    stopListening();
    const s = steps[pos];
    const text = input.value.trim();
    if (!text || !answerable(s)) return;
    input.value = '';
    autosize();
    if (looksLikeQuestion(text)) {
      lock(true);
      const reply = await askHarry(text, stepText(s));
      if (reply) {
        answer(text, 'you');
        await harrySays(reply);
        await harrySays(stepText(s), { question: true });
        const at = pos;
        const keep = note('Was that actually your answer?', 'Save it as my answer', () => {
          keep.remove();
          if (pos === at) act({ t: 'a', v: text });
        });
        lock(false);
        return;
      }
    }
    act({ t: 'a', v: text });
  });

  skipBtn.addEventListener('click', () => {
    stopListening();
    if (answerable(steps[pos])) act({ t: 'a', v: SKIPPED });
  });

  input.addEventListener('keydown', (e) => {
    // On phones, Enter adds a line on "one per line" questions; the send button sends.
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && !(steps[pos]?.type === 'list' && !finePointer)) {
      e.preventDefault();
      composer.requestSubmit();
    }
  });
  function autosize() {
    input.style.height = 'auto';
    input.style.height = `${Math.min(input.scrollHeight, 180)}px`;
  }
  input.addEventListener('input', autosize);

  // ---------- Speech to text in chat (browser speech recognition) ----------
  const SR = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
  let rec: any = null;
  if (SR) micBtn.hidden = false;
  let meter: { stream: MediaStream; ctx: AudioContext; raf: number } | null = null;
  async function startMeter() {
    // Desktop only: a second mic capture can upset speech recognition on phones.
    if (!finePointer || reduced || meter) return;
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const ctx = new AudioContext();
      const an = ctx.createAnalyser();
      an.fftSize = 512;
      ctx.createMediaStreamSource(stream).connect(an);
      const buf = new Uint8Array(an.fftSize);
      meter = { stream, ctx, raf: 0 };
      const tick = () => {
        if (!meter) return;
        an.getByteTimeDomainData(buf);
        let sum = 0;
        for (const v of buf) { const d = (v - 128) / 128; sum += d * d; }
        bump(Math.sqrt(sum / buf.length) * 5);
        meter.raf = requestAnimationFrame(tick);
      };
      tick();
    } catch {}
  }
  function stopMeter() {
    if (!meter) return;
    cancelAnimationFrame(meter.raf);
    meter.stream.getTracks().forEach((t) => t.stop());
    meter.ctx.close().catch(() => {});
    meter = null;
  }
  function stopListening() {
    if (rec) { try { rec.stop(); } catch {} }
  }
  function startListening() {
    if (rec || !SR || input.disabled) return;
    const base = input.value.trim() ? input.value.trimEnd() + ' ' : '';
    rec = new SR();
    rec.lang = 'en-AU';
    rec.interimResults = true;
    rec.continuous = true;
    rec.onresult = (e: any) => {
      let text = '';
      for (let i = 0; i < e.results.length; i++) text += e.results[i][0].transcript;
      input.value = base + text.trimStart();
      autosize();
    };
    rec.onerror = (e: any) => {
      if (e.error === 'not-allowed' || e.error === 'service-not-allowed') note("The browser didn't allow the microphone. You can type instead, or allow it in the address bar and try again.");
    };
    rec.onend = () => {
      rec = null;
      stopMeter();
      micBtn.setAttribute('aria-pressed', 'false');
      micBtn.setAttribute('aria-label', 'Speak your answer');
      micBtn.dataset.tip = 'Speak your answer';
      input.placeholder = 'Type your answer…';
      input.focus({ preventScroll: true });
    };
    try {
      rec.start();
      micBtn.setAttribute('aria-pressed', 'true');
      micBtn.setAttribute('aria-label', 'Stop listening');
      micBtn.dataset.tip = 'Stop listening';
      input.placeholder = 'Listening… tap the mic when you’re done';
      startMeter();
    } catch {
      rec = null;
    }
  }
  micBtn.addEventListener('click', () => (rec ? stopListening() : startListening()));

  // ---------- Sharing: files, links, screen recordings ----------
  function openTray(open: boolean) {
    tray.hidden = !open;
    attachBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (!open) linkForm.hidden = true;
  }
  function showLinkField() {
    linkForm.hidden = false;
    linkInput.focus({ preventScroll: true });
  }
  attachBtn.addEventListener('click', () => openTray(tray.hidden));
  $<HTMLButtonElement>('ik-menu-link').addEventListener('click', showLinkField);
  document.addEventListener('pointerdown', (e) => {
    if (!tray.hidden && !tray.contains(e.target as Node) && !attachBtn.contains(e.target as Node)) openTray(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !tray.hidden) { openTray(false); attachBtn.focus(); }
  });

  const fmtSize = (b: number) => (b < 1024 * 1024 ? `${Math.max(1, Math.round(b / 1024))} KB` : `${(b / 1024 / 1024).toFixed(1)} MB`);
  const totalBytes = () => files.reduce((sum, f) => sum + f.size, 0);
  const CHIP_ICON = { file: document.querySelector('#ik-tray label svg')!.outerHTML, link: document.querySelector('#ik-menu-link svg')!.outerHTML, rec: document.querySelector('#ik-rec svg')!.outerHTML };

  function renderChips() {
    chips.textContent = '';
    const chip = (icon: string, label: string, onRemove: () => void) => {
      const c = el('span', 'ik-chip');
      c.innerHTML = icon.replace(/width="\d+" height="\d+"/, 'width="14" height="14"');
      const x = el('button', '', '×') as HTMLButtonElement;
      x.type = 'button';
      x.setAttribute('aria-label', `Remove ${label}`);
      x.addEventListener('click', onRemove);
      c.append(el('span', '', label), x);
      chips.append(c);
    };
    files.forEach((f, i) => chip(CHIP_ICON.file, `${f.name} · ${fmtSize(f.size)}`, () => { files.splice(i, 1); renderChips(); }));
    links.forEach((l, i) => chip(l.startsWith('Screen recording') ? CHIP_ICON.rec : CHIP_ICON.link, linkLabel(l), () => { links.splice(i, 1); save(); renderChips(); }));
    renderFolder();
  }

  fileInput.addEventListener('change', () => {
    for (const f of Array.from(fileInput.files || [])) {
      if (BLOCKED_FILE.test(f.name)) {
        note(`${f.name} is a program or script file, so we can't take it. Screenshots, PDFs, documents and spreadsheets are all fine.`, undefined, undefined, true);
        continue;
      }
      if (files.length >= 20) {
        note(`${f.name}: that's 20 files already. For more, put them in a shared folder and paste the link.`, undefined, undefined, true);
        continue;
      }
      if (totalBytes() + f.size > MAX_UPLOAD_BYTES) {
        note(`${f.name}: ${TOO_BIG}`, undefined, undefined, true);
        continue;
      }
      files.push(f);
      fileMsg(`${f.name} · ${fmtSize(f.size)}`);
      noteExample(f.name);
    }
    fileInput.value = '';
    openTray(false);
    renderChips();
  });

  /** "loom.com/share/x" -> "https://loom.com/share/x", so the Jotform link field gets a real URL. */
  function normaliseLink(v: string) {
    // Web links only (http or https). Anything else, like plain text or a javascript: link, isn't kept as a link.
    const t = v.trim().slice(0, 2000);
    if (/^https?:\/\/[^\s/$.?#][^\s]*$/i.test(t)) return t;
    if (/^[\w-]+(\.[\w-]+)+([/?#:]\S*)?$/.test(t)) return `https://${t}`;
    return '';
  }
  const linkLabel = (l: string) => (l.startsWith('Screen recording') ? l.split(': ')[0] : l.replace(/^https?:\/\//, ''));
  function addLink(raw: string, label?: string) {
    const v = normaliseLink(raw);
    if (!v || links.includes(v)) return false;
    links.push(v);
    fileMsg(label ?? v);
    noteExample(v);
    save();
    renderChips();
    return true;
  }
  linkForm.addEventListener('submit', (e) => {
    e.preventDefault();
    if (addLink(linkInput.value)) { linkInput.value = ''; openTray(false); return; }
    const raw = linkInput.value.trim();
    if (!raw) return;
    openTray(false);
    note(links.includes(normaliseLink(raw)) ? "You've already added that link." : "That doesn't look like a web link. Paste the full address from your browser, starting with https://");
  });

  // ---------- Screen recording (getDisplayMedia -> MediaRecorder -> private Supabase bucket) ----------
  const canRecord = !!navigator.mediaDevices?.getDisplayMedia && typeof MediaRecorder !== 'undefined';
  if (canRecord) { recBtn.hidden = false; recQuick.hidden = false; }
  let recBusy = false;
  let stopRecording: ((why?: 'time' | 'size') => void) | null = null;
  const fmtDur = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  const MAX_LABEL = fmtDur(RECORDING.maxSeconds);

  function showRecBar(label: string, pct: number, uploading = false) {
    recBar.hidden = false;
    recBar.toggleAttribute('data-uploading', uploading);
    recLabel.textContent = label;
    recMeter.style.width = `${Math.min(100, Math.round(pct * 100))}%`;
  }

  async function startRecording() {
    if (recBusy) return;
    recBusy = true; // set before the browser's picker opens, so a second click can't open another
    openTray(false);
    let display: MediaStream;
    try {
      display = await navigator.mediaDevices.getDisplayMedia({ video: { frameRate: { ideal: 15, max: 24 } }, audio: true });
    } catch (err) {
      recBusy = false;
      const name = err instanceof DOMException ? err.name : '';
      note(name === 'NotAllowedError'
        ? "Screen sharing was cancelled or blocked. No problem: try again and pick a screen or window, or paste a Loom link instead."
        : "Screen sharing didn't start in this browser. You can try again, or paste a Loom link instead.");
      return;
    }
    // Narration from the mic if allowed; system/tab audio if the browser shared it. Mix both when there are two.
    let mic: MediaStream | null = null;
    try { mic = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true } }); } catch {}
    const tracks: MediaStreamTrack[] = [...display.getVideoTracks()];
    const audioIn = [display, mic].filter((s): s is MediaStream => !!s && s.getAudioTracks().length > 0);
    let ctx: AudioContext | null = null;
    if (audioIn.length === 1) tracks.push(audioIn[0].getAudioTracks()[0]);
    else if (audioIn.length > 1) {
      ctx = new AudioContext();
      const dest = ctx.createMediaStreamDestination();
      for (const s of audioIn) ctx.createMediaStreamSource(s).connect(dest);
      tracks.push(dest.stream.getAudioTracks()[0]);
    }
    const mime = ['video/webm;codecs=vp9,opus', 'video/webm;codecs=vp8,opus', 'video/webm', 'video/mp4'].find((t) => MediaRecorder.isTypeSupported(t)) || '';
    let mr: MediaRecorder;
    try {
      mr = new MediaRecorder(new MediaStream(tracks), { ...(mime ? { mimeType: mime } : {}), videoBitsPerSecond: RECORDING.videoBitsPerSecond, audioBitsPerSecond: 64_000 });
    } catch {
      [display, mic].forEach((s) => s?.getTracks().forEach((t) => t.stop()));
      recBusy = false;
      note("This browser can't record the screen. Please paste a Loom link instead.");
      return;
    }
    const chunks: Blob[] = [];
    let bytes = 0;
    let stoppedBy: 'time' | 'size' | undefined;
    const started = Date.now();
    const elapsed = () => (Date.now() - started) / 1000;
    stopRecording = (why) => {
      stoppedBy ??= why;
      if (mr.state !== 'inactive') mr.stop();
    };
    mr.ondataavailable = (e) => {
      if (!e.data.size) return;
      chunks.push(e.data);
      bytes += e.data.size;
      if (bytes >= RECORDING.stopAtBytes) stopRecording?.('size');
    };
    const tick = window.setInterval(() => {
      const s = elapsed();
      showRecBar(`Recording ${fmtDur(s)} / ${MAX_LABEL}`, Math.max(s / RECORDING.maxSeconds, bytes / RECORDING.stopAtBytes));
      if (s >= RECORDING.maxSeconds) stopRecording?.('time');
    }, 500);
    display.getVideoTracks()[0]?.addEventListener('ended', () => stopRecording?.());
    mr.onstop = async () => {
      clearInterval(tick);
      stopRecording = null;
      [display, mic].forEach((s) => s?.getTracks().forEach((t) => t.stop()));
      ctx?.close().catch(() => {});
      const seconds = elapsed();
      const blob = new Blob(chunks, { type: (mr.mimeType || mime || 'video/webm').split(';')[0] });
      if (stoppedBy === 'time') note(`That's ${MAX_LABEL}, so the recording stopped there. Shorter is better; for anything longer, paste a Loom link.`);
      if (stoppedBy === 'size') note('The recording reached the size limit, so it stopped there. For anything longer, paste a Loom link.');
      try {
        await uploadRecording(blob, seconds);
      } catch (err) {
        note(err instanceof Error && err.message && !(err instanceof TypeError) ? err.message : "The recording couldn't be saved. Check your internet connection and try again, or paste a Loom link instead.", undefined, undefined, true);
      } finally {
        recBar.hidden = true;
        recBusy = false;
      }
    };
    mr.start(1000);
    showRecBar(`Recording 0:00 / ${MAX_LABEL}`, 0);
    recStop.focus({ preventScroll: true });
  }

  async function postRecording(body: object) {
    const r = await fetch('/api/intake-recording', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const d = await r.json().catch(() => null);
    if (!r.ok || !d?.ok) throw new Error(d?.error || "The recording couldn't be saved. Please try again, or paste a Loom link instead.");
    return d;
  }

  function putFile(url: string, blob: Blob, onProgress: (p: number) => void) {
    return new Promise<void>((resolve, reject) => {
      const x = new XMLHttpRequest();
      x.open('PUT', url);
      x.setRequestHeader('content-type', blob.type);
      x.upload.onprogress = (e) => { if (e.lengthComputable) onProgress(e.loaded / e.total); };
      x.onload = () => (x.status >= 200 && x.status < 300 ? resolve() : reject(new Error("The recording didn't upload. Please try again, or paste a Loom link instead.")));
      x.onerror = () => reject(new Error("The recording didn't upload. Check your connection and try again, or paste a Loom link instead."));
      x.send(blob);
    });
  }

  async function uploadRecording(blob: Blob, seconds: number) {
    if (!blob.size) throw new Error('That recording came out empty. Please try again, or paste a Loom link instead.');
    if (blob.size > RECORDING.maxBytes) throw new Error(`That recording is ${fmtSize(blob.size)}, over the 50MB limit. Please record a shorter one, or paste a Loom link instead.`);
    showRecBar('Uploading recording… 0%', 0, true);
    const started = await postRecording({ action: 'start', contentType: blob.type, size: blob.size, client });
    await putFile(started.uploadUrl, blob, (p) => showRecBar(`Uploading recording… ${Math.round(p * 100)}%`, p, true));
    const done = await postRecording({ action: 'finish', path: started.path });
    const label = `Screen recording, ${fmtDur(seconds)}`;
    links.push(`${label}: ${done.url} (stored at ${done.path})`);
    fileMsg(`${label} · ${fmtSize(blob.size)}`);
    noteExample(label);
    save();
    renderChips();
  }

  recBtn.addEventListener('click', () => startRecording());
  recQuick.addEventListener('click', () => startRecording());
  recStop.addEventListener('click', () => stopRecording?.());

  // ---------- Submit ----------
  async function sendAll() {
    if (sending || sent) return;
    stopListening();
    if (recBusy) {
      note('Hang on, your screen recording is still going. Stop it (or wait for the upload to finish), then send again.');
      return;
    }
    // A link typed into the box but never added still counts.
    if (linkInput.value.trim() && addLink(linkInput.value)) linkInput.value = '';
    if (totalBytes() > MAX_UPLOAD_BYTES) { note(TOO_BIG, undefined, undefined, true); return; }
    if (!hasAnything() && !files.length && !links.length) {
      note("There's nothing to send yet. Answer a question or two first, or share a file or link.");
      return;
    }
    const data = new FormData();
    // Only questions that were offered: answered as typed, or "to fill" if skipped.
    for (const [qid, v] of payloadFields()) data.set(String(qid), v);
    if (links.length) data.set(String(CLOSING.link), links.join(' | '));
    for (const f of files) data.append(String(CLOSING.files), f, f.name);
    data.set(String(CLOSING.employee), employee);
    data.set(String(CLOSING.client), client);

    sending = true;
    lock(true);
    const sendAllBtn = document.getElementById('ik-send-all') as HTMLButtonElement | null;
    const label = sendAllBtn?.innerHTML;
    if (sendAllBtn) { sendAllBtn.disabled = true; sendAllBtn.innerHTML = '<span class="ik-spin" aria-hidden="true"></span>Sending…'; }
    const sendingNote = sendAllBtn ? null : note('Sending your answers…');
    try {
      const r = await fetch('/api/intake-submit', { method: 'POST', body: data });
      const d = await r.json().catch(() => null);
      if (r.status === 413) throw new Error(TOO_BIG);
      if (!r.ok || !d?.ok) throw new Error(d?.error || "That didn't send. Please try again.");
      sent = true;
      clear();
      openTray(false);
      updateProgress();
      finish();
    } catch (err) {
      sendingNote?.remove();
      if (sendAllBtn) { sendAllBtn.disabled = false; sendAllBtn.innerHTML = label ?? 'Send everything'; }
      // A TypeError here is the browser's own network failure text ("Failed to fetch"): say it in plain words.
      const msg = err instanceof TypeError ? "We couldn't reach our server. Check your internet connection, then try again." : err instanceof Error && err.message ? err.message : "That didn't send. Please try again.";
      note(`${msg} Nothing is lost: your answers are still saved here.`, 'Try again', () => sendAll(), true);
      if (answerable(steps[pos])) lock(false);
    } finally {
      sending = false;
    }
  }
  sendNow.addEventListener('click', () => {
    if (confirm("Send your answers so far? Anything you haven't reached yet will be left out.")) sendAll();
  });

  // ---------- Finish ----------
  function finish() {
    stopListening();
    const { answered, skipped } = tally();
    const recs = links.filter((l) => l.startsWith('Screen recording')).length;
    const plainLinks = links.length - recs;
    const tick = '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
    const list = $<HTMLUListElement>('ik-captured');
    list.textContent = '';
    const item = (main: string, sub?: string) => {
      const li = el('li', '');
      li.innerHTML = tick;
      const t = el('span', '', main);
      if (sub) t.append(' ', el('small', '', sub));
      li.append(t);
      list.append(li);
    };
    const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : /s$/.test(w) ? 'es' : 's'}`;
    item(`${plural(answered, 'answer')} received`, skipped ? `· ${skipped} to fill, we'll cover ${skipped === 1 ? 'it' : 'them'} on the call` : undefined);
    const mapped = procs.flat().filter((p) => p && !p.skipped);
    if (mapped.length) item(`${plural(mapped.length, 'job')} walked through`, `· ${listJoin(mapped.map((p) => p.name))}`);
    const shared = [files.length && plural(files.length, 'file'), plainLinks && plural(plainLinks, 'link'), recs && plural(recs, 'screen recording')].filter(Boolean) as string[];
    if (shared.length) item(`${listJoin(shared)} shared`);
    item('Saved to Roadmap Labs', `· ${new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`);
    if (client) $<HTMLElement>('ik-finish-title').textContent = `That's everything, ${client}. Thank you.`;
    root.dataset.view = 'finish';
    anchor();
    $<HTMLElement>('ik-finish').focus({ preventScroll: true });
  }
  $<HTMLButtonElement>('ik-download').addEventListener('click', () => {
    const lines = [`Roadmap Labs intake${client ? ` · ${client}` : ''}`, new Date().toLocaleString(), ...(roleTag() ? [`Answered as: ${roleTag()}${respondent() ? ` (${respondent()})` : ''}`] : []), ''];
    for (const [qid, v] of payloadFields()) lines.push(textByQid.get(qid) ?? `Question ${qid}`, v === SKIPPED ? '(to fill)' : v, '');
    if (links.length) lines.push('Links shared', ...links, '');
    if (files.length) lines.push('Files shared', ...files.map((f) => f.name), '');
    const url = URL.createObjectURL(new Blob([lines.join('\n')], { type: 'text/plain' }));
    const a = Object.assign(document.createElement('a'), { href: url, download: 'roadmap-labs-intake-answers.txt' });
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });

  // ---------- Modes ----------
  let widgetLoaded = false;
  function setMode(m: Mode, persist = true) {
    mode = m;
    root.dataset.mode = m;
    // Collapsed in chat mode: inert, so its buttons can't take keyboard focus while they're invisible.
    const voicePanel = $<HTMLElement>('ik-voice');
    voicePanel.setAttribute('aria-hidden', String(m !== 'voice'));
    voicePanel.inert = m !== 'voice';
    root.querySelectorAll<HTMLButtonElement>('.ik-modes button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));
    if (m === 'voice') {
      stopListening();
      loadWidget();
    }
    if (persist) save();
    setTimeout(scroll, 560);
  }
  root.querySelectorAll<HTMLButtonElement>('.ik-modes button').forEach((b) =>
    b.addEventListener('click', () => {
      if (root.dataset.view === 'welcome') startFlow(b.dataset.mode as Mode);
      else setMode(b.dataset.mode as Mode);
    }),
  );
  document.getElementById('ik-voice-fallback')?.addEventListener('click', () => {
    setMode('chat');
    setTimeout(startListening, 400);
  });

  // ---------- Voice interview (ElevenLabs ConvAI widget) ----------
  // The agent runs the same script through client tools, so voice and chat share one thread and one state.
  // Agent setup (prompt + tool definitions) is in docs/intake-voice-agent.md.
  function loadWidget() {
    if (widgetLoaded || !agentId) return;
    widgetLoaded = true;
    const host = $<HTMLDivElement>('ik-widget');
    const w = document.createElement('elevenlabs-convai');
    w.setAttribute('agent-id', agentId);
    w.setAttribute('placement', 'bottom');
    w.setAttribute('transcript', 'false');
    w.setAttribute('text-input', 'false');
    w.setAttribute('show-avatar-when-collapsed', 'false');
    w.setAttribute('avatar-orb-color-1', '#0a4cff');
    w.setAttribute('avatar-orb-color-2', '#00a3ff');
    w.setAttribute('text-contents', JSON.stringify({ main_label: 'Talk it through with Harry', start_call: 'Start voice interview', end_call: 'End interview' }));
    host.append(w);
    const s = document.createElement('script');
    // Pinned: an unpinned URL would run whatever ElevenLabs publishes next, with full access to this page. Bump on purpose.
    s.src = 'https://unpkg.com/@elevenlabs/convai-widget-embed@0.25.2/dist/index.js';
    s.async = true;
    s.onerror = () => {
      const st = document.getElementById('ik-voice-status');
      if (st) st.textContent = "Voice couldn't load. Chat works the same";
    };
    document.head.append(s);
  }

  // The voice agent works through the same spine via these tool replies. It may roam inside the current stage
  // (record_answer with a question_id); the page keeps the fixed order and never asks an answered question again.
  function openInStage(): string {
    const s = steps[pos];
    if (s?.type === 'q' && s.phase === 'core') {
      const open = CORE_QUESTIONS.filter((q) => q.stage === s.stage && q.id !== s.id && !answers.has(q.qid) && !pending.has(`q:${q.id}`));
      return open.length ? ` Still open in ${CORE_STAGES[s.stage!].title}: ${open.map((q) => `${q.id} "${q.text}"`).join('; ')}.` : '';
    }
    if (s?.type === 'drill') {
      const open = DRILL.filter((d, i) => i > s.d && !pending.has(`d:${s.j}:${s.p}:${i}`));
      return open.length ? ` Still open for this workflow: ${open.map((d) => `${d.id} "${d.text}"`).join('; ')}.` : '';
    }
    return '';
  }
  const ROAM = ' If they answer one of the still-open questions on the way, call record_answer with its question_id; it will not be asked again.';
  function stepPrompt(): string {
    const s = steps[pos];
    if (sent) return 'The interview has been submitted. Thank them and end the call.';
    if (!s) return 'The interview is finished.';
    switch (s.type) {
      case 'role':
      case 'role2':
        return `Before the questions: ask exactly "${stepText(s)}" Then call record_answer with their words. Their role only changes which questions are asked.`;
      case 'q':
        return s.phase === 'closing'
          ? `Closing question (W1). Ask exactly: "${s.text}" Then call record_answer.`
          : `Stage ${s.stage}, ${CORE_STAGES[s.stage!].title}, question ${s.id}. Ask exactly: "${s.text}" Then call record_answer with their words.${openInStage()}${openInStage() ? ROAM : ''}`;
      case 'list':
        return `Stage 3, how the work flows: ${JOURNEY[s.j].label} (${JOURNEY[s.j].id}). Ask exactly: "${JOURNEY[s.j].text}" Then call record_answer with what they name, one per line.`;
      case 'name':
        return `${JOURNEY[s.j].label}. Ask: "${s.prompt}"${s.options.length ? ` They mentioned: ${s.options.join('; ')}.` : ''} Then call record_answer with the workflow name, in their words.`;
      case 'drill': {
        const pr = procs[s.j][s.p];
        const extra =
          s.d === 3 ? ' They can attach a file, paste text or a link, or record their screen on the page.'
          : s.d === 4 ? ' Offer three answers: hand it over, split it, or keep it with a person. Ask why.'
          : s.d === 8 ? ' Keep it light: one short answer is enough. It tells AI when the job should start.'
          : s.d === 0 ? ' This becomes the written instructions for the job. Reflect their tool and step names back.'
          : s.d === 7 ? ` Help them reach an hourly figure: who does it, hours per week, and their hourly cost or annual pay. As a rough benchmark, annual pay divided by about ${BENCHMARK.hoursPerYear} hours is an hourly cost. Use only their figures and say it is a rough benchmark. Never invent numbers.`
          : '';
        return `${JOURNEY[s.j].label}, job "${pr.name}", ${DRILL[s.d].id} (${s.d + 1} of ${DRILL.length}). Ask exactly: "${DRILL[s.d].text}"${extra} Then call record_answer.${openInStage()}${openInStage() ? ROAM : ''}`;
      }
      case 'another':
        return `"${procs[s.j][s.p].name}" is done. Ask: "${anotherText(s.j)}"${s.next ? ` They also mentioned "${s.next}".` : ''} If yes, call choose_path with path "another" and the workflow name; if no, call choose_path with path "next_stage".`;
      case 'gchoice':
        return `The journey is done. Say: "${GROWTH_OFFER.text}" Then call choose_path with path "growth" to answer them, or "skip_growth" to go to the last question.`;
      case 'growth': {
        const q = GROWTH_QUESTIONS[s.g];
        return `Optional growth question ${q.id} (${s.g + 1} of ${GROWTH_QUESTIONS.length}, about 5 minutes in all). Ask exactly: "${q.text}" Then call record_answer, or skip_question if they'd rather not. If they want to skip all the remaining growth questions, call choose_path with path "skip_growth".`;
      }
      case 'tq':
        return s.b === 'opening'
          ? `Before anything else, check what we already know. Say exactly: "${stepText(s)}" Then call record_answer with their reply.`
          : `Tailored question ${tqId(s)} (${STAGE_LABEL[s.b]}). Ask exactly: "${stepText(s)}" Then call record_answer with their words.`;
      case 'choice':
        return `The core (stages 0 to 2) is done. Say: "${CHOICE_TEXT}" Then call choose_path with path "keep_going" or "wrap_up".`;
      default:
        return 'All the questions are done. Tell them they can add files, links or a screen recording on the screen, then press Send everything. Thank them and end the call.';
    }
  }
  /** Map a spine id the agent passed (A3, T5, D6...) to a still-open question in the current stage or process. */
  function roamKey(id: string): string | null {
    const s = steps[pos];
    if (s?.type === 'q' && s.phase === 'core') {
      const q = CORE_QUESTIONS.find((x) => x.id === id && x.stage === s.stage && !answers.has(x.qid));
      return q ? `q:${q.id}` : null;
    }
    if (s?.type === 'drill') {
      const i = DRILL.findIndex((d) => d.id === id);
      return i > s.d ? `d:${s.j}:${s.p}:${i}` : null;
    }
    return null;
  }
  const currentId = (s?: Step) => (s?.type === 'q' ? s.id : s?.type === 'list' ? JOURNEY[s.j].id : s?.type === 'drill' ? DRILL[s.d].id : s?.type === 'growth' ? GROWTH_QUESTIONS[s.g].id : s?.type === 'tq' ? tqId(s) : '');

  /** Rough loudness of a base64 audio chunk from the agent (16-bit PCM); any chunk still counts as speech. */
  function chunkLevel(b64: unknown) {
    if (typeof b64 !== 'string') return 0.5;
    try {
      const bin = atob(b64.length > 6000 ? b64.slice(0, 6000) : b64);
      const n = bin.length >> 1;
      let sum = 0;
      for (let i = 0; i < n; i++) { let v = bin.charCodeAt(2 * i) | (bin.charCodeAt(2 * i + 1) << 8); if (v > 32767) v -= 65536; sum += v * v; }
      return Math.max(0.25, Math.min(1, Math.sqrt(sum / Math.max(1, n)) / 6000));
    } catch { return 0.5; }
  }

  document.addEventListener('elevenlabs-convai:call', (event: any) => {
    const config = event?.detail?.config;
    if (!config) return;
    config.clientTools = {
      ...(config.clientTools || {}),
      get_current_question: () => stepPrompt(),
      record_answer: (p: { answer?: string; question_id?: string }) => {
        const v = String(p?.answer ?? '').trim();
        const id = String(p?.question_id ?? '').trim().toUpperCase();
        if (id && id !== currentId(steps[pos])) {
          const k = roamKey(id);
          if (!k) return `${id} isn't open in this stage. ${stepPrompt()}`;
          act({ t: 'p', k, v: v || SKIPPED, s: 1 });
          return `Saved for ${id}; it won't be asked again. ${stepPrompt()}`;
        }
        if (!answerable(steps[pos])) return `No question is waiting. ${stepPrompt()}`;
        act({ t: 'a', v: v || SKIPPED, s: 1 });
        return `Saved. Next: ${stepPrompt()}`;
      },
      skip_question: () => {
        if (!answerable(steps[pos])) return `No question is waiting. ${stepPrompt()}`;
        act({ t: 'a', v: SKIPPED, s: 1 });
        return `Skipped (to fill). Next: ${stepPrompt()}`;
      },
      choose_path: (p: { path?: string; name?: string }) => {
        const s = steps[pos];
        const path = String(p?.path ?? '');
        if (s?.type === 'gchoice') {
          root.querySelectorAll('.ik-choices').forEach((c) => c.remove());
          act({ t: 'c', v: /skip|\bno\b|wrap|finish|last|done/i.test(path) ? 'nogrowth' : 'growth' });
          return `Done. Next: ${stepPrompt()}`;
        }
        if (s?.type === 'growth' && /skip|\bno\b|finish|done|stop|move/i.test(path)) {
          act({ t: 'c', v: 'growth:skip' });
          return `Done. Next: ${stepPrompt()}`;
        }
        if (s?.type === 'choice') {
          root.querySelectorAll('.ik-choices').forEach((c) => c.remove());
          act({ t: 'c', v: /keep|more|journey|continue/i.test(path) ? 'more' : 'wrap' });
          return `Done. Next: ${stepPrompt()}`;
        }
        if (s?.type === 'another') {
          const name = String(p?.name ?? '').trim();
          const v = /next_stage|done|\bno\b|move|finish|stop/i.test(path) ? 'done' : name ? `next:${short(name)}` : s.next ? `next:${s.next}` : 'another';
          act({ t: 'c', v });
          return `Done. Next: ${stepPrompt()}`;
        }
        return `There's no choice to make right now. ${stepPrompt()}`;
      },
    };
    const status = document.getElementById('ik-voice-status');
    if (status) status.textContent = 'Connecting…';
    const onConnect = config.onConnect;
    config.onConnect = (...args: unknown[]) => {
      if (status) { status.textContent = 'Live with Harry'; status.setAttribute('data-live', ''); }
      onConnect?.(...args);
    };
    const onAudio = config.onAudio;
    config.onAudio = (...args: unknown[]) => {
      bump(chunkLevel(args[0]));
      onAudio?.(...args);
    };
  });

  // ---------- Start ----------
  function showToast(text: string, action?: string, onClick?: () => void) {
    toast.textContent = text;
    if (action && onClick) {
      const b = el('button', '', action) as HTMLButtonElement;
      b.type = 'button';
      b.addEventListener('click', onClick);
      toast.append(b);
    }
    toast.hidden = false;
    setTimeout(() => { toast.hidden = true; }, 9000);
  }

  let begun = false;
  /** The first steps of a new interview: the opening check when there's a brief, then the role question. */
  function firstSteps() {
    if (brief) steps.push({ type: 'tq', b: 'opening', i: 0 });
    steps.push({ type: 'role', mode: 'first' });
  }
  async function begin() {
    if (begun) return;
    begun = true;
    root.dataset.view = 'chat';
    if (!actions.length && !steps.length) { flow2 = true; growthOn = true; firstSteps(); }
    updateProgress();
    const hiName = greetName || client;
    if (brief) {
      await harrySays(`Hi${hiName ? ` ${hiName}` : ''}, I'm Harry. Answer in your own words, short or long; there are no wrong answers.`);
      await harrySays(`I've done some homework on ${brief.businessName}, so I'll skip what we already know and ask about the work that eats your time. We turn your answers into plain written instructions, so AI can work the way your business really runs. First, a quick check.`);
      enqueue(() => present());
      return;
    }
    await harrySays(`Hi${hiName ? ` ${hiName}` : ''}, I'm Harry. Answer in your own words, short or long; there are no wrong answers. First, a quick one about your role, so the questions fit.`);
    await harrySays("I'll ask about your business, how the work gets done, and the jobs that take up your time. We turn your answers into plain written instructions, like a handbook for a new staff member. That way AI can work the way your business really runs, instead of guessing.");
    enqueue(() => present());
  }
  // ---------- Opening walkthrough: fresh sessions only, after the welcome and before question one ----------
  // A session with saved answers never sees it on load (it resumes as before); anyone can replay it from the folder panel.
  const tour = $<HTMLElement>('ik-tour');
  // Content comes from src/data/intake-intro.ts, one set per audience. Owner is the default and today the only set;
  // ?intro=<audience> picks another once one exists (an unknown value keeps the owner set).
  const tourSets = [...tour.querySelectorAll<HTMLElement>('.ik-tour__set')];
  const wanted = new URLSearchParams(location.search).get('intro');
  const tourSet = tourSets.find((t) => t.dataset.audience === wanted) ?? tourSets.find((t) => !t.hidden) ?? tourSets[0];
  tourSets.forEach((t) => (t.hidden = t !== tourSet));
  const beats = [...tourSet.querySelectorAll<HTMLElement>('.ik-beat')];
  if (!canRecord) tour.querySelectorAll<HTMLElement>('[data-norec]').forEach((n) => (n.hidden = false));
  const dots = $<HTMLElement>('ik-tour-dots');
  const nextBtn = $<HTMLButtonElement>('ik-tour-next');
  const skip2 = $<HTMLButtonElement>('ik-tour-skip2');
  let beat = 0;
  let tourDone: (() => void) | null = null;
  let viewBeforeTour = 'chat';
  beats.forEach((_, i) => {
    const d = el('button', '') as HTMLButtonElement;
    d.type = 'button';
    d.setAttribute('aria-label', `Step ${i + 1} of ${beats.length}`);
    d.addEventListener('click', () => showBeat(i));
    dots.append(d);
  });
  function showBeat(i: number) {
    beat = Math.max(0, Math.min(beats.length - 1, i));
    beats.forEach((b, k) => b.classList.toggle('is-on', k === beat));
    [...dots.children].forEach((d, k) => (k === beat ? d.setAttribute('aria-current', 'step') : d.removeAttribute('aria-current')));
    const last = beat === beats.length - 1;
    nextBtn.textContent = last ? 'Start' : 'Next';
    skip2.hidden = !last;
    tour.scrollTop = 0;
  }
  function openTour(after: () => void) {
    viewBeforeTour = root.dataset.view || 'chat';
    tourDone = after;
    root.dataset.view = 'tour';
    showBeat(0);
    nextBtn.focus({ preventScroll: true });
  }
  function closeTour() {
    if (root.dataset.view !== 'tour') return;
    root.dataset.view = viewBeforeTour === 'welcome' ? 'chat' : viewBeforeTour;
    const done = tourDone;
    tourDone = null;
    done?.();
  }
  nextBtn.addEventListener('click', () => (beat < beats.length - 1 ? showBeat(beat + 1) : closeTour()));
  $<HTMLButtonElement>('ik-tour-skip').addEventListener('click', closeTour);
  skip2.addEventListener('click', closeTour);
  document.addEventListener('keydown', (e) => {
    if (root.dataset.view !== 'tour') return;
    if (e.key === 'ArrowRight') showBeat(beat + 1);
    else if (e.key === 'ArrowLeft') showBeat(beat - 1);
    else if (e.key === 'Escape') closeTour();
  });
  $<HTMLButtonElement>('ik-tour-replay').addEventListener('click', () => {
    openPanel(false);
    openTour(() => { updateProgress(); scroll(); });
  });
  /** Start from the welcome: the walkthrough first for a fresh session, then the interview. */
  function startFlow(m: Mode) {
    setMode(m);
    if (begun) return;
    if (actions.length) { begin(); return; }
    openTour(() => begin());
  }
  $<HTMLButtonElement>('ik-start-chat').addEventListener('click', () => startFlow('chat'));
  $<HTMLButtonElement>('ik-start-voice').addEventListener('click', () => startFlow('voice'));

  // ---------- Preview mock: sign-in screen (?mock=login) ----------
  // Visual only, for Dan to react to. It never gates the real page, checks nothing and stores nothing:
  // the password field is cleared on submit and its value is never read. Real authentication isn't decided yet.
  let greetName = '';
  function showMockLogin() {
    const mock = $<HTMLDivElement>('ik-mock');
    const form = $<HTMLFormElement>('ik-mock-form');
    const nameEl = $<HTMLInputElement>('ik-mock-name');
    const pass = $<HTMLInputElement>('ik-mock-pass');
    mock.hidden = false;
    setTimeout(() => nameEl.focus({ preventScroll: true }), 300);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      pass.value = '';
      const name = nameEl.value.trim().slice(0, 40);
      nameEl.value = '';
      greetName = name;
      $<HTMLElement>('ik-mock-form-step').hidden = true;
      $<HTMLElement>('ik-mock-hello-text').textContent = name ? `Welcome, ${name}` : 'Welcome';
      $<HTMLElement>('ik-mock-hello').hidden = false;
      setTimeout(() => {
        mock.hidden = true;
        if (root.dataset.view === 'welcome') startFlow('chat');
      }, reduced ? 300 : 1600);
    });
  }

  /** /intake?brief=<token>: fetch the client-safe brief from the server. Any problem: the standard interview. */
  async function loadBrief(): Promise<'none' | 'ok' | 'failed'> {
    const token = params.get('brief');
    if (!token) return 'none';
    try {
      const r = await fetch('/api/intake-brief', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token: token.slice(0, 100) }) });
      const d = await r.json().catch(() => null);
      if (!r.ok || !d?.ok || !d.brief) return 'failed';
      applyBrief(d.brief as PublicBrief);
      return 'ok';
    } catch {
      return 'failed';
    }
  }
  function applyBrief(b: PublicBrief) {
    brief = b;
    DRILL = [...DRILL_BASE, ...DRILL_BRIEF];
    STORE = `rl-intake-v3:brief:${b.slug}`;
    // Their colour (already checked on the server for contrast with white text), and their name and logo.
    if (b.accent && /^#[0-9a-f]{6}$/i.test(b.accent)) {
      const [r, g, bl] = [1, 3, 5].map((i) => parseInt(b.accent!.slice(i, i + 2), 16));
      root.dataset.brand = '';
      root.style.setProperty('--roadmap-blue', b.accent);
      root.style.setProperty('--tint', `rgba(${r},${g},${bl},.07)`);
      root.style.setProperty('--tint-2', `rgba(${r},${g},${bl},.14)`);
      root.style.setProperty('--gradient-signal', `linear-gradient(90deg, ${b.accent}, ${b.accent})`);
    }
    $<HTMLElement>('ik-brand-name').textContent = b.businessName;
    $<HTMLElement>('ik-brandline').hidden = false;
    if (b.logoUrl) for (const id of ['ik-brand-logo', 'ik-id-logo']) {
      const img = $<HTMLImageElement>(id);
      img.alt = id === 'ik-id-logo' ? `${b.businessName} logo` : '';
      img.addEventListener('error', () => { img.hidden = true; }, { once: true });
      img.src = b.logoUrl;
      img.hidden = false;
    }
    const hello = $<HTMLElement>('ik-hello');
    hello.textContent = `Let's map how ${b.businessName} `;
    hello.append(el('span', '', 'really runs.'));
    // Your notes: what we already know, and the questions that won't be asked.
    const list = $<HTMLUListElement>('ik-known-list');
    list.textContent = '';
    for (const k of b.known) list.append(el('li', '', k));
    const skipped = b.skip.map((id) => SKIPPABLE.get(id)).filter((t): t is string => !!t);
    $<HTMLElement>('ik-known-skip').textContent = skipped.length ? `So I won't ask about ${listJoin(skipped)}.` : '';
    $<HTMLElement>('ik-known').hidden = !b.known.length && !skipped.length;
  }

  async function start() {
    lock(true);
    if (params.get('brief')) {
      // Hold the start buttons until the brief has loaded, so the interview starts the right way.
      const startBtns = [$<HTMLButtonElement>('ik-start-chat'), $<HTMLButtonElement>('ik-start-voice')];
      startBtns.forEach((b) => (b.disabled = true));
      const got = await loadBrief();
      startBtns.forEach((b) => (b.disabled = false));
      if (got === 'failed') showToast("That link didn't open a prepared interview, so this is the standard one. You can still go ahead, or check the link with Roadmap Labs.");
    }
    if (client && !brief) $<HTMLElement>('ik-hello').innerHTML = `Hi ${client.replace(/[<>&"]/g, '')}. Let's map how your business <span>really runs.</span>`;
    const saved = load();
    links = Array.isArray(saved.links) ? saved.links.filter((l) => typeof l === 'string') : [];
    renderChips();
    setMode(saved.mode === 'voice' ? 'voice' : 'chat', false);
    if (params.get('mock') === 'login') showMockLogin();
    if (!saved.actions.length) {
      renderFolder();
      updateProgress();
      return; // welcome screen until they pick chat or voice
    }
    begun = true;
    root.dataset.view = 'chat';
    if (saved.flow === 2) { flow2 = true; firstSteps(); }
    else { setPlan('owner', false); pullNext(); } // saved before roles: exactly the order it was started in
    // Saved before the Growth add-on: replay exactly as it was (no growth step can shift their saved answers).
    growthOn = saved.g === 1;
    replaying = true;
    for (const a of saved.actions) {
      if (a.t !== 'p') renderStatic(pos);
      const render = apply(a);
      if (!render) break;
      render();
      actions.push(a);
    }
    // Saved before roles: ask once, as a tag (no restart, no re-routing).
    if (!flow2 && !roleTag() && !sent && steps[pos] && !isRoleStep(steps[pos])) {
      const a: Action = { t: 'c', v: 'role:legacy' };
      if (apply(a)) { actions.push(a); save(); }
    }
    // A session saved before the add-on that hasn't reached the closing question yet: offer Growth from here on.
    if (!growthOn && !usedBlocks.has('closing') && !sent) { growthOn = true; save(); }
    renderFolder();
    replaying = false;
    // Files live in memory only; links and recordings are saved. If they'd attached files, ask them to add them again.
    const attachedBefore = procs.flat().some((p) => p?.answers.some((v) => v?.includes('Attached:') && !links.some((l) => v.includes(linkLabel(l)) || v.includes(l))));
    if (attachedBefore) note('Files attached before the refresh need adding again (links and recordings are kept). Use the paperclip.');
    log.scrollTop = log.scrollHeight;
    showToast('Welcome back. Picked up where you left off', 'Start over', () => {
      if (!confirm('Clear your answers and start again?')) return;
      clear();
      location.reload();
    });
    enqueue(() => present());
  }

  void start();
</script>

</Base>

---
import Base from '../layouts/Base.astro';
import { INTRO, DEFAULT_AUDIENCE } from '../data/intake-intro';

// Public, so it can sit in the page. Unset means voice mode shows a "coming online" state and chat carries everything.
const agentId = (import.meta.env.PUBLIC_ELEVENLABS_AGENT_ID ?? '').trim();

const icons = {
  clip: '<path d="M21 11.5l-8.6 8.6a5.5 5.5 0 0 1-7.8-7.8l8.6-8.6a3.7 3.7 0 0 1 5.2 5.2l-8.6 8.6a1.8 1.8 0 0 1-2.6-2.6l7.9-7.9"/>',
  mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
  screen: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/><circle cx="12" cy="10" r="2.2" fill="currentColor" stroke="none"/>',
  up: '<path d="M12 19V5M5 12l7-7 7 7"/>',
  chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
  wave: '<path d="M4 10v4M8 6v12M12 3v18M16 7v10M20 10v4"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  skip: '<path d="M5 12h12M13 6l6 6-6 6"/>',
  save: '<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>',
  folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
};
const svg = (d: string, size = 20, sw = 2) =>
  `<svg aria-hidden="true" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
---
<Base
  title="Client intake | Roadmap Labs"
  description="The Roadmap Labs client intake: answer a short interview about your business by chat or by voice, and share any files or links that help."
  path="/intake"
  noindex
>
<style is:global>
  /* ======================================================================
     /intake: one focused conversation stage. Brand tokens from rl-tokens.css.
     ====================================================================== */
  .ik {
    --ik-top: 76px;
    --lvl: 0;
    --ease: cubic-bezier(.2,.7,.2,1);
    --tint: rgba(10,76,255,.06);
    --tint-2: rgba(10,76,255,.12);
    position: relative; isolation: isolate;
    overflow: hidden; /* fallback */
    overflow: clip; /* clip, not a scroll container: it can't be scrolled sideways, even programmatically */
    height: calc(100vh - var(--ik-top)); /* fallback for browsers without svh */
    height: calc(100svh - var(--ik-top)); min-height: 440px;
    display: flex; flex-direction: column;
    background: linear-gradient(180deg, #f7f8fc 0%, var(--paper) 38%);
    border-top: 1px solid rgba(0,7,16,.06);
  }
  .ik-bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; overflow: clip; pointer-events: none; }
  .ik-bg::before, .ik-bg::after { content: ""; position: absolute; z-index: -1; border-radius: 50%; filter: blur(80px); pointer-events: none; opacity: .16; }
  .ik-bg::before { width: 560px; height: 560px; left: -180px; top: -320px; background: #0a4cff; animation: rl-drift 20s ease-in-out infinite alternate; }
  .ik-bg::after { width: 460px; height: 460px; right: -160px; top: -260px; background: #00a3ff; animation: rl-drift 24s ease-in-out -6s infinite alternate-reverse; }
  .ik-col { width: 100%; max-width: 760px; margin: 0 auto; padding: 0 24px; box-sizing: border-box; }
  .ik-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ik button { font-family: var(--font-sans); -webkit-tap-highlight-color: transparent; }
  .ik :focus-visible { outline: 2px solid var(--roadmap-blue); outline-offset: 2px; }

  /* ---------- Top bar: identity, mode switch, progress ---------- */
  .ik-top { flex: none; position: relative; z-index: 3; }
  .ik-top__row { display: flex; align-items: center; gap: 12px; height: 64px; overflow: hidden; }
  .ik-id { flex: 1 1 auto; display: flex; align-items: center; gap: 10px; min-width: 0; }
  .ik-id__text { display: flex; flex-direction: column; min-width: 0; }
  .ik-id__name { font: 600 15px/20px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
  .ik-id__meta { font: 500 12px/16px var(--font-sans); color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ik-id__meta b { font-weight: 500; }
  .ik-modes { position: relative; margin-left: auto; flex: none; display: grid; grid-template-columns: 1fr 1fr; padding: 4px; border-radius: 999px; background: rgba(0,7,16,.05); }
  .ik-modes::before { content: ""; position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); border-radius: 999px; background: var(--paper); box-shadow: 0 1px 2px rgba(0,7,16,.08), 0 4px 12px rgba(0,7,16,.08); transition: transform .45s var(--ease); }
  .ik[data-mode="voice"] .ik-modes::before { transform: translateX(100%); }
  .ik-modes button { position: relative; z-index: 1; display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 36px; padding: 0 16px; border: 0; border-radius: 999px; background: transparent; color: var(--text-secondary); font: 600 13px/18px var(--font-sans); cursor: pointer; transition: color .3s ease; white-space: nowrap; }
  .ik-modes button[aria-pressed="true"] { color: var(--ink); }
  .ik-progress { position: relative; height: 3px; background: rgba(0,7,16,.06); border-radius: 3px; overflow: hidden; }
  .ik-progress i { position: absolute; inset: 0 auto 0 0; width: 0; border-radius: 3px; background: var(--gradient-signal); transition: width .8s var(--ease); }
  .ik-progress i::after { content: ""; position: absolute; right: 0; top: 50%; width: 8px; height: 8px; margin-top: -4px; border-radius: 50%; background: #00a3ff; box-shadow: 0 0 0 4px rgba(0,163,255,.18); }
  .ik[data-view="welcome"] .ik-progress { opacity: 0; }

  /* ---------- Orbs ---------- */
  .ik-orb { --size: 36px; position: relative; width: var(--size); height: var(--size); flex: none; border-radius: 50%; }
  .ik-orb__core { position: absolute; inset: 0; border-radius: 50%; overflow: hidden; background: radial-gradient(circle at 32% 28%, #9fd8ff 0%, #2f86ff 34%, #0a4cff 62%, #04227a 100%); box-shadow: inset 0 -6px 14px rgba(0,7,16,.25), 0 6px 20px rgba(10,76,255,.28); transform: scale(calc(1 + var(--lvl) * .14)); transition: transform .12s linear; }
  .ik-orb__core::before { content: ""; position: absolute; inset: -25%; background: conic-gradient(from 0deg, transparent 0 20%, rgba(0,163,255,.85) 30%, transparent 45% 62%, rgba(124,196,255,.7) 72%, transparent 85%); filter: blur(calc(var(--size) * .12)); animation: ik-spin 9s linear infinite; mix-blend-mode: screen; }
  .ik-orb__core::after { content: ""; position: absolute; left: 18%; top: 12%; width: 42%; height: 30%; border-radius: 50%; background: radial-gradient(closest-side, rgba(255,255,255,.75), transparent); filter: blur(2px); }
  .ik-orb__halo { position: absolute; inset: 0; border-radius: 50%; box-shadow: 0 0 0 calc(var(--size) * (.06 + var(--lvl) * .22)) rgba(0,163,255,.16), 0 0 calc(var(--size) * (.3 + var(--lvl) * .6)) rgba(10,76,255,.35); transition: box-shadow .14s linear; }
  .ik-orb--sm { --size: 36px; animation: ik-breathe 4.5s ease-in-out infinite; }
  .ik-orb--sm .ik-orb__halo { box-shadow: 0 0 0 calc(2px + var(--lvl) * 6px) rgba(0,163,255,.18); }
  .ik-orb--hero { --size: clamp(150px, 26vh, 220px); animation: ik-breathe 5.5s ease-in-out infinite; }
  .ik-orb--hero .ik-orb__ring { position: absolute; inset: 0; border-radius: 50%; border: 1px solid rgba(10,76,255,.28); animation: ik-ring 4.2s var(--ease) infinite; pointer-events: none; }
  .ik-orb--hero .ik-orb__ring:nth-child(2) { animation-delay: 1.4s; }
  .ik-orb--hero .ik-orb__ring:nth-child(3) { animation-delay: 2.8s; }
  .ik-orb--off .ik-orb__core { background: radial-gradient(circle at 32% 28%, #ffffff 0%, #d9e4ff 30%, #9fb4e6 66%, #6c80b8 100%); box-shadow: inset 0 -6px 14px rgba(0,7,16,.12), 0 6px 20px rgba(10,76,255,.12); }
  .ik-orb--off .ik-orb__core::before { opacity: .35; }
  .ik-orb--off .ik-orb__halo { box-shadow: 0 0 0 10px rgba(0,7,16,.04); }
  .ik-orb--off .ik-orb__ring { border-color: rgba(0,7,16,.1); }
  @keyframes ik-spin { to { transform: rotate(360deg); } }
  @keyframes ik-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.035); } }
  @keyframes ik-ring { 0% { transform: scale(.85); opacity: .9; } 100% { transform: scale(1.45); opacity: 0; } }

  /* ---------- Voice hero (expands in voice mode) ---------- */
  .ik-voice { flex: none; display: grid; grid-template-rows: 0fr; transition: grid-template-rows .55s var(--ease), opacity .4s ease; opacity: 0; }
  .ik[data-mode="voice"]:not([data-view="welcome"]):not([data-view="finish"]) .ik-voice { grid-template-rows: 1fr; opacity: 1; }
  .ik-voice > div { min-height: 0; overflow: hidden; }
  .ik-voice__inner { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 22px 0 8px; text-align: center; }
  .ik-voice__status { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(0,7,16,.05); font: 600 12px/16px var(--font-sans); color: var(--text-secondary); }
  .ik-voice__status::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--steel); }
  .ik-voice__status[data-live]::before { background: #00a3ff; box-shadow: 0 0 0 0 rgba(0,163,255,.6); animation: rl-pulse 1.8s ease-out infinite; }
  .ik-voice__caption { margin: 0; max-width: 34ch; font: 500 clamp(17px, 2.2vw, 20px)/1.4 var(--font-sans); letter-spacing: -0.015em; color: var(--ink); min-height: 1.4em; }
  .ik-voice__hint { margin: 0; max-width: 42ch; font: 400 14px/20px var(--font-sans); color: var(--text-secondary); }
  .ik-voice__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  /* The ElevenLabs widget renders with fixed positioning; a transformed box becomes its containing block, so it sits here. */
  .ik-widget { position: relative; width: min(100%, 420px); height: 168px; margin: -12px 0 -4px; transform: translateZ(0); }
  .ik[data-mode="voice"] .ik-q.is-current { font-size: 17px; line-height: 1.5; color: var(--ink); }
  .ik[data-mode="voice"] .ik-log { mask-image: linear-gradient(180deg, transparent 0, #000 56px); -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 56px); }

  /* ---------- Conversation ---------- */
  .ik-log { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; scroll-behavior: smooth; mask-image: linear-gradient(180deg, transparent 0, #000 72px); -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 72px); }
  .ik-log__inner { display: flex; flex-direction: column; gap: 18px; padding: 72px 0 calc(28px + var(--ik-dock, 0px)); min-height: 100%; box-sizing: border-box; justify-content: flex-end; }
  .ik-log { scroll-padding-bottom: calc(16px + var(--ik-dock, 0px)); }
  /* While Harry offers a choice there's nothing to type: hide the composer so the options have the room. */
  .ik[data-choosing] .ik-composer, .ik[data-choosing] .ik-chips, .ik[data-choosing] .ik-skip { display: none; }
  .ik-turn { display: flex; gap: 14px; align-items: flex-start; animation: ik-in .5s var(--ease) both; }
  .ik-turn .ik-orb { margin-top: 2px; }
  .ik-turn__body { min-width: 0; flex: 1; }
  .ik-say { margin: 0; font: 400 17px/1.55 var(--font-sans); letter-spacing: -0.01em; color: var(--ink); white-space: pre-wrap; overflow-wrap: anywhere; }
  .ik-q { margin: 0; font: 500 16px/1.5 var(--font-sans); letter-spacing: -0.01em; color: var(--text-secondary); white-space: pre-wrap; overflow-wrap: anywhere; transition: font-size .45s var(--ease), color .45s ease, line-height .45s ease; }
  .ik-q.is-current { font-size: clamp(22px, 3.3vw, 30px); line-height: 1.28; letter-spacing: -0.022em; color: var(--ink); }
  .ik-turn--q:not(:has(.is-current)) .ik-orb { opacity: .35; transform: scale(.8); transition: opacity .4s ease, transform .4s ease; animation: none; }
  .ik-turn--q:not(:has(.is-current)) .ik-orb__core::before { animation: none; }
  .ik-a { align-self: flex-end; max-width: min(82%, 560px); margin: 0; padding: 12px 16px; border-radius: 18px 18px 6px 18px; background: var(--tint); color: var(--ink); font: 400 16px/1.55 var(--font-sans); letter-spacing: -0.01em; white-space: pre-wrap; overflow-wrap: anywhere; animation: ik-settle .45s var(--ease) both; }
  .ik-a--spoken::before { content: "Spoken"; display: block; margin-bottom: 2px; font: 600 10px/14px var(--font-sans); letter-spacing: .06em; text-transform: uppercase; color: var(--roadmap-blue); }
  .ik-a--skip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 4px; background: none; color: var(--text-muted); font-size: 14px; }
  .ik-a--file { display: inline-flex; align-items: center; gap: 10px; background: var(--paper); border: 1px solid rgba(0,7,16,.1); box-shadow: 0 1px 2px rgba(0,7,16,.04); }
  .ik-a--file svg { flex: none; color: var(--roadmap-blue); }
  .ik-a--file span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ik-note { align-self: center; margin: 0; padding: 6px 14px; border-radius: 999px; background: rgba(0,7,16,.04); font: 500 13px/18px var(--font-sans); color: var(--text-secondary); text-align: center; animation: ik-in .4s var(--ease) both; }
  .ik-note button { padding: 0; border: 0; background: none; font: 600 13px/18px var(--font-sans); color: var(--roadmap-blue); cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
  .ik-note--error { background: #fef3f2; color: #b42318; }
  .ik-section { display: flex; flex-direction: column; gap: 2px; margin: 18px 0 2px; padding-top: 18px; border-top: 1px solid rgba(0,7,16,.08); animation: ik-in .5s var(--ease) both; }
  .ik-section span { font: 600 11px/16px var(--font-sans); letter-spacing: .08em; text-transform: uppercase; color: var(--roadmap-blue); }
  .ik-section strong { font: 600 18px/26px var(--font-sans); letter-spacing: -0.015em; color: var(--ink); }
  .ik-section--proc { margin-top: 6px; padding-top: 12px; border-top: 1px dashed rgba(0,7,16,.12); }
  .ik-section--proc strong { font-size: 16px; line-height: 22px; }
  .ik-hint { margin: 8px 0 0; max-width: 60ch; font: 400 14px/1.5 var(--font-sans); color: var(--text-secondary); animation: ik-in .4s .1s var(--ease) both; }
  .ik-help { margin-top: 12px; display: grid; gap: 8px; }
  .ik-help:empty { display: none; }
  .ik-turn--q:not(:has(.is-current)) .ik-hint, .ik-turn--q:not(:has(.is-current)) .ik-help { display: none; }
  .ik-quick { display: flex; flex-wrap: wrap; gap: 8px; animation: ik-in .4s .1s var(--ease) both; }
  .ik-chipbtn { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border: 1px solid rgba(0,7,16,.14); border-radius: 999px; background: var(--paper); color: var(--ink); font: 500 14px/20px var(--font-sans); cursor: pointer; transition: border-color .2s ease, background-color .2s ease, transform .2s var(--ease); }
  .ik-chipbtn:hover { border-color: var(--roadmap-blue); background: var(--tint); }
  .ik-chipbtn--primary { background: var(--roadmap-blue); border-color: var(--roadmap-blue); color: var(--paper); }
  .ik-chipbtn--primary:hover { background: #083fd6; color: var(--paper); }
  .ik-chipbtn[disabled] { opacity: .45; pointer-events: none; }
  .ik-bench { display: grid; gap: 12px; padding: 16px; border-radius: 16px; background: var(--paper); border: 1px solid rgba(0,7,16,.1); box-shadow: 0 6px 20px rgba(0,7,16,.05); animation: ik-in .45s .1s var(--ease) both; justify-items: start; }
  .ik-bench__head { display: flex; flex-direction: column; gap: 2px; }
  .ik-bench__head strong { font: 600 15px/20px var(--font-sans); color: var(--ink); }
  .ik-bench__head small { font: 400 12px/17px var(--font-sans); color: var(--text-secondary); }
  .ik-bench__grid { width: 100%; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr)); gap: 10px; }
  .ik-bench__grid label { display: grid; gap: 4px; font: 500 12px/16px var(--font-sans); color: var(--text-secondary); }
  .ik-bench__grid input { min-height: 42px; padding: 0 12px; border: 1px solid rgba(0,7,16,.14); border-radius: 10px; font: 400 15px/20px var(--font-sans); color: var(--ink); background: var(--paper); min-width: 0; }
  .ik-bench__grid input:focus { outline: 0; border-color: var(--roadmap-blue); box-shadow: 0 0 0 3px rgba(10,76,255,.12); }
  .ik-bench__maths { margin: 0; width: 100%; box-sizing: border-box; padding: 10px 12px; border-radius: 10px; background: #f7f8fc; font: 500 13px/19px var(--font-sans); color: var(--ink); font-variant-numeric: tabular-nums; }
  .ik-think { display: inline-flex; gap: 5px; padding: 12px 0; }
  .ik-think i { width: 6px; height: 6px; border-radius: 50%; background: var(--steel); animation: ik-dot 1s ease-in-out infinite; }
  .ik-think i:nth-child(2) { animation-delay: .15s; } .ik-think i:nth-child(3) { animation-delay: .3s; }
  @keyframes ik-dot { 0%, 100% { opacity: .3; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-3px); } }
  @keyframes ik-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes ik-settle { from { opacity: 0; transform: translateY(8px) scale(.98); } to { opacity: 1; transform: none; } }

  /* Cards inside the conversation (milestone, sharing) */
  .ik-card { margin: 6px 0; padding: 24px; border-radius: 20px; background: var(--paper); border: 1px solid rgba(0,7,16,.08); box-shadow: 0 1px 2px rgba(0,7,16,.04), 0 12px 32px rgba(0,7,16,.06); animation: ik-in .55s var(--ease) both; }
  .ik-card h3 { margin: 0; font: 600 22px/1.25 var(--font-sans); letter-spacing: -0.02em; color: var(--ink); }
  .ik-card p { margin: 6px 0 0; font: 400 15px/1.55 var(--font-sans); color: var(--text-secondary); }
  .ik-mile { display: grid; grid-template-columns: auto 1fr; gap: 6px 18px; align-items: center; }
  .ik-mile__ring { grid-row: span 2; position: relative; width: 64px; height: 64px; }
  .ik-mile__ring svg { position: absolute; inset: 0; transform: rotate(-90deg); }
  .ik-mile__ring circle { fill: none; stroke-width: 5; }
  .ik-mile__ring .bg { stroke: var(--tint-2); }
  .ik-mile__ring .fg { stroke: url(#ik-grad); stroke-linecap: round; stroke-dasharray: 176; stroke-dashoffset: 176; animation: ik-draw 1.1s .15s var(--ease) forwards; }
  .ik-mile__ring b { position: absolute; inset: 0; display: grid; place-items: center; font: 700 15px/1 var(--font-sans); color: var(--ink); }
  .ik-mile .ik-choices { grid-column: 1 / -1; margin-top: 14px; }
  .ik-grow__eyebrow { display: block; margin-bottom: 6px; font: 600 11px/16px var(--font-sans); letter-spacing: .08em; text-transform: uppercase; color: var(--roadmap-blue); }
  .ik-grow .ik-choices { margin-top: 14px; }
  @keyframes ik-draw { to { stroke-dashoffset: 0; } }
  .ik-choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 10px; }
  .ik-opt { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; min-height: 76px; padding: 14px 16px; border: 1px solid rgba(0,7,16,.12); border-radius: 16px; background: var(--paper); color: var(--ink); text-align: left; cursor: pointer; transition: border-color .2s ease, background-color .2s ease, transform .2s var(--ease), box-shadow .2s ease; }
  .ik-opt:hover { border-color: var(--roadmap-blue); box-shadow: 0 6px 18px rgba(10,76,255,.12); transform: translateY(-1px); }
  .ik-opt strong { display: flex; align-items: center; gap: 8px; font: 600 16px/22px var(--font-sans); letter-spacing: -0.01em; }
  .ik-opt small { font: 400 13px/18px var(--font-sans); color: var(--text-secondary); }
  .ik-opt--primary { background: var(--roadmap-blue); border-color: var(--roadmap-blue); color: var(--paper); }
  .ik-opt--primary small { color: rgba(255,255,255,.82); }
  .ik-opt--primary:hover { background: #083fd6; }
  .ik-opt[disabled] { opacity: .5; pointer-events: none; }
  .ik-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr)); gap: 10px; margin-top: 16px; }
  .ik-tile { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px; border: 1px solid rgba(0,7,16,.1); border-radius: 16px; background: #fbfbfd; color: var(--ink); cursor: pointer; text-align: left; transition: border-color .2s ease, background-color .2s ease, transform .2s var(--ease); }
  .ik-tile:hover { border-color: var(--roadmap-blue); background: var(--paper); transform: translateY(-1px); }
  .ik-tile span.ik-tile__icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--tint); color: var(--roadmap-blue); }
  .ik-tile strong { font: 600 15px/20px var(--font-sans); }
  .ik-tile small { font: 400 12px/17px var(--font-sans); color: var(--text-secondary); }
  .ik-share__send { margin-top: 18px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .ik-share__send small { font: 400 13px/18px var(--font-sans); color: var(--text-secondary); }

  .ik-cta { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; padding: 0 24px; border: 0; border-radius: 999px; background: var(--roadmap-blue); color: var(--paper); font: 600 16px/22px var(--font-sans); letter-spacing: -0.01em; cursor: pointer; transition: background-color .2s ease, transform .2s var(--ease), box-shadow .2s ease; box-shadow: 0 8px 24px rgba(10,76,255,.28); text-decoration: none; }
  .ik-cta:hover { background: #083fd6; transform: translateY(-1px); }
  .ik-cta[disabled] { opacity: .6; cursor: progress; transform: none; }
  .ik-cta--quiet { background: var(--paper); color: var(--ink); border: 1px solid rgba(0,7,16,.14); box-shadow: none; }
  .ik-cta--quiet:hover { background: var(--paper); border-color: var(--ink); }
  .ik-spin { width: 16px; height: 16px; border-radius: 50%; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; animation: ik-spin .8s linear infinite; }

  /* ---------- Welcome ---------- */
  .ik-welcome { display: none; flex: 1; min-height: 0; overflow-y: auto; }
  .ik[data-view="welcome"] .ik-welcome { display: flex; }
  .ik[data-view="welcome"] .ik-log, .ik[data-view="welcome"] .ik-dock { display: none; }
  .ik-welcome .ik-col { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; margin: auto; padding-top: 24px; padding-bottom: 48px; }
  .ik-welcome h1 { margin: 0; font: 500 clamp(36px, 5.4vw, 56px)/1.04 var(--font-sans); letter-spacing: -0.035em; color: var(--ink); max-width: 15ch; }
  /* Tailored brief: the client's name, logo and colour (set from the brief at load) */
  .ik-brandline { display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 6px 12px 6px 8px; border-radius: 999px; background: rgba(255,255,255,.8); border: 1px solid rgba(0,7,16,.08); font: 500 13px/18px var(--font-sans); color: var(--text-secondary); }
  .ik-brandline[hidden] { display: none; }
  .ik-brandline img { display: block; height: 24px; width: auto; max-width: 120px; object-fit: contain; }
  .ik-brandline b { color: var(--ink); font-weight: 600; }
  .ik-id__logo { display: block; height: 28px; width: auto; max-width: 96px; object-fit: contain; flex: none; }
  .ik-id__logo[hidden] { display: none; }
  .ik[data-brand] .ik-bg::before, .ik[data-brand] .ik-bg::after { background: var(--roadmap-blue); }
  .ik-known { display: grid; gap: 6px; padding: 12px; border-radius: 12px; background: var(--tint); }
  .ik-known[hidden] { display: none; }
  .ik-known ul { margin: 0; padding: 0 0 0 18px; display: grid; gap: 4px; font: 400 13px/18px var(--font-sans); color: var(--ink); }
  .ik-known p { margin: 0; font: 400 12px/17px var(--font-sans); color: var(--text-secondary); }
  .ik-welcome h1 span { background: var(--gradient-signal); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .ik-welcome__lead { margin: 0; max-width: 36em; font: 400 18px/1.55 var(--font-sans); letter-spacing: -0.01em; color: var(--text-secondary); }
  .ik-points { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .ik-points li { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px 8px 10px; border-radius: 999px; background: rgba(0,7,16,.04); font: 500 14px/20px var(--font-sans); color: var(--ink); }
  .ik-points svg { color: var(--roadmap-blue); }
  .ik-welcome__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .ik-welcome__fine { margin: 0; font: 400 12px/18px var(--font-sans); color: var(--text-muted); }
  .ik-welcome__fine a { color: inherit; }
  .ik-welcome .ik-orb--hero { --size: clamp(84px, 13vh, 112px); }
  .ik-welcome > .ik-col > * { animation: ik-in .7s var(--ease) both; }
  .ik-welcome > .ik-col > :nth-child(2) { animation-delay: .06s; } .ik-welcome > .ik-col > :nth-child(3) { animation-delay: .12s; }
  .ik-welcome > .ik-col > :nth-child(4) { animation-delay: .18s; } .ik-welcome > .ik-col > :nth-child(5) { animation-delay: .24s; } .ik-welcome > .ik-col > :nth-child(6) { animation-delay: .3s; }

  /* ---------- Dock: one composer ---------- */
  .ik-dock { flex: none; position: relative; z-index: 4; padding: 8px 0 14px; background: linear-gradient(180deg, rgba(255,255,255,0), var(--paper) 22px); }
  .ik-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 8px; }
  .ik-chips:empty { display: none; }
  .ik-chip { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; height: 30px; padding: 0 4px 0 10px; border-radius: 999px; background: var(--paper); border: 1px solid rgba(0,7,16,.1); font: 500 12px/16px var(--font-sans); color: var(--ink); animation: ik-settle .3s var(--ease) both; }
  .ik-chip svg { flex: none; color: var(--roadmap-blue); }
  .ik-chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 240px; }
  .ik-chip button { display: grid; place-items: center; width: 24px; height: 24px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--text-secondary); cursor: pointer; font: 600 15px/1 var(--font-sans); }
  .ik-chip button:hover { background: rgba(0,7,16,.06); color: var(--ink); }
  .ik-composer { display: flex; align-items: flex-end; gap: 4px; padding: 6px; border-radius: 26px; background: var(--paper); border: 1px solid rgba(0,7,16,.12); box-shadow: 0 1px 2px rgba(0,7,16,.04), 0 10px 30px rgba(0,7,16,.08); transition: border-color .2s ease, box-shadow .2s ease; }
  .ik-composer:focus-within { border-color: rgba(10,76,255,.55); box-shadow: 0 0 0 4px rgba(10,76,255,.1), 0 10px 30px rgba(0,7,16,.08); }
  .ik-composer:focus-within :focus-visible { outline-offset: -2px; }
  .ik-composer textarea:focus-visible { outline: none; }
  .ik-composer textarea { flex: 1; min-width: 0; align-self: center; resize: none; border: 0; outline: 0; background: transparent; padding: 10px 6px; max-height: 180px; min-height: 44px; box-sizing: border-box; font: 400 16px/24px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
  .ik-composer textarea::placeholder { color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ik-ico { position: relative; width: 44px; height: 44px; flex: none; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--graphite); cursor: pointer; transition: background-color .2s ease, color .2s ease, transform .2s var(--ease); }
  .ik-ico:hover { background: rgba(0,7,16,.05); color: var(--ink); }
  .ik-ico[aria-expanded="true"] { background: var(--tint-2); color: var(--roadmap-blue); }
  .ik-ico[aria-expanded="true"] svg { transform: rotate(-20deg); transition: transform .3s var(--ease); }
  .ik-mic[aria-pressed="true"] { background: var(--roadmap-blue); color: var(--paper); box-shadow: 0 0 0 calc(3px + var(--lvl) * 10px) rgba(10,76,255,.18); transition: box-shadow .1s linear; }
  .ik-send { background: var(--roadmap-blue); color: var(--paper); }
  .ik-send:hover { background: #083fd6; color: var(--paper); transform: translateY(-1px); }
  .ik-composer[data-locked] .ik-send { background: rgba(0,7,16,.08); color: var(--text-muted); }
  .ik-composer[data-locked] textarea, .ik-composer[data-locked] .ik-mic { opacity: .45; pointer-events: none; }
  @media (hover: hover) and (pointer: fine) {
    .ik [data-tip]:hover::after, .ik [data-tip]:focus-visible::after { content: attr(data-tip); position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%); padding: 6px 10px; border-radius: 8px; background: var(--abyss); color: var(--paper); font: 500 12px/16px var(--font-sans); white-space: nowrap; pointer-events: none; animation: ik-in .18s ease both; }
  }
  .ik-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px 16px; min-height: 36px; margin-top: 6px; padding: 0 6px; }
  .ik-skip { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 12px; margin-left: -12px; border: 0; border-radius: 999px; background: transparent; color: var(--text-secondary); font: 500 13px/18px var(--font-sans); cursor: pointer; transition: background-color .2s ease, color .2s ease; }
  .ik-skip:hover { background: rgba(0,7,16,.05); color: var(--ink); }
  .ik-skip small { font-size: 12px; color: var(--text-muted); font-weight: 400; }
  .ik-skip[disabled] { visibility: hidden; }
  .ik-meta__right { display: flex; align-items: center; gap: 14px; font: 400 12px/16px var(--font-sans); color: var(--text-muted); }
  .ik-meta__right button { padding: 0; border: 0; background: none; font: 600 12px/16px var(--font-sans); color: var(--roadmap-blue); cursor: pointer; }
  .ik-saved { display: inline-flex; align-items: center; gap: 5px; }
  .ik-saved svg { color: #12a150; }

  /* Attach menu: a popover on desktop, a bottom sheet on phones */
  .ik-menu { position: absolute; left: 0; bottom: calc(100% - 4px); width: min(360px, 100%); padding: 8px; border-radius: 20px; background: var(--paper); border: 1px solid rgba(0,7,16,.1); box-shadow: 0 18px 50px rgba(0,7,16,.18); transform-origin: bottom left; animation: ik-pop .22s var(--ease) both; }
  .ik-menu[hidden] { display: none; }
  @keyframes ik-pop { from { opacity: 0; transform: translateY(6px) scale(.97); } to { opacity: 1; transform: none; } }
  .ik-menu__item { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 56px; padding: 8px 10px; border: 0; border-radius: 14px; background: transparent; color: var(--ink); text-align: left; cursor: pointer; }
  .ik-menu__item:hover, .ik-menu__item:focus-visible { background: rgba(0,7,16,.04); }
  .ik-menu__item > span:first-child { display: grid; place-items: center; width: 38px; height: 38px; flex: none; border-radius: 12px; background: var(--tint); color: var(--roadmap-blue); }
  .ik-menu__item strong { display: block; font: 600 14px/20px var(--font-sans); }
  .ik-menu__item small { display: block; font: 400 12px/16px var(--font-sans); color: var(--text-secondary); }
  .ik-menu__link { display: flex; gap: 6px; padding: 6px 4px 4px; }
  .ik-menu__link[hidden] { display: none; }
  .ik-menu__link input { flex: 1; min-width: 0; min-height: 44px; padding: 0 14px; border: 1px solid rgba(0,7,16,.14); border-radius: 12px; font: 400 15px/20px var(--font-sans); color: var(--ink); background: var(--paper); }
  .ik-menu__link input:focus { outline: 0; border-color: var(--roadmap-blue); box-shadow: 0 0 0 3px rgba(10,76,255,.12); }
  .ik-menu__link button { min-height: 44px; padding: 0 16px; border: 0; border-radius: 12px; background: var(--roadmap-blue); color: var(--paper); font: 600 14px/20px var(--font-sans); cursor: pointer; }
  .ik-menu__foot { margin: 4px 10px 4px; font: 400 12px/16px var(--font-sans); color: var(--text-muted); }

  /* Recording pill */
  .ik-recbar { min-width: 0; max-width: 100%; box-sizing: border-box; display: flex; align-items: center; gap: 12px; margin: 0 0 8px; padding: 6px 6px 6px 16px; border-radius: 999px; background: var(--abyss); color: var(--paper); font: 500 13px/18px var(--font-sans); font-variant-numeric: tabular-nums; animation: ik-settle .3s var(--ease) both; }
  .ik-recbar[hidden] { display: none; }
  .ik-recdot { width: 10px; height: 10px; flex: none; border-radius: 50%; background: #e5484d; box-shadow: 0 0 0 0 rgba(229,72,77,.6); animation: ik-rec 1.4s ease-out infinite; }
  .ik-recbar[data-uploading] .ik-recdot { background: #00a3ff; animation: rl-pulse 1.4s ease-out infinite; }
  .ik-recbar__meter { flex: 1; min-width: 40px; height: 4px; border-radius: 4px; background: rgba(255,255,255,.16); overflow: hidden; }
  .ik-recbar__meter i { display: block; height: 100%; width: 0; background: var(--gradient-signal); transition: width .5s ease; }
  .ik-recbar button { min-height: 36px; padding: 0 16px; border: 0; border-radius: 999px; background: var(--paper); color: var(--ink); font: 600 13px/18px var(--font-sans); cursor: pointer; }
  .ik-recbar[data-uploading] button { display: none; }
  @keyframes ik-rec { 0% { box-shadow: 0 0 0 0 rgba(229,72,77,.55); } 100% { box-shadow: 0 0 0 9px rgba(229,72,77,0); } }

  /* Toast (welcome back, errors that aren't in the thread) */
  .ik-toast { position: absolute; z-index: 5; left: 12px; right: 12px; top: 76px; width: fit-content; max-width: calc(100% - 24px); margin: 0 auto; box-sizing: border-box; display: inline-flex; align-items: center; gap: 10px; padding: 8px 8px 8px 16px; border-radius: 999px; background: var(--abyss); color: var(--paper); font: 500 13px/18px var(--font-sans); box-shadow: 0 10px 30px rgba(0,7,16,.25); animation: ik-pop .3s var(--ease) both;  }
  .ik-toast[hidden] { display: none; }
  .ik-toast button { min-height: 30px; padding: 0 12px; border: 0; border-radius: 999px; background: rgba(255,255,255,.14); color: var(--paper); font: 600 12px/16px var(--font-sans); cursor: pointer; }

  /* ---------- Your folder (desktop side panel, phone sheet) ---------- */
  .ik-folderbtn { position: relative; flex: none; display: inline-flex; align-items: center; gap: 4px; min-height: 40px; padding: 0 10px; border: 1px solid rgba(0,7,16,.12); border-radius: 999px; background: var(--paper); color: var(--ink); font: 600 12px/16px var(--font-sans); cursor: pointer; }
  .ik-folderbtn svg { color: var(--roadmap-blue); }
  .ik-folderbtn.is-grew { animation: ik-grew-btn 1.4s ease; }
  @keyframes ik-grew-btn { 0%, 100% { box-shadow: 0 0 0 0 rgba(10,76,255,0); } 30% { box-shadow: 0 0 0 6px rgba(10,76,255,.18); } }
  .ik[data-view="welcome"] .ik-folderbtn { display: none; }
  .ik-panel { display: flex; flex-direction: column; gap: 10px; box-sizing: border-box; padding: 18px; border-radius: 20px; background: rgba(255,255,255,.86); border: 1px solid rgba(0,7,16,.08); box-shadow: 0 1px 2px rgba(0,7,16,.04), 0 12px 32px rgba(0,7,16,.06); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); overflow-y: auto; overscroll-behavior: contain; }
  .ik-panel__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .ik-panel__eyebrow { display: block; font: 600 11px/16px var(--font-sans); letter-spacing: .08em; text-transform: uppercase; color: var(--roadmap-blue); }
  .ik-panel__head strong { display: block; font: 600 16px/22px var(--font-sans); letter-spacing: -0.01em; color: var(--ink); }
  .ik-panel__close { display: none; width: 36px; height: 36px; flex: none; border: 0; border-radius: 50%; background: rgba(0,7,16,.05); color: var(--ink); font: 500 20px/1 var(--font-sans); cursor: pointer; }
  .ik-panel__note { margin: 0; font: 400 13px/18px var(--font-sans); color: var(--text-secondary); }
  .ik-panel__role { display: grid; gap: 4px; padding: 10px 12px; border-radius: 12px; background: #f7f8fc; font: 400 13px/18px var(--font-sans); color: var(--ink); }
  .ik-panel__role[hidden] { display: none; }
  .ik-panel__role-actions { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .ik-panel__role button { min-height: 32px; padding: 0; border: 0; background: none; font: 600 13px/18px var(--font-sans); color: var(--roadmap-blue); cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
  .ik-panel__role small { font: 400 11px/16px var(--font-sans); color: var(--text-secondary); }
  .ik-panel__link { align-self: flex-start; padding: 0; border: 0; background: none; font: 600 12px/18px var(--font-sans); color: var(--roadmap-blue); cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
  .ik-panel__fine { margin: 4px 0 0; font: 400 11px/16px var(--font-sans); color: var(--text-muted); }
  .ik-tree { display: grid; gap: 2px; margin-top: 4px; }
  .ik-dir { display: flex; align-items: center; gap: 8px; padding: 6px 4px; font: 600 14px/20px var(--font-sans); color: var(--ink); min-width: 0; }
  .ik-dir svg { flex: none; color: var(--roadmap-blue); }
  .ik-dir span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ik-file { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2px 10px; padding: 8px 8px 8px 22px; border-radius: 10px; min-width: 0; transition: background-color .6s ease; }
  .ik-file--wf { padding-left: 38px; }
  .ik-file__name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 500 14px/20px var(--font-sans); color: var(--ink); }
  .ik-file__sub { grid-column: 1 / -1; min-width: 0; font: 400 12px/16px var(--font-sans); color: var(--text-secondary); }
  .ik-file[data-depth="empty"] .ik-file__name { color: var(--text-muted); }
  .ik-file.is-new { animation: ik-in .5s var(--ease) both; }
  .ik-file.is-grew { background: var(--tint-2); }
  .ik-placeholder { padding: 4px 8px 8px 38px; font: 400 12px/16px var(--font-sans); color: var(--text-muted); }
  .ik-depth { display: inline-flex; align-items: center; gap: 6px; font: 500 11px/14px var(--font-sans); color: var(--text-secondary); }
  .ik-depth__bar { display: inline-grid; grid-template-columns: repeat(3, 10px); gap: 2px; }
  .ik-depth__bar i { height: 6px; border-radius: 3px; background: rgba(0,7,16,.1); transition: background-color .4s ease; }
  .ik-file[data-depth="thin"] .ik-depth__bar i:nth-child(-n+2) { background: #7cb0ff; }
  .ik-file[data-depth="solid"] .ik-depth__bar i { background: var(--roadmap-blue); }
  @media (min-width: 1024px) {
    .ik:not([data-view="welcome"]):not([data-view="tour"]) { padding-right: 344px; }
    .ik-panel { position: absolute; z-index: 3; top: 16px; right: 24px; bottom: 16px; width: 300px; }
    .ik[data-view="welcome"] .ik-panel { display: none; }
    .ik-folderbtn { display: none; }
  }
  @media (max-width: 1023px) {
    .ik-panel { position: fixed; z-index: 25; left: 8px; right: 8px; bottom: 8px; max-height: min(78svh, 640px); border-radius: 24px; background: var(--paper); box-shadow: 0 0 0 100vmax rgba(0,7,16,.32), 0 18px 50px rgba(0,7,16,.18); transform: translateY(calc(100% + 24px)); visibility: hidden; transition: transform .35s var(--ease), visibility 0s .35s; }
    .ik-panel[data-open] { transform: none; visibility: visible; transition: transform .35s var(--ease), visibility 0s; }
    .ik-panel__close { display: grid; place-items: center; }
  }

  /* ---------- Opening walkthrough (fresh sessions) ---------- */
  .ik-tour { display: none; flex: 1; min-height: 0; flex-direction: column; overflow-y: auto; overflow-x: hidden; }
  .ik[data-view="tour"] .ik-tour { display: flex; }
  .ik[data-view="tour"] .ik-welcome, .ik[data-view="tour"] .ik-log, .ik[data-view="tour"] .ik-dock,
  .ik[data-view="tour"] .ik-voice, .ik[data-view="tour"] .ik-panel, .ik[data-view="tour"] .ik-folderbtn, .ik[data-view="tour"] .ik-progress { display: none; }
  .ik-tour > .ik-tour__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 18px; }
  .ik-tour__hello { font: 600 13px/18px var(--font-sans); color: var(--roadmap-blue); letter-spacing: -0.005em; }
  .ik-tour__skip { min-height: 40px; padding: 0 16px; border: 1px solid rgba(0,7,16,.12); border-radius: 999px; background: var(--paper); color: var(--ink); font: 600 13px/18px var(--font-sans); cursor: pointer; }
  .ik-tour > .ik-tour__stage { flex: 1 0 auto; display: flex; flex-direction: column; justify-content: center; padding-top: 28px; padding-bottom: 20px; }
  .ik-tour__set[hidden] { display: none; }
  .ik-beat { display: none; flex-direction: column; align-items: stretch; gap: 28px; }
  .ik-beat.is-on { display: flex; }
  .ik-beat__text { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; min-width: 0; }
  .ik-beat__figure { margin: 0; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .ik-beat__figure .ik-demo { margin: 0; }
  .ik-beat__figure figcaption, .ik-beat__norec { margin: 0; padding: 0 4px; font: 400 13px/1.5 var(--font-sans); color: var(--text-muted); }
  .ik-beat__norec[hidden] { display: none; }
  /* Calm entrance: one gentle rise, lightly staggered. */
  .ik-beat.is-on .ik-beat__text > *, .ik-beat.is-on .ik-beat__figure, .ik-beat.is-on > .ik-beat__footer { animation: ik-calm .7s var(--ease) both; }
  .ik-beat.is-on .ik-beat__text > :nth-child(2) { animation-delay: .06s; }
  .ik-beat.is-on .ik-beat__text > :nth-child(3) { animation-delay: .12s; }
  .ik-beat.is-on .ik-beat__text > :nth-child(4) { animation-delay: .18s; }
  .ik-beat.is-on .ik-beat__text > :nth-child(n+5) { animation-delay: .24s; }
  .ik-beat.is-on .ik-beat__figure { animation-delay: .2s; }
  .ik-beat.is-on > .ik-beat__footer { animation-delay: .3s; }
  .ik-beat.is-on > .ik-blocks { animation: ik-calm .7s .28s var(--ease) both; }
  @keyframes ik-calm { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .ik-beat__eyebrow { font: 600 12px/16px var(--font-sans); letter-spacing: .1em; text-transform: uppercase; color: var(--roadmap-blue); }
  .ik-beat h2 { margin: 0 0 2px; max-width: 18em; font: 500 clamp(28px, 3vw, 38px)/1.12 var(--font-sans); letter-spacing: -0.025em; color: var(--ink); text-wrap: balance; }
  .ik-beat__body { margin: 0; max-width: 36em; font: 400 17px/1.6 var(--font-sans); color: #3d4350; text-wrap: pretty; }
  .ik-beat__footer { margin: 4px 0 0; max-width: 36em; font: 500 15px/1.55 var(--font-sans); color: var(--ink); }
  /* Labelled blocks: "One thing to know first", "What you get" */
  .ik-blocks { display: grid; gap: 10px; width: 100%; }
  .ik-block { padding: 14px 16px; border-radius: 14px; background: rgba(255,255,255,.8); border: 1px solid rgba(0,7,16,.08); }
  .ik-block__label { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 4px; font: 600 14px/20px var(--font-sans); letter-spacing: -0.005em; color: var(--ink); }
  .ik-block p { margin: 0; font: 400 15px/1.6 var(--font-sans); color: #3d4350; }

  .ik-steps li { counter-increment: step; position: relative; padding: 14px 16px 14px 58px; border-radius: 14px; background: rgba(255,255,255,.8); border: 1px solid rgba(0,7,16,.08); }
  .ik-steps li::before { content: counter(step); position: absolute; left: 16px; top: 13px; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--tint-2); color: var(--roadmap-blue); font: 700 13px/1 var(--font-sans); }

<section class="ik" id="ik" data-mode="chat" data-view="welcome" data-agent={agentId || undefined} aria-label="Intake interview with Riley">
  <svg width="0" height="0" style="position: absolute" aria-hidden="true"><defs><linearGradient id="ik-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0a4cff"/><stop offset="1" stop-color="#00a3ff"/></linearGradient></defs></svg>

  <!-- Top bar -->
  <div class="ik-top">
    <div class="ik-col">
      <div class="ik-top__row">
        <div class="ik-id">
          <span class="ik-orb ik-orb--sm" aria-hidden="true"><span class="ik-orb__halo"></span><span class="ik-orb__core"></span></span>

      <form class="ik-composer" id="ik-composer" data-locked>
        <button class="ik-ico" type="button" id="ik-attach" aria-label="Share a file, link or screen recording" aria-expanded="false" aria-controls="ik-tray" data-tip="Share a file or link"><Fragment set:html={svg(icons.clip)} /></button>

  .ik-next li { counter-increment: ik; padding: 18px; border-radius: 16px; border: 1px solid rgba(0,7,16,.08); background: var(--paper); font: 400 14px/20px var(--font-sans); color: var(--text-secondary); }
  .ik-next li::before { content: counter(ik); display: grid; place-items: center; width: 28px; height: 28px; margin-bottom: 10px; border-radius: 50%; background: var(--tint); color: var(--roadmap-blue); font: 700 13px/1 var(--font-sans); }
  .ik-next strong { display: block; margin-bottom: 2px; font: 600 15px/22px var(--font-sans); color: var(--ink); }
  .ik-finish__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; }

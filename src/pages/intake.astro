  .ik-finish { display: none; flex: 1; min-height: 0; overflow-y: auto; }
  .ik[data-view="finish"] .ik-finish { display: block; }
  .ik[data-view="finish"] .ik-log, .ik[data-view="finish"] .ik-dock, .ik[data-view="finish"] .ik-modes { display: none; }
  .ik-finish .ik-col { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; padding-top: 40px; padding-bottom: 56px; }
  .ik-done { position: relative; width: 76px; height: 76px; border-radius: 50%; background: var(--gradient-signal); display: grid; place-items: center; box-shadow: 0 12px 34px rgba(10,76,255,.35); animation: ik-pop .5s var(--ease) both; }

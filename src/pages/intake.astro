  .ik-mock__flag { display: inline-flex; padding: 4px 10px; border-radius: 999px; background: #fff4e5; color: #8a4b00; font: 600 11px/16px var(--font-sans); letter-spacing: .06em; text-transform: uppercase; }
  .ik-mock__step { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; width: 100%; animation: ik-in .5s var(--ease) both; }
  .ik-mock__step[hidden] { display: none; }
  .ik-mock h1 { margin: 0; font: 500 clamp(34px, 5vw, 48px)/1.05 var(--font-sans); letter-spacing: -0.03em; color: var(--ink); }

---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import PostMeta from '../../components/blog/PostMeta.astro';
import PostList from '../../components/blog/PostList.astro';
import { getPosts, renderPost, formatDate, type Post } from '../../lib/blog';
import { SITE, abs, faqSchema } from '../../data/site';
import danPhoto from '../../assets/images/dan-kovac.jpg';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const all = await getPosts();
const { intro, sections, takeaways, cta } = renderPost(post);
const path = `/blog/${post.slug}`;
const url = abs(path);
const image = post.featured_image ? (post.featured_image.startsWith('http') ? post.featured_image : abs(post.featured_image)) : abs('/og/roadmap-labs.png');
const updated = post.updated_at.getTime() - post.published_at.getTime() > 86400000;

// Keep reading: related slugs first, then the section's other posts, then the latest.
const others = all.filter((p) => p.slug !== post.slug);
const more = [
  ...post.related_slugs.map((s) => others.find((p) => p.slug === s)).filter((p): p is Post => !!p),
  ...others.filter((p) => p.cluster.slug === post.cluster.slug),
  ...others,
].filter((p, i, arr) => arr.indexOf(p) === i).slice(0, 3);

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: post.title,
    description: post.meta_description,
    image: [image],
    url,
    mainEntityOfPage: url,
    inLanguage: 'en-AU',
    datePublished: post.published_at.toISOString(),
    dateModified: post.updated_at.toISOString(),
    articleSection: post.cluster.name,
    keywords: [post.primary_keyword, ...post.secondary_keywords].join(', '),
    wordCount: post.body_md.split(/\s+/).filter(Boolean).length,
    author: { '@type': 'Person', '@id': `${SITE.url}/about#dan-kovac`, name: post.author_name, url: abs('/about') },
    publisher: { '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png` } },
    isPartOf: { '@id': `${SITE.url}/blog#blog` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Insights', item: abs('/blog') },
      { '@type': 'ListItem', position: 3, name: post.cluster.name, item: abs(`/blog/topics/${post.cluster.slug}`) },
      { '@type': 'ListItem', position: 4, name: post.title, item: url },
    ],
  },
];
if (post.faq.length) schema.push(faqSchema(post.faq));
const shareLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---
<Base
  title={post.meta_title.length <= 44 ? `${post.meta_title} | Roadmap Labs` : post.meta_title}
  description={post.meta_description}
  path={path}
  ogType="article"
  ogImage={image}
  ogImageAlt={post.featured_image_alt}
  schema={schema}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.published_at.toISOString()} />
    <meta property="article:modified_time" content={post.updated_at.toISOString()} />
    <meta property="article:author" content={abs('/about')} />
    <meta property="article:section" content={post.cluster.name} />
  </Fragment>

  <article>
    <header class="post-head">
      <nav class="post-crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/blog">Insights</a></li>
          <li><a href={`/blog/topics/${post.cluster.slug}`}>{post.cluster.name}</a></li>
        </ol>
      </nav>
      <h1>{post.title}</h1>
      <p class="post-standfirst">{post.excerpt}</p>
      <div class="post-byline">
        <Img src={danPhoto} alt="" sizes="48px" widths={[96]} />
        <span class="who">
          <a href="/about" rel="author">{post.author_name}</a>
          <span class="ins-meta">
            <time datetime={post.published_at.toISOString()}>{formatDate(post.published_at)}</time>
            {updated && <><span class="sep" aria-hidden="true">·</span><span>Updated <time datetime={post.updated_at.toISOString()}>{formatDate(post.updated_at)}</time></span></>}
            <span class="sep" aria-hidden="true">·</span>
            <span>{post.reading_minutes} min read</span>
          </span>
        </span>
      </div>
    </header>

    {post.featured_image && (
      <div class="post-hero">
        <picture>
          {!post.featured_image.startsWith('http') && <source type="image/webp" srcset={`${post.featured_image.replace(/\.png$/, '-800.webp')} 800w, ${post.featured_image.replace(/\.png$/, '.webp')} 1200w`} sizes="(max-width: 1104px) calc(100vw - 48px), 1056px" />}
          <img src={post.featured_image} alt={post.featured_image_alt} width="1200" height="630" fetchpriority="high" decoding="sync" />
        </picture>
      </div>
    )}

    <div class="post-body">
      <Fragment set:html={intro} />
      {sections.map((s) => (
        <>
          <h2 id={s.id}>{s.title}</h2>
          <Fragment set:html={s.html} />
        </>
      ))}

      {takeaways && (
        <section class="post-panel" aria-labelledby="key-takeaways">
          <h2 id="key-takeaways">Key takeaways</h2>
          <Fragment set:html={takeaways} />
        </section>
      )}

      {cta && (
        <section class="post-cta" id="book-a-free-1-hour-session" aria-labelledby="cta-heading">
          <h2 id="cta-heading">{cta.title}</h2>
          <Fragment set:html={cta.html} />
        </section>
      )}

      <aside class="post-author" aria-label="About the author">
        <Img src={danPhoto} alt="" sizes="64px" widths={[128]} />
        <div>
          <strong>{post.author_name}, founder of Roadmap Labs</strong>
          <p>I spent 10 years running a digital marketing agency, and I've been implementing AI systems since 2012, long before ChatGPT made it mainstream.</p>
          <a class="rl-link-action" href="/about">More about Dan</a>
        </div>
      </aside>

      <div class="post-share">
        <span>Share</span>
        <a href={shareLinkedIn} target="_blank" rel="noopener">LinkedIn<span class="cs-sr"> (opens in a new tab)</span></a>
        <button type="button" data-copy={url}>Copy link</button>
      </div>
    </div>
  </article>

  {more.length > 0 && (
    <section class="post-more" aria-labelledby="keep-reading">
      <h2 id="keep-reading">Keep reading</h2>
      <PostList posts={more} />
    </section>
  )}
  {more.length === 0 && <div style="height: 96px"></div>}

  <script is:inline>
    document.querySelectorAll('[data-copy]').forEach(function (b) {
      b.addEventListener('click', function () {
        var done = function () { var t = b.textContent; b.textContent = 'Link copied'; setTimeout(function () { b.textContent = t; }, 2000); };
        if (navigator.clipboard) navigator.clipboard.writeText(b.getAttribute('data-copy')).then(done); else done();
      });
    });
  </script>
</Base>

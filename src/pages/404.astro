---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found | Roadmap Labs"
  description="We couldn't find that page. Head back to the Roadmap Labs home page, or book a free 1-hour discovery session."
  path="/404"
  noindex
>
<section style="max-width: 1200px; margin: 0 auto; padding: 120px 24px 140px; box-sizing: border-box; display: flex; flex-direction: column; align-items: flex-start; gap: 24px">
  <span class="rl-tag">404</span>
  <h1 style="margin: 0; font-size: clamp(44px, 5.6vw, 72px); line-height: 1.0; letter-spacing: -0.03em; font-weight: 600; max-width: 14ch">We couldn't find that page</h1>
  <p style="margin: 0; font-size: 20px; line-height: 30px; letter-spacing: -0.01em; color: var(--text-secondary); max-width: 32em">The link might be old, or the page might have moved. Try the home page, or book a free 1-hour discovery session and we'll talk through where AI fits in your business.</p>
  <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; padding-top: 4px">
    <a class="rl-btn rl-btn--lg" href="/">Go to the home page</a>
    <a class="rl-link-action" href="/contact" style="padding: 12px 0">Book a free 1-hour discovery session</a>
  </div>
</section>
</Base>

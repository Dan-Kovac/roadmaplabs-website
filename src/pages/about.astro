---
import Base from '../layouts/Base.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Img from '../components/Img.astro';
import Faq from '../components/Faq.astro';
import { ABOUT_FAQ } from '../data/site';
import { personSchema } from '../data/schema';
const person = await personSchema();
import danKovac from '../assets/images/dan-kovac.jpg';
import fabricationWorkshopTeam from '../assets/images/fabrication-workshop-team.jpg';
---
<Base
  title='About Dan Kovac, AI Consultant in Melbourne | Roadmap Labs'
  description='Dan Kovac ran a digital marketing agency for 10 years and has implemented AI systems since 2012. He helps established Australian businesses scale with AI.'
  path="/about"
  schema={[person]}
>

<section style="max-width: 1200px; margin: 0 auto; padding: 80px 24px; box-sizing: border-box">
  <div class="rl-split">
    <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 24px">
      <span class="rl-tag">AI consultant · Melbourne</span>
      <h1 style="margin: 0; font-size: clamp(44px, 5.6vw, 72px); line-height: 1.0; letter-spacing: -0.03em; font-weight: 600">Hi, I'm Dan, an AI consultant helping Aussie businesses scale</h1>
      <p style="margin: 0; font-size: 20px; line-height: 28px; color: var(--text-secondary); max-width: 30em">I spent 10 years running a digital marketing agency, and I've been implementing AI systems since 2012. Now I help established Australian businesses map their processes and build the automations worth having.</p>
    </div>
    <figure class="rl-photo" style="aspect-ratio: 4 / 5; max-width: 480px; width: 100%; justify-self: center; background: var(--gradient-signal)"><Img src={danKovac} alt="Dan Kovac, founder of Roadmap Labs" style="filter: none; mix-blend-mode: normal; object-position: 50% 0%" sizes="(max-width: 720px) calc(100vw - 48px), 480px" eager priority /></figure>
  </div>
</section>

<section style="background: var(--fog)">
  <div style="max-width: 1200px; margin: 0 auto; padding: 80px 24px; box-sizing: border-box; display: flex; flex-wrap: wrap; gap: 48px">
    <h2 style="flex: 1 1 280px; margin: 0; font-size: clamp(32px, 4vw, 48px); line-height: 1.2; letter-spacing: -0.025em; font-weight: 600">Where the experience comes from</h2>
    <dl style="flex: 2 1 560px; margin: 0; border-top: 1px solid var(--border)">
      <div style="display: flex; flex-wrap: wrap; gap: 4px 32px; padding: 20px 0; border-bottom: 1px solid var(--border)"><dt style="flex: 0 0 200px; font-weight: 600">Compass Buyers Agency</dt><dd style="flex: 1 1 280px; margin: 0; color: var(--text-secondary)">Client since 2024. A data-driven suburb website, and a bespoke web app that runs the business. <a href="/work/compass-buyers-agency">Read the case study</a></dd></div>
      <div style="display: flex; flex-wrap: wrap; gap: 4px 32px; padding: 20px 0; border-bottom: 1px solid var(--border)"><dt style="flex: 0 0 200px; font-weight: 600">ReviewBuddy</dt><dd style="flex: 1 1 280px; margin: 0; color: var(--text-secondary)">Our reviews platform, in live pilot since 2025. <a href="/work/reviewbuddy">Read the case study</a></dd></div>
      <div style="display: flex; flex-wrap: wrap; gap: 4px 32px; padding: 20px 0; border-bottom: 1px solid var(--border)"><dt style="flex: 0 0 200px; font-weight: 600">Flexfolio</dt><dd style="flex: 1 1 280px; margin: 0; color: var(--text-secondary)">Our portfolio platform for product managers, in pilot with 30 PMs. <a href="/work/flexfolio">Read the case study</a></dd></div>
      <div style="display: flex; flex-wrap: wrap; gap: 4px 32px; padding: 20px 0; border-bottom: 1px solid var(--border)"><dt style="flex: 0 0 200px; font-weight: 600">Digital marketing</dt><dd style="flex: 1 1 280px; margin: 0; color: var(--text-secondary)">10 years running a digital marketing agency.</dd></div>
      <div style="display: flex; flex-wrap: wrap; gap: 4px 32px; padding: 20px 0; border-bottom: 1px solid var(--border)"><dt style="flex: 0 0 200px; font-weight: 600">AI since 2012</dt><dd style="flex: 1 1 280px; margin: 0; color: var(--text-secondary)">Implementing AI systems for well over a decade.</dd></div>
      <div style="display: flex; flex-wrap: wrap; gap: 4px 32px; padding: 20px 0; border-bottom: 1px solid var(--border)"><dt style="flex: 0 0 200px; font-weight: 600">Enterprise AI</dt><dd style="flex: 1 1 280px; margin: 0; color: var(--text-secondary)">I'm a product manager at one of Australia's largest wagering companies, so I see enterprise AI rolled out at scale every day.</dd></div>
    </dl>
  </div>
</section>

<section style="max-width: 1200px; margin: 0 auto; padding: 80px 24px; box-sizing: border-box">
  <div class="rl-split rl-split--flip">
    <figure class="rl-photo rl-photo--soft" style="aspect-ratio: 4 / 3"><Img src={fabricationWorkshopTeam} alt="A team talking on a fabrication workshop floor" sizes="(max-width: 720px) calc(100vw - 48px), 560px" /></figure>
    <div>
      <h2>How I work with clients</h2>
      <p>I start with what the business is trying to grow towards and work backwards. I map how the work runs today, then put a number on each opportunity so we can pick the one worth doing first.</p>
      <p>The project is scoped and priced before we start. Accounts stay in your name, and I train the people who'll use what we build.</p>
      <a class="rl-link-action" href="/work">See the work</a>
    </div>
  </div>
</section>

<section style="border-top: 1px solid var(--border)">
  <div style="max-width: 1200px; margin: 0 auto; padding: 80px 24px; box-sizing: border-box; display: flex; flex-wrap: wrap; gap: 48px">
    <h2 style="flex: 1 1 280px; margin: 0; font-size: 36px; line-height: 1.21; letter-spacing: -0.02em; font-weight: 600">Working together</h2>
    <Faq items={ABOUT_FAQ} />
  </div>
</section>

<ClosingCTA />

</Base>

---
import Base from '../layouts/Base.astro';
---
<Base
  title="Thanks for getting in touch | Roadmap Labs"
  description="Thanks for booking a free AI strategy session with Roadmap Labs. Dan will be in touch to find a time."
  path="/thanks"
  noindex
>
<section style="max-width: 1200px; margin: 0 auto; padding: 120px 24px 140px; box-sizing: border-box; display: flex; flex-direction: column; align-items: flex-start; gap: 24px">
  <span class="rl-tag">Free AI strategy session</span>
  <h1 style="margin: 0; font-size: clamp(44px, 5.6vw, 72px); line-height: 1.0; letter-spacing: -0.03em; font-weight: 600; max-width: 16ch">Thanks, Dan will be in touch to find a time.</h1>
  <p style="margin: 0; font-size: 20px; line-height: 30px; letter-spacing: -0.01em; color: var(--text-secondary); max-width: 32em">While you wait, have a look at some of the work we've done. If anything's urgent, email <a href="mailto:dan@roadmaplabs.com.au" style="color: inherit">dan@roadmaplabs.com.au</a>.</p>
  <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; padding-top: 4px">
    <a class="rl-btn rl-btn--lg" href="/work">See the work</a>
    <a class="rl-link-action" href="/" style="padding: 12px 0">Back to the home page</a>
  </div>
</section>
</Base>

---
import Base from '../../layouts/Base.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import Mockup from '../../components/Mockup.astro';
import Img from '../../components/Img.astro';
import { CASES } from '../../data/site';
import { caseSchema } from '../../data/schema';
const c = CASES.compass;
import compassByronBaySuburbPage from '../../assets/images/compass-byron-bay-suburb-page.jpg';
import compassBuyersAgencyPhone from '../../assets/images/compass-buyers-agency-phone.jpg';
import compassContactPage from '../../assets/images/compass-contact-page.jpg';
---
<Base
  title='Compass Buyers Agency: Website and Web App | Roadmap Labs'
  description='How we built Compass Buyers Agency a data-driven suburb website and a bespoke web app that runs the business, connected to Claude, Xero and DocuSign.'
  path="/work/compass-buyers-agency"
  ogType="article"
  ogImage={c.og}
  ogImageAlt={c.laptopAlt}
  schema={caseSchema(c, 'Compass Buyers Agency: Website and Web App | Roadmap Labs', 'How we built Compass Buyers Agency a data-driven suburb website and a bespoke web app that runs the business, connected to Claude, Xero and DocuSign.')}
>
<article style="max-width: 1200px; margin: 0 auto; padding: 48px 24px 80px; box-sizing: border-box; display: flex; flex-direction: column; gap: 48px">

  <nav class="cs-switch" aria-label="Case studies" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px">
    <a class="rl-link" href="/work" style="color: var(--text-secondary); padding: 12px 0">← All case studies</a>
    <ol style="margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px">
      <li><a href="/work/compass-buyers-agency" aria-current="page" class="rl-tag rl-tag--active" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; box-sizing: border-box">Compass</a></li>
      <li><a href="/work/reviewbuddy" class="rl-tag" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; box-sizing: border-box">ReviewBuddy</a></li>
      <li><a href="/work/flexfolio" class="rl-tag" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; box-sizing: border-box">Flexfolio</a></li>
    </ol>
  </nav>

  <header style="display: flex; flex-direction: column; align-items: flex-start; gap: 20px; max-width: 880px">
    <div style="display: flex; flex-wrap: wrap; gap: 8px">
      <span class="rl-tag rl-tag--active">Client work</span>
      <span class="rl-tag">Website</span>
      <span class="rl-tag">Bespoke web app</span>
    </div>
    <h1 style="margin: 0; font-size: clamp(40px, 5vw, 60px); line-height: 1.05; letter-spacing: -0.03em; font-weight: 500">Compass Buyers Agency</h1>
    <p style="margin: 0; font-size: 22px; line-height: 30px; letter-spacing: -0.01em; color: var(--text-secondary)">A data-driven website that reports on every suburb they buy in, and a bespoke web app that runs the business behind it.</p>
    <a href="https://compassagency.com.au" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; color: #0a4cff">Visit compassagency.com.au<span aria-hidden="true"> ↗</span><span class="cs-sr"> (opens in a new tab)</span></a>
  </header>

  <div class="rl-split__panel mk-stage rl-rise rl-d2" style="min-height: 0; padding: clamp(8px, 3vw, 40px) clamp(8px, 4vw, 64px); background: linear-gradient(160deg, #3a6b68 0%, #173a39 100%)"><Mockup case="compass" sizes="(max-width: 1200px) calc(100vw - 48px), 1150px" eager priority /></div>

  <div style="display: flex; flex-wrap: wrap; gap: 48px 72px">
    <aside style="flex: 1 1 240px; max-width: 320px">
      <dl style="margin: 0; display: grid; gap: 0; border-top: 1px solid var(--border)">
        <div style="padding: 14px 0; border-bottom: 1px solid var(--border)"><dt style="font-size: 12px; line-height: 18px; color: var(--text-secondary)">Client</dt><dd style="margin: 4px 0 0; font-weight: 500">Compass Buyers Agency</dd></div>
        <div style="padding: 14px 0; border-bottom: 1px solid var(--border)"><dt style="font-size: 12px; line-height: 18px; color: var(--text-secondary)">Our role</dt><dd style="margin: 4px 0 0; font-weight: 500">Website, plus a bespoke web app</dd></div>
        <div style="padding: 14px 0; border-bottom: 1px solid var(--border)"><dt style="font-size: 12px; line-height: 18px; color: var(--text-secondary)">Working together since</dt><dd style="margin: 4px 0 0; font-weight: 500">2024</dd></div>
        <div style="padding: 14px 0; border-bottom: 1px solid var(--border)"><dt style="font-size: 12px; line-height: 18px; color: var(--text-secondary)">Status</dt><dd style="margin: 4px 0 0; font-weight: 500">Website live, web app rolling out</dd></div>
        <div style="padding: 14px 0; border-bottom: 1px solid var(--border)"><dt style="font-size: 12px; line-height: 18px; color: var(--text-secondary)">Website</dt><dd style="margin: 4px 0 0; font-weight: 500"><a href="https://compassagency.com.au" target="_blank" rel="noopener" style="color: inherit">compassagency.com.au<span aria-hidden="true"> ↗</span><span class="cs-sr"> (opens in a new tab)</span></a></dd></div>
      </dl>
    </aside>

    <div style="flex: 2.4 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 56px">
      <section style="display: flex; flex-direction: column; gap: 16px">
        <h2 style="margin: 0; font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">Overview</h2>
        <p style="margin: 0; font-size: 16px; line-height: 24px; max-width: 640px">We've worked with Compass Buyers Agency since 2024, on two separate builds. The first is their public website, which publishes data-driven reports on the suburbs they buy in. The second is a bespoke web app that works as their operating system, keeping the pipeline and client records in one secure place. The website is live, and the web app is rolling out now.</p>
      </section>
      <section style="display: flex; flex-direction: column; gap: 20px; padding: clamp(24px, 3vw, 40px); border-radius: var(--radius-surface); background: var(--fog)">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px">
          <span class="rl-tag rl-tag--active">Build 1 of 2</span>
          <span class="rl-tag">Website</span>
        </div>
        <h2 style="margin: 0; font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">The website</h2>
        <div style="display: flex; flex-direction: column; gap: 8px">
          <h3 style="margin: 0; font-size: 14px; line-height: 20px; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; color: var(--text-secondary)">Before</h3>
          <p style="margin: 0; font-size: 16px; line-height: 24px; max-width: 640px">Compass had a website that looked good but didn't perform for SEO. It wasn't doing much to bring buyers in, or to show what the team knows.</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px">
          <h3 style="margin: 0; font-size: 14px; line-height: 20px; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; color: var(--text-secondary)">What we built</h3>
          <ul style="margin: 0; padding: 0 0 0 20px; display: grid; gap: 12px; font-size: 16px; line-height: 24px; max-width: 640px">
            <li>We rebuilt the site on a Supabase database, so it can scale across suburb after suburb without each page being built by hand.</li>
            <li>We built automations that pull property data from realestate.com.au and other providers through APIs, and turn it into a report for each suburb.</li>
            <li>Every report builds their brand and their traffic, and gives buyers real value before they've even made contact.</li>
          </ul>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px">
          <h3 style="margin: 0; font-size: 14px; line-height: 20px; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; color: var(--text-secondary)">What changed</h3>
          <ul style="margin: 0; padding: 0 0 0 20px; display: grid; gap: 12px; font-size: 16px; line-height: 24px; max-width: 640px">
            <li>Suburb pages rolling out across more than 30 suburbs they buy in, each with its own data-driven report.</li>
            <li>Built for a fraction of the traditional cost. We'd normally expect $50,000 to $60,000 or more for a website like this.</li>
          </ul>
        </div>
      </section>
      <section style="display: flex; flex-direction: column; gap: 20px; padding: clamp(24px, 3vw, 40px); border-radius: var(--radius-surface); background: var(--fog)">
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px">
          <span class="rl-tag rl-tag--active">Build 2 of 2</span>
          <span class="rl-tag">Bespoke web app</span>
        </div>
        <h2 style="margin: 0; font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">The operating system</h2>
        <div style="display: flex; flex-direction: column; gap: 8px">
          <h3 style="margin: 0; font-size: 14px; line-height: 20px; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; color: var(--text-secondary)">Before</h3>
          <p style="margin: 0; font-size: 16px; line-height: 24px; max-width: 640px">The team was stitching together Google Sheets, their CRM and a handful of property data platforms, and client conversations were split between WhatsApp and email. That's hard to keep compliant, and you can't build routines and systems when everything's in a different place.</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px">
          <h3 style="margin: 0; font-size: 14px; line-height: 20px; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; color: var(--text-secondary)">What we built</h3>
          <ul style="margin: 0; padding: 0 0 0 20px; display: grid; gap: 12px; font-size: 16px; line-height: 24px; max-width: 640px">
            <li>We started by understanding how the business actually runs, before building anything.</li>
            <li>We built a bespoke web app that shows their main sales pipeline and holds every client's details, so they're compliant and ready for an audit at any time.</li>
            <li>We connected it to Claude through MCP, so the team can check and update it from their phone wherever they are, without opening the app.</li>
            <li>We added connectors to Xero, DocuSign and their property data provider.</li>
          </ul>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px">
          <h3 style="margin: 0; font-size: 14px; line-height: 20px; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; color: var(--text-secondary)">What changed</h3>
          <ul style="margin: 0; padding: 0 0 0 20px; display: grid; gap: 12px; font-size: 16px; line-height: 24px; max-width: 640px">
            <li>Pipeline, client records and documents in one secure place, instead of spread across spreadsheets, WhatsApp and email.</li>
            <li>The team stays productive on the road, and the documentation stays organised.</li>
            <li>Rolling out with the team now.</li>
          </ul>
        </div>
      </section>
    </div>
  </div>
  <section style="display: flex; flex-direction: column; gap: 24px">
    <h2 style="margin: 0; font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">Walkthrough</h2>
    <div style="background: var(--fog); border-radius: var(--radius-surface); padding: clamp(24px, 4vw, 48px); display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start"><figure style="margin: 0; flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 12px"><Img src={compassByronBaySuburbPage} alt="The Byron Bay suburb page on the Compass Buyers Agency website" style="display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: 10px; box-shadow: 0 18px 40px -18px rgba(0,7,16,.55)" sizes="(max-width: 900px) calc(100vw - 96px), 460px" /><figcaption style="font-size: 14px; line-height: 20px; color: var(--text-secondary)">One of the suburb pages: Byron Bay</figcaption></figure><figure style="margin: 0; flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 12px"><Img src={compassContactPage} alt="The contact page on the Compass Buyers Agency website" style="display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: 10px; box-shadow: 0 18px 40px -18px rgba(0,7,16,.55)" sizes="(max-width: 900px) calc(100vw - 96px), 460px" /><figcaption style="font-size: 14px; line-height: 20px; color: var(--text-secondary)">The contact page</figcaption></figure><figure style="margin: 0; flex: 0 0 220px; display: flex; flex-direction: column; align-items: center; gap: 12px"><div style="width: min(100%, 240px); border: 8px solid var(--ink); border-radius: 32px; overflow: hidden; box-shadow: var(--shadow-float); background: var(--ink)"><Img src={compassBuyersAgencyPhone} alt="The Compass Buyers Agency website on a phone" style="display: block; width: 100%; aspect-ratio: 9 / 19.5; object-fit: cover; object-position: top" sizes="224px" /></div><figcaption style="font-size: 14px; line-height: 20px; color: var(--text-secondary)">On mobile</figcaption></figure></div>
  </section>
</article>

<nav aria-label="More case studies" style="max-width: 1200px; margin: 0 auto; padding: 0 24px 96px; box-sizing: border-box; display: flex; flex-direction: column; gap: 24px">
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 24px; border-top: 1px solid var(--border); padding-top: 48px">
    <h2 style="margin: 0; font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">More case studies</h2>
    <span style="font-size: 14px; line-height: 20px; color: var(--text-secondary)">1 of 3</span>
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px">
    <a class="cs-card" href="/work/flexfolio" style="display: flex; flex-direction: column; gap: 12px; padding: 20px; border-radius: var(--radius-surface); background: var(--fog); color: var(--ink); text-decoration: none">
      <div class="mk-stage cs-thumb" style="background: linear-gradient(160deg, #2a2a2a 0%, #0b0b0b 100%)"><Mockup case="flexfolio" decorative sizes="(max-width: 720px) calc(100vw - 88px), 540px" /></div>
      <span style="font-size: 14px; line-height: 20px; color: var(--text-secondary)">← Previous</span>
      <span role="heading" aria-level="3" style="font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">Flexfolio</span>
      <span style="font-size: 16px; line-height: 24px; color: var(--text-secondary)">Flexfolio is our portfolio product for product managers, built to show the thinking behind their work.</span>
    </a>
    <a class="cs-card" href="/work/reviewbuddy" style="display: flex; flex-direction: column; gap: 12px; padding: 20px; border-radius: var(--radius-surface); background: var(--fog); color: var(--ink); text-decoration: none">
      <div class="mk-stage cs-thumb" style="background: linear-gradient(160deg, #4cc2ff 0%, #1f9be6 100%)"><Mockup case="reviewbuddy" decorative sizes="(max-width: 720px) calc(100vw - 88px), 540px" /></div>
      <span style="font-size: 14px; line-height: 20px; color: var(--text-secondary)">Next →</span>
      <span role="heading" aria-level="3" style="font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">ReviewBuddy</span>
      <span style="font-size: 16px; line-height: 24px; color: var(--text-secondary)">ReviewBuddy is our reviews platform for Australian tradies.</span>
    </a>
  </div>
</nav>

<ClosingCTA />
</Base>

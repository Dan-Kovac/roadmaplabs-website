---
import Base from '../../layouts/Base.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import Mockup from '../../components/Mockup.astro';
import Img from '../../components/Img.astro';
import { CASES } from '../../data/site';
import { caseSchema } from '../../data/schema';
const c = CASES.reviewbuddy;
import reviewbuddyPhone from '../../assets/images/reviewbuddy-phone.jpg';
---
<Base
  title='ReviewBuddy: Automated Reviews Platform | Roadmap Labs'
  description="ReviewBuddy is our reviews platform for Australian tradies."
  path="/work/reviewbuddy"
  ogType="article"
  ogImage={c.og}
  ogImageAlt={c.laptopAlt}
  schema={caseSchema(c, 'ReviewBuddy: Automated Reviews Platform | Roadmap Labs', 'ReviewBuddy is our reviews platform for Australian tradies.')}
>
<article style="max-width: 1200px; margin: 0 auto; padding: 48px 24px 80px; box-sizing: border-box; display: flex; flex-direction: column; gap: 48px">

  <nav class="cs-switch" aria-label="Case studies" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px">
    <a class="rl-link" href="/work" style="color: var(--text-secondary); padding: 12px 0">← All case studies</a>
    <ol style="margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px">
      <li><a href="/work/compass-buyers-agency" class="rl-tag" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; box-sizing: border-box">Compass</a></li>
      <li><a href="/work/reviewbuddy" aria-current="page" class="rl-tag rl-tag--active" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; box-sizing: border-box">ReviewBuddy</a></li>
      <li><a href="/work/flexfolio" class="rl-tag" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; box-sizing: border-box">Flexfolio</a></li>
    </ol>
  </nav>

  <header style="display: flex; flex-direction: column; align-items: flex-start; gap: 20px; max-width: 880px">
    <div style="display: flex; flex-wrap: wrap; gap: 8px">
      <span class="rl-tag rl-tag--active">Our product</span>
      <span class="rl-tag">Reviews</span>
      <span class="rl-tag">Automation</span>
    </div>
    <h1 style="margin: 0; font-size: clamp(40px, 5vw, 60px); line-height: 1.05; letter-spacing: -0.03em; font-weight: 600">ReviewBuddy</h1>
    <p style="margin: 0; font-size: 22px; line-height: 30px; letter-spacing: -0.01em; color: var(--text-secondary)">ReviewBuddy is our reviews platform for Australian tradies.</p>
    <a href="https://www.reviewbuddy.com.au" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; color: #0a4cff">Visit reviewbuddy.com.au<span aria-hidden="true"> ↗</span><span class="cs-sr"> (opens in a new tab)</span></a>
  </header>

  <div class="rl-split__panel mk-stage rl-rise rl-d2" style="min-height: 0; padding: clamp(8px, 3vw, 40px) clamp(8px, 4vw, 64px); background: linear-gradient(160deg, #4cc2ff 0%, #1f9be6 100%)"><Mockup case="reviewbuddy" sizes="(max-width: 1200px) calc(100vw - 48px), 1150px" eager priority /></div>

  <div style="display: flex; flex-wrap: wrap; gap: 48px 72px">
    <aside style="flex: 1 1 240px; max-width: 320px">
      <dl style="margin: 0; display: grid; gap: 0; border-top: 1px solid var(--border)">
        <div style="padding: 14px 0; border-bottom: 1px solid var(--border)"><dt style="font-size: 12px; line-height: 18px; color: var(--text-secondary)">Type</dt><dd style="margin: 4px 0 0; font-weight: 500">Our product</dd></div>
        <div style="padding: 14px 0; border-bottom: 1px solid var(--border)"><dt style="font-size: 12px; line-height: 18px; color: var(--text-secondary)">Status</dt><dd style="margin: 4px 0 0; font-weight: 500">In beta</dd></div>
        <div style="padding: 14px 0; border-bottom: 1px solid var(--border)"><dt style="font-size: 12px; line-height: 18px; color: var(--text-secondary)">Started</dt><dd style="margin: 4px 0 0; font-weight: 500">2025</dd></div>
        <div style="padding: 14px 0; border-bottom: 1px solid var(--border)"><dt style="font-size: 12px; line-height: 18px; color: var(--text-secondary)">Website</dt><dd style="margin: 4px 0 0; font-weight: 500"><a href="https://www.reviewbuddy.com.au" target="_blank" rel="noopener" style="color: inherit">reviewbuddy.com.au<span aria-hidden="true"> ↗</span><span class="cs-sr"> (opens in a new tab)</span></a></dd></div>
      </dl>
    </aside>

    <div style="flex: 2.4 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 56px">
      <section style="display: flex; flex-direction: column; gap: 16px">
        <h2 style="margin: 0; font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">Overview</h2>
        <p style="margin: 0; font-size: 16px; line-height: 24px; max-width: 640px">ReviewBuddy is our reviews platform for Australian tradies. It's in beta.</p>
      </section>
      <section style="display: flex; flex-direction: column; gap: 16px">
        <h2 style="margin: 0; font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">Highlights</h2>
        <ul style="margin: 0; padding: 0 0 0 20px; display: grid; gap: 12px; font-size: 16px; line-height: 24px; max-width: 640px">
          <li>In beta, built to help businesses request, manage and display customer reviews.</li>
        </ul>
      </section>
      <section style="display: flex; flex-direction: column; gap: 16px">
        <h2 style="margin: 0; font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">Challenge</h2>
        <p style="margin: 0; font-size: 16px; line-height: 24px; max-width: 640px">We built ReviewBuddy to help businesses request, manage and display customer reviews.</p>
      </section>
      <section style="display: flex; flex-direction: column; gap: 16px">
        <h2 style="margin: 0; font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">Solution</h2>
        <ul style="margin: 0; padding: 0 0 0 20px; display: grid; gap: 12px; font-size: 16px; line-height: 24px; max-width: 640px">
          <li>We set up the platform so businesses can send review requests, deal with negative reviews as feedback, and show their best reviews on their website with a widget.</li>
          <li>Setup takes about two business days.</li>
        </ul>
      </section>
    </div>
  </div>
  <section style="display: flex; flex-direction: column; gap: 24px">
    <h2 style="margin: 0; font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">Walkthrough</h2>
    <div style="background: var(--fog); border-radius: var(--radius-surface); padding: clamp(24px, 4vw, 48px); display: flex; justify-content: center"><figure style="margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px"><div style="width: min(100%, 240px); border: 8px solid var(--ink); border-radius: 32px; overflow: hidden; box-shadow: var(--shadow-float); background: var(--ink)"><Img src={reviewbuddyPhone} alt="ReviewBuddy on a phone" style="display: block; width: 100%; aspect-ratio: 9 / 19.5; object-fit: cover; object-position: top" sizes="224px" /></div><figcaption style="font-size: 14px; line-height: 20px; color: var(--text-secondary)">On mobile</figcaption></figure></div>
  </section>
</article>

<nav aria-label="More case studies" style="max-width: 1200px; margin: 0 auto; padding: 0 24px 96px; box-sizing: border-box; display: flex; flex-direction: column; gap: 24px">
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 24px; border-top: 1px solid var(--border); padding-top: 48px">
    <h2 style="margin: 0; font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">More case studies</h2>
    <span style="font-size: 14px; line-height: 20px; color: var(--text-secondary)">2 of 3</span>
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px">
    <a class="cs-card" href="/work/compass-buyers-agency" style="display: flex; flex-direction: column; gap: 12px; padding: 20px; border-radius: var(--radius-surface); background: var(--fog); color: var(--ink); text-decoration: none">
      <div class="mk-stage cs-thumb" style="background: linear-gradient(160deg, #3a6b68 0%, #173a39 100%)"><Mockup case="compass" decorative sizes="(max-width: 720px) calc(100vw - 88px), 540px" /></div>
      <span style="font-size: 14px; line-height: 20px; color: var(--text-secondary)">← Previous</span>
      <span role="heading" aria-level="3" style="font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">Compass Buyers Agency</span>
      <span style="font-size: 16px; line-height: 24px; color: var(--text-secondary)">{CASES.compass.summary}</span>
    </a>
    <a class="cs-card" href="/work/flexfolio" style="display: flex; flex-direction: column; gap: 12px; padding: 20px; border-radius: var(--radius-surface); background: var(--fog); color: var(--ink); text-decoration: none">
      <div class="mk-stage cs-thumb" style="background: linear-gradient(160deg, #2a2a2a 0%, #0b0b0b 100%)"><Mockup case="flexfolio" decorative sizes="(max-width: 720px) calc(100vw - 88px), 540px" /></div>
      <span style="font-size: 14px; line-height: 20px; color: var(--text-secondary)">Next →</span>
      <span role="heading" aria-level="3" style="font-size: 24px; line-height: 32px; letter-spacing: -0.01em; font-weight: 600">Flexfolio</span>
      <span style="font-size: 16px; line-height: 24px; color: var(--text-secondary)">{CASES.flexfolio.summary}</span>
    </a>
  </div>
</nav>

<ClosingCTA />
</Base>

---
// Responsive <picture>: AVIF and WebP sources with a JPEG fallback, explicit width/height.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  priority?: boolean;
  class?: string;
  style?: string;
}
const { src, alt, sizes, widths, eager = false, priority = false, class: cls, style } = Astro.props;
const ws = (widths ?? [320, 480, 640, 800, 1024, 1280, 1600]).filter((w) => w <= src.width);
if (!ws.includes(src.width) && ws.length === 0) ws.push(src.width);
---
<Picture
  src={src}
  alt={alt}
  widths={ws}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  quality={72}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : undefined}
  class={cls}
  style={style}
/>

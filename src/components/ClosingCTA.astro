---
interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  cta?: string;
  microcopy?: string;
}
const {
  eyebrow = 'Free discovery session | 1 hour',
  title = 'Work out where AI fits in your business',
  body = "Spend an hour with Dan on the work holding your team up. You'll leave with a clear AI blueprint and strategy you can use yourself.",
  cta = 'Book a free 1-hour discovery session',
  microcopy = "There's no obligation to hire us.",
} = Astro.props;
---
<section class="rl ev-cta" aria-labelledby="cta-title" style="width: 100%">
  <div class="ev-cta__inner">
    <span class="rl-tag ev-tag-dark">{eyebrow}</span>
    <h2 id="cta-title">{title}</h2>
    <p>{body}</p>
    <div class="ev-cta__actions">
      <a class="rl-btn rl-btn--lg" href="/contact" style="background: var(--paper); color: var(--ink)">{cta}</a>
    </div>
    <p class="offer-micro">{microcopy}</p>
    <ol class="ev-cta__steps">
      <li><span>The session</span><strong>An hour with Dan</strong><em>Talk through your goals and how the work happens today.</em></li>
      <li><span>Your takeaway</span><strong>A blueprint and strategy to keep</strong><em>Priorities and a sensible place to start.</em></li>
      <li><span>Your decision</span><strong>Choose what happens next</strong><em>Use the plan yourself or ask us to scope a project.</em></li>
    </ol>
  </div>
</section>

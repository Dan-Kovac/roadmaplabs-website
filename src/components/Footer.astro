---
import { FOOTER_COMPANY, SITE } from '../data/site';
---
<div class="rl" style="width: 100%">
  <hr class="rl-signal-rule">
  <footer class="rl-footer" style="padding: 72px 24px 32px">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 48px 64px; justify-content: space-between">
      <div style="flex: 1 1 300px; max-width: 380px; display: flex; flex-direction: column; align-items: flex-start; gap: 20px">
        <img class="rl-footer__logo" src="/logo-white.svg" alt="Roadmap Labs" width="133" height="40" style="height: 40px; margin-bottom: 0">
        <p style="margin: 0; font-size: 14px; line-height: 22px; color: var(--mist)">AI consulting for established Australian businesses. We map your processes, find the bottlenecks and build the automations worth having.</p>
        <a class="rl-btn" href="/contact" style="background: var(--paper); color: var(--ink); min-height: 44px">Book a free 1-hour discovery session</a>
      </div>
      <nav class="rl-footer__cols" aria-label="Footer" style="flex: 2 1 520px; max-width: 680px">
        <div>
          <h2 class="footer-h">Company</h2>
          <ul>
            {FOOTER_COMPANY.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="footer-h">Case studies</h2>
          <ul>
            <li><a href="/work/compass-buyers-agency">Compass Buyers Agency</a></li>
            <li><a href="/work/reviewbuddy">ReviewBuddy</a></li>
            <li><a href="/work/flexfolio">Flexfolio</a></li>
          </ul>
        </div>
        <div>
          <h2 class="footer-h">Get in touch</h2>
          <ul>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            {SITE.linkedin && <li><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn<span class="cs-sr"> (opens in a new tab)</span></a></li>}
            <li><span style="font-size: 14px; line-height: 20px; color: var(--mist)">Melbourne, Victoria</span></li>
            <li><span style="font-size: 14px; line-height: 20px; color: var(--mist)">Working across Australia</span></li>
          </ul>
        </div>
      </nav>
    </div>
    <p style="max-width: 1200px; margin: 56px auto 0; font-size: 13px; line-height: 20px; color: var(--mist)">Roadmap Labs acknowledges the Traditional Custodians of the lands on which we live and work, and pays respect to Elders past and present.</p>
    <div style="max-width: 1200px; margin: 24px auto 0; padding-top: 24px; border-top: 1px solid var(--carbon); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; font-size: 13px; line-height: 20px; color: var(--mist)">
      <span>© 2026 Roadmap Labs · ABN {SITE.abn}</span>
      <span style="display: flex; flex-wrap: wrap; gap: 8px 24px">
        <a href="/privacy" style="font-size: 13px">Privacy policy</a>
        <a href="#top" style="font-size: 13px">Back to top ↑</a>
      </span>
    </div>
  </footer>
</div>

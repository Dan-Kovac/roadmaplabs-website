---
const links = [
  { href: '/work', label: 'Our work' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Insights' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const current = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="rl hd">
  <nav class="ev-nav hd__nav" aria-label="Main">
    <a class="hd__logo" href="/" aria-label="Roadmap Labs home">
      <img class="rl-nav__logo" src="/logo.svg" alt="Roadmap Labs" width="133" height="40" style="height: 40px" fetchpriority="high">
    </a>
    <ul class="ev-nav-links hd__links">
      {links.map((l) => (
        <li><a class="rl-link" href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <a class="hd__offer" href="/contact">Free 1-hour AI strategy session</a>
    <a class="rl-btn ev-nav-cta" href="/contact">Book a session</a>
    <button class="ev-menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" style="color: #000000">
      <svg class="icon-open" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="icon-close" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </nav>
  <div class="ev-mobile-menu" id="mobile-menu" hidden>
    {links.map((l) => (
      <a class="rl-link" href={l.href} aria-current={current(l.href) ? 'page' : undefined} style="color: #000000">{l.label}</a>
    ))}
    <a class="rl-btn rl-btn--lg" href="/contact">Book your free session</a>
  </div>
</header>
<script is:inline>
  (function () {
    var btn = document.querySelector('.ev-menu-btn');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    function set(open) {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }
    btn.addEventListener('click', function () { set(menu.hidden); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
    window.matchMedia('(min-width: 721px)').addEventListener('change', function (m) { if (m.matches) set(false); });
  })();
</script>
